---
/**
 * CategorySpotlight — Módulo de categoría a dos columnas
 * Izquierda: ficha de la categoría (productos, sectores, CTA)
 * Derecha: galería 1 grande + 2 chicas
 * Reutilizable: se instancia una vez por categoría desde index.astro
 */

interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  badge: string;
  title: string;
  desc: string | string[];
  products: string[];
  sectors: string[];
  highlight: string;
  waText: string;
  images: [GalleryImage, GalleryImage, GalleryImage];
  fichaHref?: string;
  background?: string;
  reverse?: boolean;
}

const {
  id,
  eyebrow = 'Línea destacada',
  badge,
  title,
  desc,
  products,
  sectors,
  highlight,
  waText,
  images,
  fichaHref,
  background = '#f8fafc',
  reverse = false,
} = Astro.props;

const paragraphs = Array.isArray(desc) ? desc : [desc];
const [big, small1, small2] = images;
const waHref = `https://wa.me/525500000000?text=Hola%2C%20necesito%20cotizar%20${waText}`;
---

<section id={id} style={`background:${background}; padding:96px 0; border-top:1px solid #e4e4e7;`}>
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start;">

      <!-- ══════════ COLUMNA 1 — FICHA ══════════ -->
      <div style={`display:flex; flex-direction:column; ${reverse ? 'order:2;' : ''}`} class={reverse ? 'lg:order-2' : ''}>

        <!-- Eyebrow -->
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
          <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
          <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">{eyebrow}</span>
        </div>

        <!-- Badge de norma -->
        <span style="display:inline-block; align-self:flex-start; background:#dc2626; color:#fff; font-size:0.62rem; font-weight:800; letter-spacing:0.06em; padding:4px 10px; border-radius:4px; text-transform:uppercase; margin-bottom:16px;">{badge}</span>

        <!-- Título -->
        <h2 style="font-size:clamp(1.9rem,2.8vw,2.7rem); font-weight:800; color:#09090b; line-height:1.1; margin:0 0 18px; letter-spacing:-0.02em; width:100%; max-width:none;">{title}</h2>

        <!-- Descripción -->
        <div style="margin:0 0 32px; width:100%;">
          {paragraphs.map((par, i) => (
            <p set:html={par} style={`font-size:0.95rem; color:#52525b; line-height:1.85; width:100%; max-width:none; margin:${i === 0 ? '0' : '16px 0 0'};`}></p>
          ))}
        </div>

        <!-- Separador: Productos -->
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
          <span style="font-size:0.62rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#a1a1aa;">Productos</span>
          <div style="flex:1; height:1px; background:#e4e4e7;"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" style="margin-bottom:28px;">
          {products.map((p) => (
            <span style="display:flex; align-items:center; gap:8px; font-size:0.78rem; color:#3f3f46; background:#fff; border:1px solid #e4e4e7; padding:9px 12px; border-radius:7px;">
              <svg width="12" height="12" fill="#dc2626" viewBox="0 0 20 20" style="flex-shrink:0;"><use href="#i-check"/></svg>
              <span>{p}</span>
            </span>
          ))}
        </div>

        <!-- Separador: Aplica para -->
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
          <span style="font-size:0.62rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#a1a1aa;">Aplica para</span>
          <div style="flex:1; height:1px; background:#e4e4e7;"></div>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:24px;">
          {sectors.map((s) => (
            <span style="font-size:0.72rem; font-weight:500; color:#52525b; background:#fff; border:1px solid #e4e4e7; padding:6px 13px; border-radius:99px;">{s}</span>
          ))}
        </div>

        <!-- Chip highlight -->
        <div style="display:flex; align-items:center; gap:8px; padding:11px 14px; border-radius:8px; background:#fef2f2; margin-bottom:28px; align-self:flex-start;">
          <svg width="13" height="13" fill="#dc2626" viewBox="0 0 20 20" style="flex-shrink:0;"><use href="#i-check"/></svg>
          <span style="font-size:0.75rem; font-weight:600; color:#dc2626;">{highlight}</span>
        </div>

        <!-- CTAs -->
        <div style="display:flex; flex-wrap:wrap; gap:10px;">
          <a
            href={waHref}
            target="_blank"
            rel="noopener"
            class="cs-cta"
          >
            <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><use href="#i-wa"/></svg>
            <span>Cotizar {title}</span>
          </a>
          {fichaHref && (
            <a href={fichaHref} class="cs-cta-ghost">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <span>Ver ficha completa</span>
            </a>
          )}
          <a href="tel:5555555555" class="cs-cta-ghost">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>Hablar con un ingeniero</span>
          </a>
        </div>
      </div>

      <!-- ══════════ COLUMNA 2 — GALERÍA ══════════ -->
      <div class={reverse ? 'lg:order-1' : ''} style="display:flex; flex-direction:column; gap:12px;">

        <!-- Imagen grande -->
        <figure class="cs-shot cs-shot-big">
          <img src={big.src} alt={big.alt} loading="lazy" decoding="async" width="800" height="560" />
          {big.caption && <figcaption>{big.caption}</figcaption>}
          <span class="cs-shot-badge">{badge}</span>
        </figure>

        <!-- Dos imágenes chicas -->
        <div class="grid grid-cols-2 gap-3">
          {[small1, small2].map((img) => (
            <figure class="cs-shot cs-shot-sm">
              <img src={img.src} alt={img.alt} loading="lazy" decoding="async" width="400" height="300" />
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))}
        </div>

      </div>

    </div>
  </div>
</section>
