        {condicionesFooter.map(c => (
          <div style="background:#09090b; padding:18px 20px;">
            <span style="display:block; font-size:0.6rem; font-weight:700; letter-spacing:0.13em; text-transform:uppercase; color:#71717a; margin-bottom:8px;">{c.titulo}</span>
            <p style="font-size:0.78rem; color:#a1a1aa; line-height:1.75; margin:0;">{c.detalle}</p>
          </div>
        ))}
      </div>

      <p style="font-size:0.72rem; color:#3f3f46; line-height:1.7; margin:14px 0 0;">
        {AVISO_PRECIOS} <a href="/contacto" style="color:#71717a; text-decoration:underline; text-underline-offset:2px;">Ver condiciones completas</a>.
      </p>

    </div>
  </div>

  <!-- ════════════════════════════════════════════
       MARCO NORMATIVO
  ════════════════════════════════════════════ -->
  <div style="background:#111111; border-top:1px solid #1f1f1f; padding:26px 0;">
    <div class="container-custom">
      <div style="display:flex; flex-wrap:wrap; align-items:center; gap:6px;">
        <span style="font-size:0.62rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#3f3f46; margin-right:8px; flex-shrink:0;">Marco normativo</span>
        {normasFooter.map(n => {
          const Tag = n.href ? 'a' : 'div';
          return (
            <Tag
              href={n.href}
              title={n.href ? `Ver la ficha de ${n.clave}` : `${n.nombre} — ${n.aplica}`}
              style="display:inline-flex; flex-direction:column; align-items:center; padding:6px 14px; border:1px solid #1f1f1f; border-radius:6px; background:#0a0a0a; gap:2px; text-decoration:none;"
            >
              <span style={`font-size:0.65rem; font-weight:700; letter-spacing:0.05em; white-space:nowrap; color:${n.href ? '#dc2626' : '#a1a1aa'};`}>{n.clave}</span>
              <span style="font-size:0.56rem; color:#3f3f46; letter-spacing:0.02em; white-space:nowrap;">{n.aplica}</span>
            </Tag>
          );
        })}
      </div>
      <p style="font-size:0.68rem; color:#3f3f46; line-height:1.7; margin:16px 0 0; max-width:900px;">
        Las normas listadas son el marco de referencia del catálogo. La norma aplicable a cada partida se
        indica de forma expresa en la ficha técnica y en la cotización. <a href="/cumplimiento" style="color:#71717a; text-decoration:underline; text-underline-offset:2px;">Consulta qué exige la ley a tu operación</a>.
      </p>
