---
/**
 * Footer — FIREFIGHTER.COM.MX
 * Diseño profesional B2B. Dark #09090b, accent #dc2626.
 * Estructura: Pre-footer CTA → Main (5 cols) → Ficha de empresa → Marco normativo
 *             → Avisos → Bottom bar
 *
 * Todo dato de marca, contacto, condición comercial y norma sale de
 * src/data/marca.ts. No se escribe ningún dato a mano en este archivo.
 */

import catalogo from '../../data/productos.json';
import {
  MARCA, NOMBRE_EMPRESA, MARCA_PARTES, DOMINIO, SITE, TAGLINE, DESCRIPTOR, GIRO,
  CONTACTO, EMPRESA, MARCAS_DISTRIBUIDAS, NORMAS, CONDICIONES,
  AVISO_NO_EMERGENCIAS, AVISO_PRECIOS, wa,
} from '../../data/marca';

const currentYear = new Date().getFullYear();

const productos = catalogo.map((c) => ({
  label: c.nombre,
  href: `/productos/${c.slug}`,
}));

// Cada sector entra al catálogo por la categoría que más le sirve, al ancla de sectores
const sectores = [
  { label: 'Cuerpos de Bomberos',      href: '/productos/epp-para-bomberos#sectores' },
  { label: 'Brigadas Industriales',    href: '/productos/equipos-de-respiracion#sectores' },
  { label: 'Industria y Manufactura',  href: '/productos/sistemas-contra-incendio#sectores' },
  { label: 'Hospitales y Salud',       href: '/productos/deteccion-y-alarma#sectores' },
  { label: 'Hoteles y Plazas',         href: '/productos/senaletica-y-seguridad#sectores' },
  { label: 'Protección Civil',         href: '/productos/herramientas-de-rescate#sectores' },
  { label: 'Brigadas Forestales',      href: '/productos/equipo-forestal#sectores' },
  { label: 'Cocinas y Comercios',      href: '/productos/extintores-y-extincion#sectores' },
];

const empresaLinks = [
  { label: 'Quiénes somos',              href: '/acerca-de' },
  { label: 'Catálogo completo',          href: '/productos' },
  { label: 'Normativa y cumplimiento',   href: '/cumplimiento' },
  { label: 'Directorio de bomberos',     href: '/directorio' },
  { label: 'Mapa de estaciones',         href: '/mapa' },
  { label: 'Blog técnico',               href: '/blog' },
  { label: 'Contacto y cotización',      href: '/contacto' },
  { label: 'Licitaciones públicas',      href: `mailto:${CONTACTO.emailLicitaciones}` },
];

const legal = [
  { label: 'Aviso de Privacidad',        href: '/privacidad' },
  { label: 'Emergencias · 911',          href: '/emergencias' },
  { label: 'Registrar una estación',     href: '/agregar-estacion' },
  { label: 'Mapa del Sitio',             href: '/sitemap-index.xml' },
];

// Ficha de empresa: lo primero que revisa un comprador B2B o una convocatoria.
const ficha = [
  { label: 'Giro',                detalle: EMPRESA.giro },
  { label: 'Cobertura',           detalle: EMPRESA.cobertura },
  { label: 'Horario de atención', detalle: CONTACTO.horarioComercial },
  { label: 'Idioma y moneda',     detalle: `Atención en ${EMPRESA.idiomaAtencion}. Operaciones en pesos mexicanos (${EMPRESA.monedaOperacion}).` },
];

// De las condiciones publicadas, las cuatro que decide un comprador antes de cotizar.
const condicionesFooter = CONDICIONES.filter((c) =>
  ['Respuesta a cotización', 'Tiempo de entrega', 'Garantía', 'Facturación'].includes(c.titulo),
);

// El strip normativo muestra las normas de producto; NOM-002 lleva a su ficha.
const normasFooter = NORMAS.slice(0, 9);

const socialLinks = [
  {
    name: 'Facebook',
    href: 'https://facebook.com/firefightermx',
    icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  },
  {
    name: 'Instagram',
    href: 'https://instagram.com/firefightermx',
    icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/company/firefightermx',
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    name: 'YouTube',
    href: 'https://youtube.com/@firefightermx',
    icon: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
];

/**
 * Organization site-wide. Es el único Organization del sitio: SEOHead no lo
 * vuelve a emitir para no duplicar el mismo @id.
 */
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: MARCA,
  // La empresa tiene dos nombres válidos: el dominio es la marca visible y
  // «FIREFIGHTER México» es la razón comercial —y la forma que la gente busca—.
  // Declarar las dos aquí es lo que permite que el buscador resuelva la misma
  // entidad escrita de cualquiera de las dos maneras. Ver src/data/marca.ts.
  alternateName: [NOMBRE_EMPRESA, DOMINIO],
  url: SITE,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE}/images/logo-firefighter-mexico.svg`,
    width: 200,
    height: 50,
  },
  slogan: TAGLINE,
  description: DESCRIPTOR,
  areaServed: { '@type': 'Country', name: 'México', identifier: 'MX' },
  knowsLanguage: 'es-MX',
  currenciesAccepted: EMPRESA.monedaOperacion,
  paymentAccepted: 'Transferencia electrónica, depósito bancario',
  brand: MARCAS_DISTRIBUIDAS.map((m) => ({ '@type': 'Brand', name: m })),
  knowsAbout: NORMAS.map((n) => n.clave),
  sameAs: socialLinks.map((s) => s.href),
  openingHoursSpecification: CONTACTO.horarioSchema.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.dias,
    opens: h.abre,
    closes: h.cierra,
  })),
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: `+52${CONTACTO.telefonoVentas.replace(/\D/g, '')}`,
      email: CONTACTO.emailVentas,
      areaServed: 'MX',
      availableLanguage: 'Spanish',
    },
    {
      '@type': 'ContactPoint',
      contactType: 'bidding',
      email: CONTACTO.emailLicitaciones,
      areaServed: 'MX',
      availableLanguage: 'Spanish',
    },
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: CONTACTO.emailSoporte,
      areaServed: 'MX',
      availableLanguage: 'Spanish',
    },
  ],
};
---

<footer>

  <!-- ════════════════════════════════════════════
       PRE-FOOTER — CTA de cotización
  ════════════════════════════════════════════ -->
  <div style="background:#dc2626; padding:56px 0;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10" style="align-items:center;">

        <div>
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
            <span style="display:block; width:24px; height:2px; background:rgba(255,255,255,0.5); flex-shrink:0; border-radius:2px;"></span>
            <span style="font-size:0.68rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,255,255,0.7);">Cotización en 24 horas hábiles</span>
          </div>
          <h2 style="font-size:clamp(1.6rem,2.4vw,2.3rem); font-weight:800; color:#fff; line-height:1.1; margin:0; letter-spacing:-0.02em;">
            ¿Listo para equipar tu brigada<br>o proyecto contra incendios?
          </h2>
        </div>

        <div style="display:flex; flex-direction:column; gap:14px;">
          <p style="font-size:0.9rem; color:rgba(255,255,255,0.85); line-height:1.8; margin:0;">
            Recibes una propuesta con <strong style="color:#fff;">marca, modelo, número de parte y norma aplicable por partida</strong>, no una lista de precios genérica. Sin costo y sin compromiso de compra.
          </p>
          <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:4px;">
            <a
              href={wa('Hola, necesito una cotización de equipo contra incendios')}
              target="_blank"
              rel="noopener"
              style="display:inline-flex; align-items:center; gap:10px; padding:14px 28px; background:#fff; color:#dc2626; font-size:0.9rem; font-weight:700; border-radius:10px; text-decoration:none; letter-spacing:0.01em;"
              onmouseover="this.style.background='#fef2f2'"
              onmouseout="this.style.background='#fff'"
            >
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><use href="#i-wa"/></svg>
              Cotizar por WhatsApp
            </a>
            <a
              href={`mailto:${CONTACTO.emailLicitaciones}`}
              style="display:inline-flex; align-items:center; gap:10px; padding:14px 28px; background:rgba(0,0,0,0.2); color:#fff; font-size:0.9rem; font-weight:700; border-radius:10px; text-decoration:none; border:1px solid rgba(255,255,255,0.25);"
              onmouseover="this.style.background='rgba(0,0,0,0.35)'"
              onmouseout="this.style.background='rgba(0,0,0,0.2)'"
            >
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Licitaciones públicas
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════
       MAIN FOOTER — 5 columnas
  ════════════════════════════════════════════ -->
  <div style="background:#09090b; padding:72px 0 56px;">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">

        <!-- Col 1-2 — Marca -->
        <div class="lg:col-span-2" style="padding-right:2rem;">

          <!-- Logo: escudo + wordmark FIREFIGHTER.COM.MX -->
          <a href="/" aria-label={`${MARCA} — Inicio`} style="display:inline-flex; align-items:center; gap:12px; margin-bottom:22px; text-decoration:none;">
            <span aria-hidden="true" style="width:42px; height:42px; flex-shrink:0; display:block;">
              <svg viewBox="0 0 50 50" style="width:100%; height:100%; display:block;">
                <path d="M25 4 L42 10 L42 28 C42 36 34 44 25 48 C16 44 8 36 8 28 L8 10 Z" fill="#dc2626"/>
                <path d="M25 7.5 L39 12.5 L39 27 C39 34 32 40.5 25 43.5 C18 40.5 11 34 11 27 L11 12.5 Z" fill="#09090b"/>
                <path d="M25 14 C25 14 30 20 30 26 C30 30 28 33 25 33 C22 33 20 30 20 26 C20 20 25 14 25 14 Z" fill="#dc2626"/>
                <path d="M25 20.5 C25 20.5 28 24 28 27 C28 29 27 30 25 30 C23 30 22 29 22 27 C22 24 25 20.5 25 20.5 Z" fill="#fff"/>
              </svg>
            </span>
            <span style="display:flex; flex-direction:column; line-height:1; min-width:0;">
              <span style="font-size:1.18rem; font-weight:800; color:#fff; letter-spacing:-0.01em; white-space:nowrap;">
                {MARCA_PARTES.nombre}<span style="color:#dc2626;">{MARCA_PARTES.tld}</span>
              </span>
              <span style="font-size:0.6rem; font-weight:600; color:#71717a; letter-spacing:0.09em; text-transform:uppercase; margin-top:7px;">{TAGLINE}</span>
            </span>
          </a>

          <p style="font-size:0.82rem; color:#71717a; line-height:1.85; margin:0 0 22px; max-width:340px;">
            Distribuidores autorizados de <strong style="color:#a1a1aa; font-weight:600;">{MARCAS_DISTRIBUIDAS.slice(0, 5).join(', ')}</strong> y otras marcas. Equipamos cuerpos de bomberos, brigadas industriales y proyectos contra incendios en {EMPRESA.coberturaCorta.charAt(0).toLowerCase() + EMPRESA.coberturaCorta.slice(1)}.
          </p>

          <!-- Datos de contacto especificados -->
          <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:24px;">
            <a href={CONTACTO.telefonoVentasHref} style="display:flex; align-items:center; gap:10px; text-decoration:none; color:#a1a1aa; font-size:0.82rem;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">
              <span style="width:32px; height:32px; background:#1a1a1a; border-radius:7px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="14" height="14" fill="none" stroke="#52525b" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </span>
              Ventas · {CONTACTO.telefonoVentas}
            </a>
            <a href={wa('Hola, necesito información sobre equipo contra incendios')} target="_blank" rel="noopener" style="display:flex; align-items:center; gap:10px; text-decoration:none; color:#a1a1aa; font-size:0.82rem;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">
              <span style="width:32px; height:32px; background:#1a1a1a; border-radius:7px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="14" height="14" fill="#52525b" viewBox="0 0 24 24"><use href="#i-wa"/></svg>
              </span>
              WhatsApp · Asesoría técnica sin costo
            </a>
            <a href={`mailto:${CONTACTO.emailVentas}`} style="display:flex; align-items:center; gap:10px; text-decoration:none; color:#a1a1aa; font-size:0.82rem;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">
              <span style="width:32px; height:32px; background:#1a1a1a; border-radius:7px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="14" height="14" fill="none" stroke="#52525b" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </span>
              {CONTACTO.emailVentas}
            </a>
            <a href={`mailto:${CONTACTO.emailLicitaciones}`} style="display:flex; align-items:center; gap:10px; text-decoration:none; color:#a1a1aa; font-size:0.82rem;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">
              <span style="width:32px; height:32px; background:#1a1a1a; border-radius:7px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="14" height="14" fill="none" stroke="#52525b" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </span>
              {CONTACTO.emailLicitaciones}
            </a>
            <div style="display:flex; align-items:center; gap:10px; color:#52525b; font-size:0.78rem;">
              <span style="width:32px; height:32px; background:#141414; border-radius:7px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="14" height="14" fill="none" stroke="#3f3f46" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </span>
              {CONTACTO.horarioComercialCorto}
            </div>
          </div>

          <!-- Redes sociales -->
          <div style="display:flex; gap:8px;">
            {socialLinks.map(s => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${MARCA} en ${s.name}`}
                style="width:36px; height:36px; background:#1a1a1a; border-radius:8px; display:flex; align-items:center; justify-content:center;"
                onmouseover="this.style.background='#dc2626'"
                onmouseout="this.style.background='#1a1a1a'"
              >
                <svg width="15" height="15" fill="#71717a" viewBox="0 0 24 24">
                  <path d={s.icon} />
                </svg>
              </a>
            ))}
          </div>

        </div>

        <!-- Col 3 — Productos -->
        <div>
          <h4 style="font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#fff; margin:0 0 20px;">
            Catálogo
          </h4>
          <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px;">
            {productos.map(l => (
              <li>
                <a
                  href={l.href}
                  style="font-size:0.8rem; color:#71717a; text-decoration:none; display:flex; align-items:center; gap:8px;"
                  onmouseover="this.style.color='#fff'"
                  onmouseout="this.style.color='#71717a'"
                >
                  <span style="display:block; width:3px; height:3px; background:#3f3f46; border-radius:50%; flex-shrink:0;"></span>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Col 4 — Sectores -->
        <div>
          <h4 style="font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#fff; margin:0 0 20px;">
            Sectores
          </h4>
          <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px;">
            {sectores.map(l => (
              <li>
                <a
                  href={l.href}
                  style="font-size:0.8rem; color:#71717a; text-decoration:none; display:flex; align-items:center; gap:8px;"
                  onmouseover="this.style.color='#fff'"
                  onmouseout="this.style.color='#71717a'"
                >
                  <span style="display:block; width:3px; height:3px; background:#3f3f46; border-radius:50%; flex-shrink:0;"></span>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Col 5 — Empresa + Legal -->
        <div>
          <h4 style="font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#fff; margin:0 0 20px;">
            Empresa
          </h4>
          <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; margin-bottom:32px;">
            {empresaLinks.map(l => (
              <li>
                <a
                  href={l.href}
                  style="font-size:0.8rem; color:#71717a; text-decoration:none; display:flex; align-items:center; gap:8px;"
                  onmouseover="this.style.color='#fff'"
                  onmouseout="this.style.color='#71717a'"
                >
                  <span style="display:block; width:3px; height:3px; background:#3f3f46; border-radius:50%; flex-shrink:0;"></span>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>

          <h4 style="font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#fff; margin:0 0 20px;">
            Legal
          </h4>
          <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px;">
            {legal.map(l => (
              <li>
                <a
                  href={l.href}
                  style="font-size:0.8rem; color:#71717a; text-decoration:none; display:flex; align-items:center; gap:8px;"
                  onmouseover="this.style.color='#fff'"
                  onmouseout="this.style.color='#71717a'"
                >
                  <span style="display:block; width:3px; height:3px; background:#3f3f46; border-radius:50%; flex-shrink:0;"></span>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </div>

