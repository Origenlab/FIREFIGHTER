  <div style="background:#000; border-top:1px solid #0f0f0f; padding:20px 0;">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4" style="align-items:center;">

        <p style="font-size:0.72rem; color:#3f3f46; margin:0; line-height:1.5;">
          © {currentYear} <strong style="color:#71717a; font-weight:700;">{MARCA}</strong> · Todos los derechos reservados
        </p>

        <p style="font-size:0.72rem; color:#3f3f46; margin:0; text-align:center; line-height:1.5;">
