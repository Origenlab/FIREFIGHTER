      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px" style="background:#1f1f23; border:1px solid #1f1f23; border-radius:12px; overflow:hidden; margin-bottom:14px;">
        {ficha.map(f => (
          <div style="background:#09090b; padding:18px 20px;">
            <span style="display:block; font-size:0.6rem; font-weight:700; letter-spacing:0.13em; text-transform:uppercase; color:#dc2626; margin-bottom:8px;">{f.label}</span>
            <p style="font-size:0.8rem; color:#a1a1aa; line-height:1.75; margin:0;">{f.detalle}</p>
