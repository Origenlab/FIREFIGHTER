  ════════════════════════════════════════════ -->
  <div style="background:#0a0a0a; border-top:1px solid #1f1f1f; padding:18px 0;">
    <div class="container-custom">
      <div style="display:flex; align-items:flex-start; gap:12px; flex-wrap:wrap;">
