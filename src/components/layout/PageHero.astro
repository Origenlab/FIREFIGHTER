---
/**
 * Hero oscuro homologado con el catalogo y el blog.
 * Izquierda: eyebrow + badge + H1 + lead + CTAs.
 * Derecha: bloques de contexto con barra lateral (o slot libre).
 */
export interface HeroBloque {
  label: string;
  texto: string;
}

interface Props {
  eyebrow: string;
  badge?: string;
  h1: string;
  lead?: string;
  bloques?: HeroBloque[];
  padding?: string;
}

const { eyebrow, badge, h1, lead, bloques = [], padding = '56px 0 68px' } = Astro.props;
const tieneDerecha = bloques.length > 0 || Astro.slots.has('derecha');
---

<section style={`background:#09090b; padding:${padding};`}>
  <div class="container-custom">
    <div class={tieneDerecha ? 'grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16' : ''} style="align-items:start;">

      <div class={tieneDerecha ? 'lg:pr-14 lg:border-r lg:border-[#1f1f23]' : ''}>
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
          <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
          <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">{eyebrow}</span>
        </div>

        {badge && (
          <span style="display:inline-block; background:#dc2626; color:#fff; font-size:0.62rem; font-weight:800; letter-spacing:0.07em; padding:4px 11px; border-radius:4px; text-transform:uppercase; margin-bottom:18px;">{badge}</span>
        )}

        <h1 style="font-size:clamp(1.9rem,3.4vw,2.9rem); font-weight:800; color:#fafafa; line-height:1.1; margin:0 0 18px; letter-spacing:-0.02em;" set:html={h1}></h1>

        {lead && (
          <p style="font-size:1rem; color:#a1a1aa; line-height:1.8; margin:0 0 28px;" set:html={lead}></p>
        )}

        <slot name="ctas" />
      </div>

      {tieneDerecha && (
        <div style="display:flex; flex-direction:column; gap:26px;">
          <slot name="derecha" />
          {bloques.map((b, i) => (
            <div style="position:relative;">
              <span style={`position:absolute; left:0; top:4px; bottom:4px; width:3px; border-radius:2px; background:${i === 0 ? '#dc2626' : '#3f3f46'};`} aria-hidden="true"></span>
              <div style="padding-left:20px;">
                <span style={`font-size:0.7rem; font-weight:800; letter-spacing:0.12em; text-transform:uppercase; display:block; margin-bottom:10px; color:${i === 0 ? '#dc2626' : '#e4e4e7'};`}>{b.label}</span>
                <p style="font-size:0.92rem; color:#a1a1aa; line-height:1.85; margin:0;" set:html={b.texto}></p>
              </div>
            </div>
          ))}
        </div>
      )}

    </div>
  </div>
</section>
