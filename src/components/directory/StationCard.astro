---
/**
 * StationCard — card de estación homologada al patrón del directorio.
 * Anatomía: barra de acento → badge de tipo + estado → nombre → ubicación →
 * domicilio → servicios → chip de contacto → CTAs (llamar / ver ficha).
 */
interface Props {
  station: {
    id: string;
    data: {
      name: string;
      serviceType: string;
      status: string;
      state: string;
      stateSlug: string;
      municipality: string;
      city: string;
      address?: string;
      phone?: string;
      verified?: boolean;
      operatingHours?: string;
      services: string[];
      latitude?: number;
      longitude?: number;
    };
  };
}

const { station } = Astro.props;
const { data } = station;

const tipoLabels: Record<string, string> = {
  profesional: 'Profesional',
  voluntario: 'Voluntario',
  mixto: 'Mixto',
  industrial: 'Industrial',
  aeroportuario: 'Aeroportuario',
  'proteccion-civil': 'Protección Civil',
};

const servicioLabels: Record<string, string> = {
  'combate-incendios': 'Incendios',
  'atencion-medica': 'Médico',
  'rescate-vehicular': 'Rescate vehicular',
  'rescate-acuatico': 'Acuático',
  'rescate-forestal': 'Forestal',
  'rescate-montaña': 'Montaña',
  'materiales-peligrosos': 'HAZMAT',
  'rescate-alturas': 'Alturas',
  'proteccion-civil': 'Prot. Civil',
  capacitacion: 'Capacitación',
  prevencion: 'Prevención',
  explosivos: 'Explosivos',
};

const slug = station.id.split('/').pop()?.replace('.md', '') || '';
const url = `/directorio/${data.stateSlug}/${slug}`;
const tipo = tipoLabels[data.serviceType] || data.serviceType;
const tieneGps = data.latitude != null && data.longitude != null;
---

<article class="dir-card" style="cursor:default;">
  <div class="dir-card-top"></div>
  <div class="dir-card-body">

    <div class="dir-card-head">
      <div style="min-width:0;">
        <div style="display:flex; align-items:center; flex-wrap:wrap; gap:6px; margin-bottom:10px;">
          <span class="dir-badge" style="margin-bottom:0;">{tipo}</span>
          {data.status === 'activa' && (
            <span style="display:inline-flex; align-items:center; gap:5px; font-size:0.63rem; font-weight:700; color:#16a34a; background:#f0fdf4; border:1px solid #dcfce7; padding:3px 8px; border-radius:99px;">
              <span style="width:5px; height:5px; border-radius:50%; background:#16a34a;"></span>
              Activa
            </span>
          )}
          {data.verified && (
            <span style="display:inline-flex; align-items:center; gap:4px; font-size:0.63rem; font-weight:700; color:#52525b; background:#f4f4f5; padding:3px 8px; border-radius:99px;">
              <svg width="9" height="9" fill="none" stroke="#dc2626" stroke-width="3.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Verificada
            </span>
          )}
        </div>
        <h3 class="dir-card-h">
          <a href={url} style="color:inherit; text-decoration:none;">{data.name}</a>
        </h3>
        <p class="dir-card-cap">{[...new Set([data.municipality, data.city, data.state])].join(' · ')}</p>
      </div>
      <span class="dir-code" aria-hidden="true">
        <svg width="19" height="19" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C12 2 7 8 7 13C7 16.866 9.23858 20 12 20C14.7614 20 17 16.866 17 13C17 8 12 2 12 2Z"/></svg>
      </span>
    </div>

    <div class="dir-sep"><span>Domicilio</span><i></i></div>
    <p style="font-size:0.78rem; color:#52525b; line-height:1.6; margin:0;">
      {data.address || 'No publicado en fuentes oficiales'}
    </p>

    <div class="dir-sep"><span>Servicios</span><i></i></div>
    <div class="dir-pills">
      {data.services.slice(0, 4).map((s) => (
        <span class="dir-pill-solid">{servicioLabels[s] || s}</span>
      ))}
      {data.services.length > 4 && (
        <span class="dir-pill-solid" style="color:#a1a1aa;">+{data.services.length - 4}</span>
      )}
    </div>

    <div class={`dir-chip${data.phone ? '' : ' is-gris'}`}>
      <svg width="12" height="12" fill="none" stroke={data.phone ? '#dc2626' : '#71717a'} stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      <span>
        {data.phone ? `${data.phone} · ${data.operatingHours || '24/7'}` : 'Sin teléfono directo · marca 911'}
        {tieneGps ? '' : ' · GPS pendiente'}
      </span>
    </div>

    <div style="margin-top:auto; padding-top:14px; border-top:1px solid #f4f4f5; display:flex; gap:8px;">
      <a
        href={`tel:${data.phone || '911'}`}
        style="flex:1; display:flex; align-items:center; justify-content:center; gap:7px; padding:9px 12px; border:1px solid #e4e4e7; border-radius:9px; font-size:0.76rem; font-weight:700; color:#3f3f46; text-decoration:none; background:#fff;"
      >
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        {data.phone ? 'Llamar' : 'Llamar 911'}
      </a>
      <a
        href={url}
        style="flex:1; display:flex; align-items:center; justify-content:center; gap:7px; padding:9px 12px; border-radius:9px; font-size:0.76rem; font-weight:700; color:#fff; background:#dc2626; text-decoration:none;"
      >
        Ver ficha
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

  </div>
</article>
