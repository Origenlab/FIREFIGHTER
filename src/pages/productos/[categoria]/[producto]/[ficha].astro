---
/**
 * L4 — Ficha de una configuración de marca dentro de un producto.
 * Ruta: /productos/{categoria}/{producto}/{ficha}
 *
 * Se genera una ruta por cada card de `l3.catalogo.cards` que traiga `slug` + `l4`.
 * Una card sin `l4` no produce página y su botón en la L3 va directo a WhatsApp.
 *
 * Homologada con la L3: mismo hero 50/50 sin foto, mismo strip de 6, mismo menú extendido,
 * mismo shell con sidebar, mismas clases .l3-* / .l2-* / .cg-*. Sin CSS nuevo.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import categorias from '../../../../data/productos.json';
import { getPosts } from '../../../../lib/blogData';
import { crearInterlinker, REGLAS_SITIO } from '../../../../lib/interlink';

export function getStaticPaths() {
  const rutas: any[] = [];
  for (const cat of categorias as any[]) {
    if (!cat.l3ok) continue;
    for (const prod of cat.productos ?? []) {
      for (const card of prod.l3?.catalogo?.cards ?? []) {
        if (!card.slug || !card.l4) continue;
        rutas.push({
          params: { categoria: cat.slug, producto: prod.slug, ficha: card.slug },
          props: { cat, prod, card },
        });
      }
    }
  }
  return rutas;
}

const { cat, prod, card } = Astro.props;
const l4 = card.l4;

const SITE = 'https://firefighter.com.mx';
const TEL = '5555555555';
const TEL_FMT = '55 5555 5555';
const WA_NUM = '525500000000';
const wa = (t: string) => `https://wa.me/${WA_NUM}?text=${encodeURIComponent(`Hola, necesito cotizar ${t}`)}`;

const urlCat = `/productos/${cat.slug}`;
const urlProd = `${urlCat}/${prod.slug}`;
const url = `${SITE}${urlProd}/${card.slug}`;

const nombre = `${card.marca} ${card.modelo} · ${card.variante}`;
const waNombre = `traje estructural ${card.marca} ${card.modelo} ${card.variante}`;

// ── Contenido ──
const heroImg = l4.heroImg ?? { src: card.img, alt: card.alt };
const heroBloques = l4.heroBloques ?? [];
const heroDatos = l4.heroDatos ?? [];
const specStrip = l4.specStrip ?? (card.specs ?? []).map((s: string) => ({ label: 'Especificación', valor: s }));
// El badge de la card es a nivel de modelo. Una ficha cuyo alcance no está confirmado
// lo sobreescribe con `l4.badge` para no contradecir su propio contenido.
const badge = l4.badge ?? card.badge;
const secciones = l4.secciones ?? [];

// Los ids de sección vienen de los datos y comparten espacio con los que emite la plantilla.
// Un choque rompe silenciosamente el ancla del menú y del índice, así que el build falla aquí.
const IDS_RESERVADOS = ['ficha', 'galeria', 'sectores', 'preguntas', 'configuraciones', 'catalogo'];
const choques = secciones.map((s: any) => s.id).filter((id: string) => IDS_RESERVADOS.includes(id));
if (choques.length) {
  throw new Error(
    `[L4 ${card.slug}] id de sección reservado por la plantilla: ${choques.join(', ')}. ` +
      `Renómbralo en productos.json. Reservados: ${IDS_RESERVADOS.join(', ')}.`,
  );
}
const dupIds = secciones
  .map((s: any) => s.id)
  .filter((id: string, i: number, a: string[]) => a.indexOf(id) !== i);
if (dupIds.length) {
  throw new Error(`[L4 ${card.slug}] ids de sección duplicados: ${[...new Set(dupIds)].join(', ')}`);
}
const galeria = l4.galeria ?? [];
const aplicaciones = l4.aplicaciones ?? cat.aplicaciones ?? [];
const faqs = l4.faqs ?? [];
const datoClave = l4.datoClave ?? null;
const referencias = l4.referencias ?? [];
const documentacion = cat.documentacion ?? [];

// Configuraciones hermanas: las otras cards del mismo catálogo
const hermanas = (prod.l3?.catalogo?.cards ?? []).filter((c: any) => c.variante !== card.variante);
const hrefHermana = (c: any) => (c.slug && c.l4 ? `${urlProd}/${c.slug}` : `${urlProd}#catalogo`);

// ── Interlinking contextual del cuerpo editorial ──
// Reglas dinámicas primero (hermanas y producto padre) y luego las de sitio.
// Las hermanas van ordenadas de nombre más largo a más corto para resolver solapes:
// "Defender 750" tiene que ganarle a cualquier término más corto que empiece igual.
const il = crearInterlinker(
  [
    ...hermanas
      .filter((c: any) => c.slug && c.l4)
      .map((c: any) => ({
        termino: c.variante,
        href: `${urlProd}/${c.slug}`,
        titulo: `${c.marca} ${c.modelo} · ${c.varianteLabel ?? 'configuración'} ${c.variante}`,
      }))
      .sort((a: any, b: any) => b.termino.length - a.termino.length),
    { termino: prod.nombre, href: urlProd, titulo: `Todas las configuraciones de ${prod.nombre}` },
    // La regla del producto padre ya está arriba: se evita duplicarla desde REGLAS_SITIO.
    ...REGLAS_SITIO.filter((r) => r.href !== urlProd && r.href !== `${urlProd}/${card.slug}`),
  ],
  12,
);

// Los otros componentes de la línea
const hermanos = (cat.productos ?? []).filter((p: any) => p.slug && p.slug !== prod.slug);

// Guías del blog
const todos = await getPosts();
const guias = ((l4.blog ?? []) as string[])
  .map((s) => todos.find((p) => p.slug === s))
  .filter(Boolean)
  .slice(0, 6) as any[];

// ── Schema.org ──
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: nombre,
  description: l4.seoDescription,
  category: cat.nombre,
  url,
  sku: card.slug,
  brand: { '@type': 'Brand', name: card.marca },
  model: `${card.modelo} ${card.variante}`,
  image: [`${SITE}${heroImg.src}`, ...galeria.slice(0, 3).map((g: any) => `${SITE}${g.src}`)],
  isSimilarTo: hermanas.map((c: any) => ({
    '@type': 'Product',
    name: `${c.marca} ${c.modelo} · ${c.variante}`,
    brand: { '@type': 'Brand', name: c.marca },
    url: `${SITE}${hrefHermana(c)}`,
  })),
  additionalProperty: [
    { '@type': 'PropertyValue', name: card.varianteLabel, value: card.variante },
    ...specStrip.map((s: any) => ({ '@type': 'PropertyValue', name: s.label, value: s.valor })),
  ],
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'MXN',
    url,
    seller: { '@type': 'Organization', name: 'FIREFIGHTER México', url: SITE },
  },
};

const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f: any) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<BaseLayout
  title={l4.seoTitle}
  description={l4.seoDescription}
  canonicalUrl={url}
  image={heroImg.src}
  imageAlt={heroImg.alt}
  breadcrumbs={[
    { label: 'Catálogo de Productos', href: '/productos' },
    { label: cat.nombre, href: urlCat },
    { label: prod.nombre, href: urlProd },
    { label: `${card.modelo} ${card.variante}` },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <!-- ══════════ 1 · HERO ══════════ -->
  <section style="background:#09090b; padding:56px 0 72px;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start;">

        <div style="padding-right:0;" class="lg:pr-14 lg:border-r lg:border-[#1f1f23]">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
            <a href={urlProd} style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626; text-decoration:none;">{prod.nombre}</a>
          </div>

          <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px;">
            <span style="display:inline-block; background:#dc2626; color:#fff; font-size:0.62rem; font-weight:800; letter-spacing:0.07em; padding:4px 11px; border-radius:4px; text-transform:uppercase;">{card.marca}</span>
            <span style="display:inline-block; background:#18181b; color:#e4e4e7; border:1px solid #27272a; font-size:0.62rem; font-weight:800; letter-spacing:0.07em; padding:4px 11px; border-radius:4px; text-transform:uppercase;">{badge}</span>
          </div>

          <h1 style="font-size:clamp(1.75rem,3vw,2.7rem); font-weight:800; color:#fafafa; line-height:1.1; margin:0 0 18px; letter-spacing:-0.02em;">{l4.h1}</h1>

          <p style="font-size:1rem; color:#a1a1aa; line-height:1.8; margin:0 0 28px;">{l4.subtitulo}</p>

          <div style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:26px;">
            <a href={wa(waNombre)} target="_blank" rel="noopener" class="l2-cta">
              <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
              <span>Cotizar {card.variante}</span>
            </a>
            <a href={`tel:${TEL}`} class="l2-cta-ghost">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>Hablar con un ingeniero</span>
            </a>
          </div>

          <div style="display:flex; flex-wrap:wrap; gap:10px;">
            {heroDatos.map((d: any) => (
              <div style="display:flex; flex-direction:column; gap:4px; padding:11px 15px; border-radius:9px; background:#18181b; border:1px solid #27272a;">
                <span style="font-size:0.58rem; font-weight:800; letter-spacing:0.12em; text-transform:uppercase; color:#dc2626;">{d.label}</span>
                <span style="font-size:0.79rem; font-weight:600; color:#e4e4e7;">{d.valor}</span>
              </div>
            ))}
          </div>
        </div>

        <div style="display:flex; flex-direction:column; gap:30px;">
          {heroBloques.map((b: any, i: number) => (
            <div style="position:relative;">
              <span style={`position:absolute; left:0; top:4px; bottom:4px; width:3px; border-radius:2px; background:${i === 0 ? '#dc2626' : '#3f3f46'};`} aria-hidden="true"></span>
              <div style="padding-left:22px;">
                <span style={`display:block; font-size:0.68rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:${i === 0 ? '#dc2626' : '#a1a1aa'}; margin-bottom:11px;`}>{b.label}</span>
                <p set:html={b.texto} style="font-size:0.94rem; color:#a1a1aa; line-height:1.85; margin:0;"></p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════ 1b · STRIP DE ESPECIFICACIONES ══════════ -->
  {specStrip.length > 0 && (
    <section class="l3-strip" aria-label={`Especificaciones de ${nombre}`}>
      <div class="l3-strip-grid">
        {specStrip.slice(0, 6).map((s: any) => (
          <div class="l3-strip-cell">
            <span class="l3-strip-label">{s.label}</span>
            <span class="l3-strip-val">{s.valor}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ══════════ 1c · MENÚ EXTENDIDO ══════════ -->
  <nav class="l2-nav" aria-label={`Secciones de ${nombre}`}>
    <div class="l2-nav-grid">
      {[
        { href: '#ficha', label: 'Ficha técnica', sub: `${secciones.length} apartados` },
        { href: '#galeria', label: 'Galería', sub: `${galeria.length} imágenes`, show: galeria.length > 0 },
        { href: '#sectores', label: 'Aplica para', sub: 'Sectores', show: aplicaciones.length > 0 },
        { href: '#preguntas', label: 'Preguntas', sub: `${faqs.length} respuestas`, show: faqs.length > 0 },
        { href: '#configuraciones', label: 'Configuraciones', sub: `Otras ${hermanas.length}`, show: hermanas.length > 0 },
        { href: urlProd, label: 'Volver al producto', sub: prod.nombre },
      ].filter((i) => i.show !== false).map((i) => (
        <a href={i.href} class="l2-nav-item">
          <span class="l2-nav-label">{i.label}</span>
          <span class="l2-nav-sub">{i.sub}</span>
        </a>
      ))}

      <a href={wa(waNombre)} target="_blank" rel="noopener" class="l2-nav-item is-cta">
        <span class="l2-nav-label">
          Cotizar ahora
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </span>
        <span class="l2-nav-sub">Respuesta en 24 h</span>
      </a>
    </div>
  </nav>

  <!-- ══════════ 2 · CUERPO + SIDEBAR ══════════ -->
  <section id="ficha" class="l2-anchor" style="background:#f8fafc; padding:64px 0 88px; border-bottom:1px solid #e4e4e7;">
    <div class="container-custom">
      <div class="l3-shell">

        <!-- ─── Columna 1 · contenido editorial ─── -->
        <div class="l3-body">

          {secciones.map((sec: any) => (
            <div id={sec.id} class="l3-sec">
              <div class="l3-sec-eyebrow"><i></i><span>{sec.eyebrow}</span></div>
              <h2 class="l3-sec-title">{sec.titulo}</h2>

              {(sec.parrafos ?? []).map((p: string) => (
                <p class="l3-p" set:html={il(p)}></p>
              ))}

              {sec.lista?.length > 0 && (
                <div class="l3-defs">
                  {sec.lista.map((it: any) => (
                    <div class="l3-def">
                      <span class="l3-def-t">
                        <svg fill="#dc2626" viewBox="0 0 20 20" aria-hidden="true"><use href="#i-check"/></svg>
                        <span>{it.t}</span>
                      </span>
                      <span class="l3-def-d" set:html={il(it.d)}></span>
                    </div>
                  ))}
                </div>
              )}

              {sec.tabla && (
                <div class="l3-tabla-wrap">
                  <table class="l3-tabla">
                    <thead>
                      <tr>{sec.tabla.head.map((h: string) => <th scope="col">{h}</th>)}</tr>
                    </thead>
                    <tbody>
                      {sec.tabla.rows.map((r: string[]) => (
                        <tr>
                          <th scope="row">{r[0]}</th>
                          {r.slice(1).map((c: string) => <td>{c}</td>)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {sec.nota && (
                <div class="l3-nota">
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M5.07 19H19a2 2 0 001.75-2.96l-6.93-12a2 2 0 00-3.5 0l-6.93 12A2 2 0 005.07 19z"/></svg>
                  <p set:html={il(sec.nota)}></p>
                </div>
              )}
            </div>
          ))}

          <!-- Galería -->
          {galeria.length > 0 && (
            <div id="galeria" class="l3-sec">
              <div class="l3-sec-eyebrow"><i></i><span>Galería técnica</span></div>
              <h2 class="l3-sec-title">{card.modelo} {card.variante} en operación</h2>
              <p class="l3-p">Imágenes de referencia del conjunto estructural y de su uso en estación e intervención. La configuración final se confirma por clave de producto en la orden.</p>
              <div class="l3-gal">
                {galeria.map((im: any) => (
                  <figure class="cs-shot cs-shot-sm">
                    <img src={im.src} alt={im.alt} width="400" height="300" loading="lazy" decoding="async" />
                    {im.caption && <figcaption>{im.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          )}

          <!-- Aplica para -->
          {aplicaciones.length > 0 && (
            <div id="sectores" class="l3-sec">
              <div class="l3-sec-eyebrow"><i></i><span>Aplica para</span></div>
              <h2 class="l3-sec-title">Quién especifica esta configuración</h2>
              <div class="l3-defs">
                {aplicaciones.map((a: any) => (
                  <div class="l3-def">
                    <span class="l3-def-t">
                      <svg fill="#dc2626" viewBox="0 0 20 20" aria-hidden="true"><use href="#i-check"/></svg>
                      <span>{a.sector}</span>
                    </span>
                    <span class="l3-def-d" set:html={il(a.desc)}></span>
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>

        <!-- ─── Columna 2 · sidebar ─── -->
        <aside class="l3-aside">

          <!-- CTA principal -->
          <div class="l3-box l3-box-dark">
            <div class="l3-box-head"><i></i><span>Asesoría técnica</span></div>
            <p class="l3-box-title">Cotiza {card.modelo} {card.variante}</p>
            <p class="l3-box-copy">Propuesta con partidas, clave de producto, edición normativa y certificado. Distribución autorizada, no reventa.</p>
            <div class="l3-facts">
              <span class="l3-fact">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>Propuesta en menos de 24 h hábiles</span>
              </span>
              <span class="l3-fact">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>Juego de tallas de muestra antes de cerrar</span>
              </span>
              <span class="l3-fact">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>Expediente y certificado por escrito</span>
              </span>
            </div>
            <a href={wa(waNombre)} target="_blank" rel="noopener" class="l3-btn-wa">
              <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
              <span>Cotizar por WhatsApp</span>
            </a>
            <a href={`tel:${TEL}`} class="l3-btn-ghost">Llamar al {TEL_FMT}</a>
          </div>

          <!-- Resumen de la configuración -->
          <div class="l3-box l3-box-red">
            <div class="l3-box-head"><i></i><span>{card.varianteLabel}</span></div>
            <p style="font-size:1.02rem; font-weight:800; color:#09090b; margin:0 0 4px; line-height:1.25; letter-spacing:-0.01em;">{card.variante}</p>
            <p style="font-size:0.72rem; font-weight:600; color:#b91c1c; margin:0 0 14px;">{card.marca} {card.modelo}</p>
            <div style="display:flex; flex-direction:column; gap:7px;">
              {(card.specs ?? []).map((s: string) => (
                <span style="display:flex; align-items:flex-start; gap:8px; font-size:0.75rem; color:#52525b; line-height:1.5;">
                  <svg width="12" height="12" fill="#dc2626" viewBox="0 0 20 20" style="flex-shrink:0; margin-top:3px;" aria-hidden="true"><use href="#i-check"/></svg>
                  <span>{s}</span>
                </span>
              ))}
            </div>
          </div>

          <!-- Índice de la ficha -->
          <div class="l3-box">
            <div class="l3-box-head"><i></i><span>En esta ficha</span></div>
            <nav class="l3-toc" aria-label="Índice de la ficha">
              {secciones.map((sec: any) => (
                <a href={`#${sec.id}`}>{sec.titulo}</a>
              ))}
              {galeria.length > 0 && <a href="#galeria">Galería técnica</a>}
              {aplicaciones.length > 0 && <a href="#sectores">Quién especifica esta configuración</a>}
              {faqs.length > 0 && <a href="#preguntas">Preguntas frecuentes</a>}
            </nav>
          </div>

          <!-- Dato clave -->
          {datoClave && (
            <div class="l3-box l3-box-red">
              <div class="l3-box-head"><i></i><span>Dato clave</span></div>
              <p style="font-size:0.9rem; font-weight:800; color:#09090b; margin:0 0 8px; line-height:1.35;">{datoClave.titulo}</p>
              <p style="font-size:0.78rem; color:#52525b; line-height:1.75; margin:0;" set:html={datoClave.texto}></p>
            </div>
          )}

          <!-- Referencias normativas -->
          {referencias.length > 0 && (
            <div class="l3-box">
              <div class="l3-box-head"><i></i><span>Referencias</span></div>
              {referencias.map((n: any) => (
                <div class="l3-norma">
                  <code>{n.code}</code>
                  <span>{n.desc}</span>
                </div>
              ))}
            </div>
          )}

          <!-- Configuraciones hermanas -->
          {hermanas.length > 0 && (
            <div class="l3-box">
              <div class="l3-box-head"><i></i><span>Otras configuraciones</span></div>
              {hermanas.map((c: any) => (
                <a href={hrefHermana(c)} class="l3-sib">
                  <span class="l3-sib-ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d={cat.icon}/></svg>
                  </span>
                  <span class="l3-sib-body">
                    <span class="l3-sib-name">{c.modelo} · {c.variante}</span>
                    <span class="l3-sib-norm">{c.marca} · {c.varianteLabel}</span>
                  </span>
                </a>
              ))}
            </div>
          )}

          <!-- Guías del blog -->
          {guias.length > 0 && (
            <div class="l3-box">
              <div class="l3-box-head"><i></i><span>Guías técnicas</span></div>
              {guias.map((g: any, i: number) => (
                <a href={`/blog/${g.slug}`} class="blog-link-item" style={i === 0 ? 'border-top:0; padding-top:0;' : ''}>
                  <p class="t">{g.title}</p>
                  <p class="m"><span>{g.minutos} min de lectura</span></p>
                </a>
              ))}
            </div>
          )}

          <!-- Documentación -->
          {documentacion.length > 0 && (
            <div class="l3-box l3-box-dark">
              <div class="l3-box-head"><i></i><span>Va con el envío</span></div>
              <div class="l3-facts" style="margin-bottom:14px;">
                {documentacion.map((d: string) => (
                  <span class="l3-fact">
                    <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>{d}</span>
                  </span>
                ))}
              </div>
              <a href="mailto:licitaciones@firefighter.com.mx" class="l3-btn-ghost" style="margin-top:0;">Escribir a licitaciones</a>
            </div>
          )}

        </aside>
      </div>
    </div>
  </section>

  <!-- ══════════ 3 · FAQ + FORMULARIO A WHATSAPP ══════════ -->
  {faqs.length > 0 && (
    <section id="preguntas" class="l2-anchor" style="background:#ffffff; padding:96px 0; border-top:1px solid #e4e4e7;">
      <div class="container-custom">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16" style="align-items:center; margin-bottom:52px;">
          <div>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
              <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
              <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Preguntas frecuentes</span>
            </div>
            <h2 style="font-size:clamp(1.9rem,2.8vw,2.7rem); font-weight:800; color:#09090b; line-height:1.1; margin:0; letter-spacing:-0.02em;">
              Dudas sobre<br>{card.modelo} {card.variante}
            </h2>
          </div>
          <div>
            <span style="font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#09090b; margin-bottom:10px; display:block;">Responde un ingeniero, no un vendedor</span>
            <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0;">
              Las {faqs.length} preguntas que más nos llegan sobre esta configuración, contestadas con el criterio técnico que aplicaríamos en tu proyecto. Si tu caso no está aquí, el formulario arma el mensaje por ti y te contesta un <strong style="color:#09090b; font-weight:600;">ingeniero certificado en NFPA y NOM-002-STPS</strong>.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start;">

          <div>
            {faqs.map((f: any, i: number) => (
              <details class="l2-faq" open={i === 0}>
                <summary>
                  <span>{f.q}</span>
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                </summary>
                <div class="l2-faq-body">{f.a}</div>
              </details>
            ))}
          </div>

          <div class="l2-form">
            <div class="l2-form-head">
              <span class="l2-form-eyebrow">Cotización sin compromiso</span>
              <h3 class="l2-form-title">Cuéntanos qué necesitas</h3>
              <p class="l2-form-sub">
                Completa los campos y el botón abre WhatsApp con tu solicitud ya redactada.
                Respondemos con propuesta técnica en menos de <strong>24 horas hábiles</strong>.
              </p>
            </div>

            <form id="l4-form" class="l2-form-body" novalidate>
              <div class="l2-field">
                <label for="l4-nombre">Nombre y cargo <span aria-hidden="true">*</span></label>
                <input id="l4-nombre" name="nombre" type="text" required autocomplete="name" placeholder="Ing. Roberto Garza · Jefe de Seguridad" />
              </div>

              <div class="l2-field">
                <label for="l4-org">Institución o empresa <span aria-hidden="true">*</span></label>
                <input id="l4-org" name="org" type="text" required autocomplete="organization" placeholder="H. Cuerpo de Bomberos de Monterrey" />
              </div>

              <div class="l2-grid-2">
                <div class="l2-field">
                  <label for="l4-presentacion">Presentación</label>
                  <select id="l4-presentacion" name="presentacion">
                    <option>Traje completo</option>
                    <option>Solo chaquetón</option>
                    <option>Solo pantalón</option>
                    <option>Combo con bota</option>
                    <option>Por definir</option>
                  </select>
                </div>
                <div class="l2-field">
                  <label for="l4-vol">Elementos a equipar</label>
                  <select id="l4-vol" name="volumen">
                    <option>1 a 5</option>
                    <option>6 a 20</option>
                    <option>21 a 50</option>
                    <option>Más de 50</option>
                    <option>Por definir</option>
                  </select>
                </div>
              </div>

              <div class="l2-grid-2">
                <div class="l2-field">
                  <label for="l4-ciudad">Ciudad y estado</label>
                  <input id="l4-ciudad" name="ciudad" type="text" autocomplete="address-level2" placeholder="Monterrey, Nuevo León" />
                </div>
                <div class="l2-field">
                  <label for="l4-contacto">Teléfono o correo <span aria-hidden="true">*</span></label>
                  <input id="l4-contacto" name="contacto" type="text" required autocomplete="email" placeholder="55 1234 5678" />
                </div>
              </div>

              <div class="l2-field">
                <label for="l4-msg">Tallas, color y detalles</label>
                <textarea id="l4-msg" name="mensaje" rows="3" placeholder="Ej. 25 trajes completos en oro, tallas por definir con juego de muestra, entrega antes de diciembre."></textarea>
              </div>

              <label class="l2-check">
                <input id="l4-lic" name="licitacion" type="checkbox" />
                <span>Requiero documentación para licitación pública</span>
              </label>

              <button type="submit" class="l2-form-cta">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
                <span>Enviar por WhatsApp</span>
              </button>

              <p class="l2-form-legal">
                Al enviar se abre WhatsApp con el mensaje redactado; tú decides si lo mandas.
                No almacenamos tus datos en este sitio. Consulta el <a href="/privacidad">aviso de privacidad</a>.
              </p>
            </form>

            <div class="l2-form-foot">
              <a href={`tel:${TEL}`}>
                <span>Ventas directas</span>
                <strong>{TEL_FMT}</strong>
              </a>
              <a href="mailto:licitaciones@firefighter.com.mx">
                <span>Licitaciones</span>
                <strong>licitaciones@firefighter.com.mx</strong>
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- define:vars NO funciona con is:inline: los valores viajan en data-* -->
      <span id="l4-form-data" data-wa={WA_NUM} data-prod={nombre} data-linea={prod.nombre} hidden></span>

      <script is:inline>
        (() => {
          const form = document.getElementById('l4-form');
          const data = document.getElementById('l4-form-data');
          if (!form || !data) return;

          const WA = data.dataset.wa;
          const PRODUCTO = data.dataset.prod;
          const LINEA = data.dataset.linea;
          const val = (id) => (document.getElementById(id)?.value || '').trim();

          form.addEventListener('submit', (e) => {
            e.preventDefault();

            let ok = true;
            ['l4-nombre', 'l4-org', 'l4-contacto'].forEach((id) => {
              const el = document.getElementById(id);
              const campo = el?.closest('.l2-field');
              const vacio = !el || !el.value.trim();
              campo?.classList.toggle('has-error', vacio);
              if (vacio && ok) { el?.focus(); ok = false; }
            });
            if (!ok) return;

            const lic = document.getElementById('l4-lic')?.checked;
            const msg = val('l4-msg');

            const lineas = [
              'Hola FIREFIGHTER, solicito cotizacion de ' + PRODUCTO + '.',
              'Linea: ' + LINEA,
              '',
              'Nombre: ' + val('l4-nombre'),
              'Institucion: ' + val('l4-org'),
              'Presentacion: ' + val('l4-presentacion'),
              'Elementos a equipar: ' + val('l4-vol'),
            ];
            if (val('l4-ciudad')) lineas.push('Ubicacion: ' + val('l4-ciudad'));
            lineas.push('Contacto: ' + val('l4-contacto'));
            if (msg) lineas.push('', 'Detalles: ' + msg);
            if (lic) lineas.push('', 'Requiero documentacion para licitacion publica.');

            window.open('https://wa.me/' + WA + '?text=' + encodeURIComponent(lineas.join('\n')), '_blank', 'noopener');
          });

          form.querySelectorAll('input, select, textarea').forEach((el) => {
            el.addEventListener('input', () => el.closest('.l2-field')?.classList.remove('has-error'));
          });
        })();
      </script>
    </section>
  )}

  <!-- ══════════ 4 · OTRAS CONFIGURACIONES DEL MISMO MODELO ══════════ -->
  {hermanas.length > 0 && (
    <section id="configuraciones" class="l2-anchor" style="background:#09090b; padding:72px 0 64px;">
      <div class="container-custom">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
          <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
          <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Comparar configuraciones</span>
        </div>
        <div class="l2-related-head">
          <h2 style="font-size:clamp(1.4rem,2vw,1.9rem); font-weight:800; color:#fafafa; line-height:1.2; margin:0; letter-spacing:-0.02em;">
            Las otras {hermanas.length} configuraciones del {card.modelo}
          </h2>
          <a href={`${urlProd}#catalogo`} class="l2-related-all">
            <span>Ver el catálogo completo</span>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <div class="l3-hermanos">
          {hermanas.map((c: any) => (
            <a href={hrefHermana(c)} class="l3-herm-item">
              <span class="l3-herm-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d={cat.icon}/></svg>
              </span>
              <span class="l3-herm-name">{c.modelo} · {c.variante}</span>
              <span class="l3-herm-norm">{c.marca} · {c.badge}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════ 5 · COMPLETA EL ENSAMBLE ══════════ -->
  {hermanos.length > 0 && (
    <section style="background:#0c0c0f; padding:64px 0; border-top:1px solid #1f1f23;">
      <div class="container-custom">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
          <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
          <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Completa el ensamble</span>
        </div>
        <div class="l2-related-head">
          <h2 style="font-size:clamp(1.4rem,2vw,1.9rem); font-weight:800; color:#fafafa; line-height:1.2; margin:0; letter-spacing:-0.02em;">
            Los otros {hermanos.length} componentes de {cat.nombre}
          </h2>
          <a href={urlCat} class="l2-related-all">
            <span>Ver la línea completa</span>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <div class="l3-hermanos">
          {hermanos.map((h: any) => (
            <a href={`${urlCat}/${h.slug}`} class="l3-herm-item">
              <span class="l3-herm-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d={cat.icon}/></svg>
              </span>
              <span class="l3-herm-name">{h.nombre}</span>
              <span class="l3-herm-norm">{h.norma}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Resalta la sección del índice que se está leyendo -->
  <script is:inline>
    (() => {
      const enlaces = Array.from(document.querySelectorAll('.l3-toc a'));
      if (!enlaces.length || !('IntersectionObserver' in window)) return;
      const porId = new Map(enlaces.map((a) => [a.getAttribute('href').slice(1), a]));
      const obs = new IntersectionObserver((entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          enlaces.forEach((a) => a.classList.remove('is-active'));
          porId.get(e.target.id)?.classList.add('is-active');
        }
      }, { rootMargin: '-110px 0px -70% 0px', threshold: 0 });
      porId.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) obs.observe(el);
      });
    })();
  </script>

</BaseLayout>
