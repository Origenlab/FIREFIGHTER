---
/**
 * L3 — Ficha de producto dentro de una categoría.
 * Ruta: /productos/{categoria}/{producto}
 *
 * Solo se generan las categorías marcadas con `l3ok: true` en productos.json.
 * Un producto con bloque `l3` rinde la ficha completa; sin `l3` rinde un borrador
 * derivado de los datos de la L2 y sale con noindex hasta que se enriquezca.
 *
 * Homologada con la L2: colores sólidos, header 50/50, inline styles para layout,
 * clases .l3-* / .l2-* en modules.css.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import categorias from '../../../data/productos.json';
import { getPosts } from '../../../lib/blogData';
import { crearInterlinker, REGLAS_SITIO } from '../../../lib/interlink';

export function getStaticPaths() {
  const rutas: any[] = [];
  for (const cat of categorias as any[]) {
    if (!cat.l3ok) continue;
    for (const prod of cat.productos ?? []) {
      if (!prod.slug || !prod.intro) continue;
      rutas.push({
        params: { categoria: cat.slug, producto: prod.slug },
        props: { cat, prod },
      });
    }
  }
  return rutas;
}

const { cat, prod } = Astro.props;
const l3 = prod.l3 ?? null;
const esBorrador = !l3;

const SITE = 'https://firefighter.com.mx';
const TEL = '5555555555';
const TEL_FMT = '55 5555 5555';
const WA_NUM = '525500000000';
const wa = (t: string) => `https://wa.me/${WA_NUM}?text=${encodeURIComponent(`Hola, necesito cotizar ${t}`)}`;

/** "de" + un label que empieza con artículo: "el Cairns 1836" → "del Cairns 1836". */
const deLabel = (s: string) => (/^el\s/i.test(s) ? `del ${s.slice(3)}` : `de ${s}`);

const urlCat = `/productos/${cat.slug}`;
const url = `${SITE}${urlCat}/${prod.slug}`;

// ── Contenido: bloque l3 o borrador desde la L2 ──
const h1 = l3?.h1 ?? `${prod.nombre} certificados ${prod.norma}`;
const subtitulo = l3?.subtitulo ?? prod.desc;
const seoTitle = l3?.seoTitle ?? `${prod.nombre} ${prod.norma}`;
const seoDescription = l3?.seoDescription ?? prod.desc;
const heroImg = l3?.heroImg ?? prod.galeria?.[0] ?? cat.imagenes.hero;
const heroDatos = l3?.heroDatos ?? [
  { label: 'Certificación', valor: prod.norma },
  { label: 'Línea', valor: cat.nombre },
];
// El hero NO lleva foto: la columna derecha son dos bloques de copy con SEO,
// homologado al hero de la L2. `heroImg` se conserva solo para og:image y el schema Product.
const heroBloques = l3?.heroBloques ?? [
  { label: 'Cómo funciona', texto: prod.intro?.[0] ?? prod.desc },
  { label: 'Cómo se compra', texto: prod.intro?.[1] ?? cat.descripcion },
].filter((b) => b.texto);
const specStrip = l3?.specStrip ?? (prod.specs ?? []).map((s: string) => ({ label: 'Especificación', valor: s }));
const secciones = l3?.secciones ?? [
  {
    id: 'ficha-tecnica',
    eyebrow: prod.eyebrow ?? 'Ficha técnica',
    titulo: `Qué es ${prod.nombre}`,
    parrafos: prod.intro,
  },
];
const catalogo = l3?.catalogo ?? null;
const galeria = l3?.galeria ?? prod.galeria ?? [];
const aplicaciones = l3?.aplicaciones ?? cat.aplicaciones ?? [];
const faqs = l3?.faqs ?? cat.faqs ?? [];
const datoClave = l3?.datoClave ?? null;
// El expediente es por pieza: una ficha puede sobreescribir la lista de la categoría
// (la del traje habla de tres capas y lavado; la del casco, de suspensión y coquilla).
const documentacion = prod.l3?.documentacion ?? cat.documentacion ?? [];

// Normas: las referenciadas por la ficha, resueltas contra el catálogo de la categoría
const normasCat: any[] = cat.normas ?? [];
const normas = l3?.normasRef
  ? l3.normasRef.map((c: string) => normasCat.find((n) => n.code === c)).filter(Boolean)
  : normasCat.filter((n) => n.code === prod.norma).concat(normasCat.slice(0, 3)).slice(0, 4);

// Hermanos de la misma categoría (los otros componentes de la línea)
const hermanos = (cat.productos ?? []).filter((p: any) => p.slug && p.slug !== prod.slug);

// ── Interlinking contextual del cuerpo editorial ──
// Enlaza a las fichas L4 publicadas de este producto y a los artículos del blog.
// Por cada ficha L4 publicada se generan dos términos: "marca modelo" (Bullard PX Series) y
// la variante. El primero solo entra si es único entre las fichas —en trajes las cinco
// comparten "SKÖLD HERÖ" y apuntaría a cinco destinos distintos—.
const cardsConFicha = ((prod.l3?.catalogo?.cards ?? []) as any[]).filter((c) => c.slug && c.l4);
const marcaModelo = (c: any) => `${c.marca} ${c.modelo}`;
const reglasFichas = cardsConFicha
  .flatMap((c) => {
    const href = `${urlCat}/${prod.slug}/${c.slug}`;
    const titulo = `${c.marca} ${c.modelo} · ${c.varianteLabel ?? 'configuración'} ${c.variante}`;
    const unico = cardsConFicha.filter((o) => marcaModelo(o) === marcaModelo(c)).length === 1;
    return [
      ...(unico ? [{ termino: marcaModelo(c), href, titulo }] : []),
      { termino: c.variante, href, titulo },
    ];
  })
  .sort((a, b) => b.termino.length - a.termino.length);

const il = crearInterlinker(
  [
    ...reglasFichas,
    // Una ficha no se enlaza a sí misma: REGLAS_SITIO ya incluye las L3 publicadas.
    ...REGLAS_SITIO.filter((r) => r.href !== `${urlCat}/${prod.slug}`),
  ],
  12,
);

// Otras categorías del catálogo
const otras = (categorias as any[]).filter((c) => c.slug !== cat.slug);

// Guías del blog ligadas a esta ficha
const todos = await getPosts();
const guias = ((l3?.blog ?? []) as string[])
  .map((s) => todos.find((p) => p.slug === s))
  .filter(Boolean)
  .slice(0, 6) as any[];

// ── Schema.org ──
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: prod.nombre,
  description: seoDescription,
  category: cat.nombre,
  url,
  image: [`${SITE}${heroImg.src}`, ...galeria.slice(0, 3).map((g: any) => `${SITE}${g.src}`)],
  brand: { '@type': 'Brand', name: cat.marcas?.[0] ?? 'FIREFIGHTER México' },
  ...(specStrip.length
    ? {
        additionalProperty: specStrip.slice(0, 6).map((s: any) => ({
          '@type': 'PropertyValue',
          name: s.label,
          value: s.valor,
        })),
      }
    : {}),
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'MXN',
    url,
    seller: { '@type': 'Organization', name: 'FIREFIGHTER México', url: SITE },
  },
};

// Catálogo por marca: cada card es un Product dentro de un ItemList.
// La marca vive en la card, no en el catálogo: así entran varias marcas en el mismo grid.
const marcasCatalogo: string[] = catalogo
  ? [...new Set(catalogo.cards.map((c: any) => c.marca as string))]
  : [];

const catalogoSchema = catalogo
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `${prod.nombre} · configuraciones por marca`,
      description: `Configuraciones cotizables de ${marcasCatalogo.join(', ')} para ${prod.nombre.toLowerCase()}.`,
      url: `${url}#catalogo`,
      numberOfItems: catalogo.cards.length,
      itemListElement: catalogo.cards.map((c: any, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Product',
          name: `${c.marca} ${c.modelo} · ${c.variante}`,
          description: String(c.desc).replace(/<[^>]+>/g, ''),
          category: cat.nombre,
          brand: { '@type': 'Brand', name: c.marca },
          model: `${c.modelo} ${c.variante}`,
          image: `${SITE}${c.img}`,
          url: c.slug && c.l4 ? `${url}/${c.slug}` : `${url}#catalogo`,
          additionalProperty: [
            { '@type': 'PropertyValue', name: c.varianteLabel, value: c.variante },
            ...c.specs.map((s: string) => ({
              '@type': 'PropertyValue',
              name: 'Especificación',
              value: s,
            })),
          ],
          offers: {
            // La oferta apunta a la misma URL que el producto: a su ficha L4 si existe.
            '@type': 'Offer',
            availability: 'https://schema.org/InStock',
            priceCurrency: 'MXN',
            url: c.slug && c.l4 ? `${url}/${c.slug}` : `${url}#catalogo`,
            seller: { '@type': 'Organization', name: 'FIREFIGHTER México', url: SITE },
          },
        },
      })),
    }
  : null;

const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f: any) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonicalUrl={url}
  image={heroImg.src}
  imageAlt={heroImg.alt}
  noindex={esBorrador}
  breadcrumbs={[
    { label: 'Catálogo de Productos', href: '/productos' },
    { label: cat.nombre, href: urlCat },
    { label: prod.nombre },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    {catalogoSchema && <script type="application/ld+json" set:html={JSON.stringify(catalogoSchema)} />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <!-- ══════════ 1 · HERO DE PRODUCTO ══════════ -->
  <section style="background:#09090b; padding:56px 0 72px;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start;">

        <!-- Identidad -->
        <div style="padding-right:0;" class="lg:pr-14 lg:border-r lg:border-[#1f1f23]">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
            <a href={urlCat} style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626; text-decoration:none;">{cat.nombre}</a>
          </div>

          <span style="display:inline-block; background:#dc2626; color:#fff; font-size:0.62rem; font-weight:800; letter-spacing:0.07em; padding:4px 11px; border-radius:4px; text-transform:uppercase; margin-bottom:18px;">{prod.norma}</span>

          <h1 style="font-size:clamp(1.8rem,3.2vw,2.8rem); font-weight:800; color:#fafafa; line-height:1.1; margin:0 0 18px; letter-spacing:-0.02em;">{h1}</h1>

          <p style="font-size:1rem; color:#a1a1aa; line-height:1.8; margin:0 0 28px;">{subtitulo}</p>

          <div style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:26px;">
            <a href={wa(prod.nombre)} target="_blank" rel="noopener" class="l2-cta">
              <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
              <span>Cotizar {prod.nombre}</span>
            </a>
            <a href={`tel:${TEL}`} class="l2-cta-ghost">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>Hablar con un ingeniero</span>
            </a>
          </div>

          <div style="display:flex; flex-wrap:wrap; gap:10px;">
            {heroDatos.map((d: any) => (
              <div style="display:flex; flex-direction:column; gap:4px; padding:11px 15px; border-radius:9px; background:#18181b; border:1px solid #27272a;">
                <span style="font-size:0.58rem; font-weight:800; letter-spacing:0.12em; text-transform:uppercase; color:#dc2626;">{d.label}</span>
                <span style="font-size:0.79rem; font-weight:600; color:#e4e4e7;">{d.valor}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Columna derecha: dos bloques de contexto con SEO -->
        <div style="display:flex; flex-direction:column; gap:30px;">
          {heroBloques.map((b: any, i: number) => (
            <div style="position:relative;">
              <span style={`position:absolute; left:0; top:4px; bottom:4px; width:3px; border-radius:2px; background:${i === 0 ? '#dc2626' : '#3f3f46'};`} aria-hidden="true"></span>
              <div style="padding-left:22px;">
                <span style={`display:block; font-size:0.68rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:${i === 0 ? '#dc2626' : '#a1a1aa'}; margin-bottom:11px;`}>{b.label}</span>
                <p set:html={b.texto} style="font-size:0.94rem; color:#a1a1aa; line-height:1.85; margin:0;"></p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════ 1b · STRIP DE ESPECIFICACIONES (full-bleed) ══════════ -->
  {specStrip.length > 0 && (
    <section class="l3-strip" aria-label={`Especificaciones de ${prod.nombre}`}>
      <div class="l3-strip-grid">
        {specStrip.slice(0, 6).map((s: any) => (
          <div class="l3-strip-cell">
            <span class="l3-strip-label">{s.label}</span>
            <span class="l3-strip-val">{s.valor}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ══════════ 1c · MENÚ EXTENDIDO (full-bleed) ══════════ -->
  <nav class="l2-nav" aria-label={`Secciones de ${prod.nombre}`}>
    <div class="l2-nav-grid">
      {[
        { href: '#ficha', label: 'Ficha técnica', sub: `${secciones.length} apartados` },
        { href: '#catalogo', label: 'Catálogo', sub: `${catalogo?.cards.length ?? 0} configuraciones`, show: !!catalogo },
        { href: '#galeria', label: 'Galería', sub: `${galeria.length} imágenes`, show: galeria.length > 0 },
        { href: '#sectores', label: 'Aplica para', sub: 'Sectores', show: aplicaciones.length > 0 },
        { href: '#preguntas', label: 'Preguntas', sub: `${faqs.length} respuestas`, show: faqs.length > 0 },
        { href: urlCat, label: 'Volver a la línea', sub: cat.nombre },
      ].filter((i) => i.show !== false).map((i) => (
        <a href={i.href} class="l2-nav-item">
          <span class="l2-nav-label">{i.label}</span>
          <span class="l2-nav-sub">{i.sub}</span>
        </a>
      ))}

      <a href={wa(prod.nombre)} target="_blank" rel="noopener" class="l2-nav-item is-cta">
        <span class="l2-nav-label">
          Cotizar ahora
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </span>
        <span class="l2-nav-sub">Respuesta en 24 h</span>
      </a>
    </div>
  </nav>

  <!-- ══════════ 2 · CUERPO + SIDEBAR ══════════ -->
  <section id="ficha" class="l2-anchor" style="background:#f8fafc; padding:64px 0 88px; border-bottom:1px solid #e4e4e7;">
    <div class="container-custom">
      <div class="l3-shell">

        <!-- ─── Columna 1 · catálogo de marca + contenido editorial ─── -->
        <div style="min-width:0; display:flex; flex-direction:column;">

        <!-- Catálogo por marca: cards homologadas al patrón del index, 3 por fila -->
        {catalogo && (
          <div id="catalogo" class="l3-cat l3-sec">
            <div class="l3-sec-eyebrow"><i></i><span>{catalogo.eyebrow}</span></div>
            <h2 class="l3-cat-title" set:html={catalogo.titulo}></h2>
            <p class="l3-cat-lead" set:html={catalogo.intro}></p>

            <div class="l3-cat-grid">
              {catalogo.cards.map((c: any) => (
                <!-- Todas las cards son idénticas: lo que distingue a una configuración
                     documentada de una sin ficha es el texto del chip, no el estilo. -->
                <article class="cg-card">
                  <div class="cg-media" style={`background-image:url('${c.img}');`} role="img" aria-label={c.alt}>
                    <span class="cg-veil" aria-hidden="true"></span>
                    <span class="cg-badge">{c.badge}</span>
                    <span class="cg-marca">{c.marca}</span>
                    <span class="cg-ref">
                      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      <span>{catalogo.imgRef}</span>
                    </span>
                    <span class="cg-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d={cat.icon}/></svg>
                    </span>
                  </div>

                  <div class="cg-body">
                    <div class="cg-variante">
                      <span class="cg-variante-label">{c.varianteLabel}</span>
                      <span class="cg-variante-val">{c.variante}</span>
                    </div>

                    <h3 class="cg-title">{c.marca} {c.modelo} · {c.variante}</h3>
                    <p class="cg-desc" set:html={c.desc}></p>

                    <div class="cg-sep"><span>Especificaciones</span><i></i></div>
                    <ul class="cg-specs">
                      {c.specs.map((sp: string) => (
                        <li>
                          <svg width="12" height="12" fill="#dc2626" viewBox="0 0 20 20" aria-hidden="true"><use href="#i-check"/></svg>
                          <span>{sp}</span>
                        </li>
                      ))}
                    </ul>

                    <div class="cg-highlight" style="margin-bottom:16px;">
                      <svg width="13" height="13" fill="#dc2626" viewBox="0 0 20 20" aria-hidden="true"><use href="#i-check"/></svg>
                      <span>{c.chip}</span>
                    </div>

                    {/* Con ficha L4 el botón entra a la ficha; sin ella va directo a WhatsApp */}
                    {c.slug && c.l4 ? (
                      <a href={`${urlCat}/${prod.slug}/${c.slug}`} class="cg-btn">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                        {/* "de" + "el X" se contrae en "del X": el label lleva su artículo */}
                        <span>Ver ficha {deLabel(c.fichaLabel ?? c.variante)}</span>
                      </a>
                    ) : (
                      <a href={wa(`${prod.nombre} · ${c.marca} ${c.modelo} ${c.variante}`)} target="_blank" rel="noopener" class="cg-btn">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
                        <span>Cotizar {c.variante}</span>
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>

            {catalogo.nota && (
              <div class="l3-cat-nota">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p set:html={catalogo.nota}></p>
              </div>
            )}
          </div>
        )}

        <!-- Cuerpo editorial -->
        <div class="l3-body">

          {secciones.map((sec: any) => (
            <div id={sec.id} class="l3-sec">
              <div class="l3-sec-eyebrow"><i></i><span>{sec.eyebrow}</span></div>
              <h2 class="l3-sec-title">{sec.titulo}</h2>

              {(sec.parrafos ?? []).map((p: string) => (
                <p class="l3-p" set:html={il(p)}></p>
              ))}

              {sec.lista?.length > 0 && (
                <div class="l3-defs">
                  {sec.lista.map((it: any) => (
                    <div class="l3-def">
                      <span class="l3-def-t">
                        <svg fill="#dc2626" viewBox="0 0 20 20" aria-hidden="true"><use href="#i-check"/></svg>
                        <span>{it.t}</span>
                      </span>
                      <span class="l3-def-d" set:html={il(it.d)}></span>
                    </div>
                  ))}
                </div>
              )}

              {sec.tabla && (
                <div class="l3-tabla-wrap">
                  <table class="l3-tabla">
                    <thead>
                      <tr>{sec.tabla.head.map((h: string) => <th scope="col" set:html={h}></th>)}</tr>
                    </thead>
                    <tbody>
                      {/* Las celdas se imprimen con set:html: el copy usa <strong> para el dato
                          que decide la fila. NO se pasan por el interlinker a propósito —una
                          tabla llena de enlaces se lee como spam. */}
                      {sec.tabla.rows.map((r: string[]) => (
                        <tr>
                          <th scope="row" set:html={r[0]}></th>
                          {r.slice(1).map((c: string) => <td set:html={c}></td>)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {sec.nota && (
                <div class="l3-nota">
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M5.07 19H19a2 2 0 001.75-2.96l-6.93-12a2 2 0 00-3.5 0l-6.93 12A2 2 0 005.07 19z"/></svg>
                  <p set:html={il(sec.nota)}></p>
                </div>
              )}
            </div>
          ))}

          <!-- Galería técnica -->
          {galeria.length > 0 && (
            <div id="galeria" class="l3-sec">
              <div class="l3-sec-eyebrow"><i></i><span>Galería técnica</span></div>
              <h2 class="l3-sec-title">{prod.nombre} en operación</h2>
              <p class="l3-p">Imágenes de referencia de la pieza y de su uso en estación e intervención. La configuración final se define en el pedido.</p>
              <div class="l3-gal">
                {galeria.map((im: any) => (
                  <figure class="cs-shot cs-shot-sm">
                    <img src={im.src} alt={im.alt} width="400" height="300" loading="lazy" decoding="async" />
                    {im.caption && <figcaption>{im.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          )}

          <!-- Aplica para -->
          {aplicaciones.length > 0 && (
            <div id="sectores" class="l3-sec">
              <div class="l3-sec-eyebrow"><i></i><span>Aplica para</span></div>
              <h2 class="l3-sec-title">Quién especifica esta pieza</h2>
              <div class="l3-defs">
                {aplicaciones.map((a: any) => (
                  <div class="l3-def">
                    <span class="l3-def-t">
                      <svg fill="#dc2626" viewBox="0 0 20 20" aria-hidden="true"><use href="#i-check"/></svg>
                      <span>{a.sector}</span>
                    </span>
                    <span class="l3-def-d" set:html={il(a.desc)}></span>
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>
        </div>

        <!-- ─── Columna 2 · sidebar ─── -->
        <aside class="l3-aside">

          <!-- CTA principal -->
          <div class="l3-box l3-box-dark">
            <div class="l3-box-head"><i></i><span>Asesoría técnica</span></div>
            <p class="l3-box-title">Cotiza {prod.nombre}</p>
            <p class="l3-box-copy">Propuesta técnica con partidas, norma aplicable y número de parte. Distribución autorizada, no reventa.</p>
            <div class="l3-facts">
              <span class="l3-fact">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>Respuesta en menos de 24 h hábiles</span>
              </span>
              <span class="l3-fact">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>Cobertura en los 32 estados</span>
              </span>
              <span class="l3-fact">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>Documentación para licitaciones</span>
              </span>
            </div>
            <a href={wa(prod.nombre)} target="_blank" rel="noopener" class="l3-btn-wa">
              <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
              <span>Cotizar por WhatsApp</span>
            </a>
            <a href={`tel:${TEL}`} class="l3-btn-ghost">Llamar al {TEL_FMT}</a>
          </div>

          <!-- Índice de la ficha -->
          <div class="l3-box">
            <div class="l3-box-head"><i></i><span>En esta ficha</span></div>
            <nav class="l3-toc" aria-label="Índice de la ficha">
              {catalogo && <a href="#catalogo">Catálogo por marca</a>}
              {secciones.map((sec: any) => (
                <a href={`#${sec.id}`}>{sec.titulo}</a>
              ))}
              {galeria.length > 0 && <a href="#galeria">Galería técnica</a>}
              {aplicaciones.length > 0 && <a href="#sectores">Quién especifica esta pieza</a>}
              {faqs.length > 0 && <a href="#preguntas">Preguntas frecuentes</a>}
            </nav>
          </div>

          <!-- Dato clave -->
          {datoClave && (
            <div class="l3-box l3-box-red">
              <div class="l3-box-head"><i></i><span>Dato clave</span></div>
              <p style="font-size:0.9rem; font-weight:800; color:#09090b; margin:0 0 8px; line-height:1.35;">{datoClave.titulo}</p>
              <p style="font-size:0.78rem; color:#52525b; line-height:1.75; margin:0;" set:html={datoClave.texto}></p>
            </div>
          )}

          <!-- Normas aplicables -->
          {normas.length > 0 && (
            <div class="l3-box">
              <div class="l3-box-head"><i></i><span>Normas aplicables</span></div>
              {normas.map((n: any) => (
                <div class="l3-norma">
                  <code>{n.code}</code>
                  <span>{n.desc}</span>
                </div>
              ))}
            </div>
          )}

          <!-- Otros componentes de la línea -->
          {hermanos.length > 0 && (
            <div class="l3-box">
              <div class="l3-box-head"><i></i><span>Completa el ensamble</span></div>
              {hermanos.map((h: any) => (
                <a href={`${urlCat}/${h.slug}`} class="l3-sib">
                  <span class="l3-sib-ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d={cat.icon}/></svg>
                  </span>
                  <span class="l3-sib-body">
                    <span class="l3-sib-name">{h.nombre}</span>
                    <span class="l3-sib-norm">{h.norma}</span>
                  </span>
                </a>
              ))}
            </div>
          )}

          <!-- Guías del blog -->
          {guias.length > 0 && (
            <div class="l3-box">
              <div class="l3-box-head"><i></i><span>Guías técnicas</span></div>
              {guias.map((g: any, i: number) => (
                <a href={`/blog/${g.slug}`} class="blog-link-item" style={i === 0 ? 'border-top:0; padding-top:0;' : ''}>
                  <p class="t">{g.title}</p>
                  <p class="m"><span>{g.minutos} min de lectura</span></p>
                </a>
              ))}
            </div>
          )}

          <!-- Documentación -->
          {documentacion.length > 0 && (
            <div class="l3-box l3-box-dark">
              <div class="l3-box-head"><i></i><span>Va con el envío</span></div>
              <div class="l3-facts" style="margin-bottom:14px;">
                {documentacion.map((d: string) => (
                  <span class="l3-fact">
                    <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>{d}</span>
                  </span>
                ))}
              </div>
              <a href="mailto:licitaciones@firefighter.com.mx" class="l3-btn-ghost" style="margin-top:0;">Escribir a licitaciones</a>
            </div>
          )}

        </aside>
      </div>
    </div>
  </section>

  <!-- ══════════ 3 · FAQ + FORMULARIO A WHATSAPP ══════════ -->
  {faqs.length > 0 && (
    <section id="preguntas" class="l2-anchor" style="background:#ffffff; padding:96px 0; border-top:1px solid #e4e4e7;">
      <div class="container-custom">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16" style="align-items:center; margin-bottom:52px;">
          <div>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
              <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
              <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Preguntas frecuentes</span>
            </div>
            <h2 style="font-size:clamp(1.9rem,2.8vw,2.7rem); font-weight:800; color:#09090b; line-height:1.1; margin:0; letter-spacing:-0.02em;">
              Dudas sobre<br>{prod.nombre}
            </h2>
          </div>
          <div>
            <span style="font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#09090b; margin-bottom:10px; display:block;">Responde un ingeniero, no un vendedor</span>
            <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0;">
              Las {faqs.length} preguntas que más nos llegan sobre esta pieza, contestadas con el criterio técnico que aplicaríamos en tu proyecto. Si tu caso no está aquí, el formulario arma el mensaje por ti y te contesta un <strong style="color:#09090b; font-weight:600;">ingeniero certificado en NFPA y NOM-002-STPS</strong>.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start;">

          <div>
            {faqs.map((f: any, i: number) => (
              <details class="l2-faq" open={i === 0}>
                <summary>
                  <span>{f.q}</span>
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                </summary>
                <div class="l2-faq-body">{f.a}</div>
              </details>
            ))}
          </div>

          <div class="l2-form">
            <div class="l2-form-head">
              <span class="l2-form-eyebrow">Cotización sin compromiso</span>
              <h3 class="l2-form-title">Cuéntanos qué necesitas</h3>
              <p class="l2-form-sub">
                Completa los campos y el botón abre WhatsApp con tu solicitud ya redactada.
                Respondemos con propuesta técnica en menos de <strong>24 horas hábiles</strong>.
              </p>
            </div>

            <form id="l3-form" class="l2-form-body" novalidate>
              <div class="l2-field">
                <label for="l3-nombre">Nombre y cargo <span aria-hidden="true">*</span></label>
                <input id="l3-nombre" name="nombre" type="text" required autocomplete="name" placeholder="Ing. Roberto Garza · Jefe de Seguridad" />
              </div>

              <div class="l2-field">
                <label for="l3-org">Institución o empresa <span aria-hidden="true">*</span></label>
                <input id="l3-org" name="org" type="text" required autocomplete="organization" placeholder="H. Cuerpo de Bomberos de Monterrey" />
              </div>

              <div class="l2-grid-2">
                <div class="l2-field">
                  <label for="l3-tipo">Tipo de cliente</label>
                  <select id="l3-tipo" name="tipo">
                    <option>Cuerpo de bomberos</option>
                    <option>Brigada industrial</option>
                    <option>Protección civil</option>
                    <option>Gobierno · licitación</option>
                    <option>Empresa privada</option>
                    <option>Otro</option>
                  </select>
                </div>
                <div class="l2-field">
                  <label for="l3-vol">Piezas o elementos</label>
                  <select id="l3-vol" name="volumen">
                    <option>1 a 5</option>
                    <option>6 a 20</option>
                    <option>21 a 50</option>
                    <option>Más de 50</option>
                    <option>Por definir</option>
                  </select>
                </div>
              </div>

              <div class="l2-grid-2">
                <div class="l2-field">
                  <label for="l3-ciudad">Ciudad y estado</label>
                  <input id="l3-ciudad" name="ciudad" type="text" autocomplete="address-level2" placeholder="Monterrey, Nuevo León" />
                </div>
                <div class="l2-field">
                  <label for="l3-contacto">Teléfono o correo <span aria-hidden="true">*</span></label>
                  <input id="l3-contacto" name="contacto" type="text" required autocomplete="email" placeholder="55 1234 5678" />
                </div>
              </div>

              <div class="l2-field">
                <label for="l3-msg">Detalles del requerimiento</label>
                <textarea id="l3-msg" name="mensaje" rows="3" placeholder="Ej. 25 juegos de chaquetón y pantalón, tallas por definir, entrega antes de diciembre."></textarea>
              </div>

              <label class="l2-check">
                <input id="l3-lic" name="licitacion" type="checkbox" />
                <span>Requiero documentación para licitación pública</span>
              </label>

              <button type="submit" class="l2-form-cta">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
                <span>Enviar por WhatsApp</span>
              </button>

              <p class="l2-form-legal">
                Al enviar se abre WhatsApp con el mensaje redactado; tú decides si lo mandas.
                No almacenamos tus datos en este sitio. Consulta el <a href="/privacidad">aviso de privacidad</a>.
              </p>
            </form>

            <div class="l2-form-foot">
              <a href={`tel:${TEL}`}>
                <span>Ventas directas</span>
                <strong>{TEL_FMT}</strong>
              </a>
              <a href="mailto:licitaciones@firefighter.com.mx">
                <span>Licitaciones</span>
                <strong>licitaciones@firefighter.com.mx</strong>
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- define:vars NO funciona con is:inline: los valores viajan en data-* -->
      <span id="l3-form-data" data-wa={WA_NUM} data-prod={prod.nombre} data-cat={cat.nombre} hidden></span>

      <script is:inline>
        (() => {
          const form = document.getElementById('l3-form');
          const data = document.getElementById('l3-form-data');
          if (!form || !data) return;

          const WA = data.dataset.wa;
          const PRODUCTO = data.dataset.prod;
          const CATEGORIA = data.dataset.cat;
          const val = (id) => (document.getElementById(id)?.value || '').trim();

          form.addEventListener('submit', (e) => {
            e.preventDefault();

            let ok = true;
            ['l3-nombre', 'l3-org', 'l3-contacto'].forEach((id) => {
              const el = document.getElementById(id);
              const campo = el?.closest('.l2-field');
              const vacio = !el || !el.value.trim();
              campo?.classList.toggle('has-error', vacio);
              if (vacio && ok) { el?.focus(); ok = false; }
            });
            if (!ok) return;

            const lic = document.getElementById('l3-lic')?.checked;
            const msg = val('l3-msg');

            const lineas = [
              'Hola FIREFIGHTER, solicito cotizacion de ' + PRODUCTO + '.',
              'Linea: ' + CATEGORIA,
              '',
              'Nombre: ' + val('l3-nombre'),
              'Institucion: ' + val('l3-org'),
              'Tipo de cliente: ' + val('l3-tipo'),
              'Piezas o elementos: ' + val('l3-vol'),
            ];
            if (val('l3-ciudad')) lineas.push('Ubicacion: ' + val('l3-ciudad'));
            lineas.push('Contacto: ' + val('l3-contacto'));
            if (msg) lineas.push('', 'Requerimiento: ' + msg);
            if (lic) lineas.push('', 'Requiero documentacion para licitacion publica.');

            window.open('https://wa.me/' + WA + '?text=' + encodeURIComponent(lineas.join('\n')), '_blank', 'noopener');
          });

          form.querySelectorAll('input, select, textarea').forEach((el) => {
            el.addEventListener('input', () => el.closest('.l2-field')?.classList.remove('has-error'));
          });
        })();
      </script>
    </section>
  )}

  <!-- ══════════ 4 · COMPLETA EL ENSAMBLE (hermanos) ══════════ -->
  {hermanos.length > 0 && (
    <section style="background:#09090b; padding:72px 0 64px;">
      <div class="container-custom">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
          <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
          <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Completa el ensamble</span>
        </div>
        <div class="l2-related-head">
          <h2 style="font-size:clamp(1.4rem,2vw,1.9rem); font-weight:800; color:#fafafa; line-height:1.2; margin:0; letter-spacing:-0.02em;">
            Los otros {hermanos.length} componentes de {cat.nombre}
          </h2>
          <a href={urlCat} class="l2-related-all">
            <span>Ver la línea completa</span>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <div class="l3-hermanos">
          {hermanos.map((h: any) => (
            <a href={`${urlCat}/${h.slug}`} class="l3-herm-item">
              <span class="l3-herm-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d={cat.icon}/></svg>
              </span>
              <span class="l3-herm-name">{h.nombre}</span>
              <span class="l3-herm-norm">{h.norma}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════ 5 · OTRAS LÍNEAS DEL CATÁLOGO ══════════ -->
  <section style="background:#0c0c0f; padding:64px 0; border-top:1px solid #1f1f23;">
    <div class="container-custom">
      <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
        <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
        <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Seguir explorando</span>
      </div>
      <div class="l2-related-head">
        <h2 style="font-size:clamp(1.4rem,2vw,1.9rem); font-weight:800; color:#fafafa; line-height:1.2; margin:0; letter-spacing:-0.02em;">
          Las otras {otras.length} líneas del catálogo
        </h2>
        <a href="/productos" class="l2-related-all">
          <span>Ver catálogo completo</span>
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>

      <div class="l2-related">
        {otras.map((c: any) => (
          <a href={`/productos/${c.slug}`} class="l2-related-item">
            <span class="l2-related-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d={c.icon}/></svg>
            </span>
            <span class="l2-related-body">
              <span class="l2-related-name">{c.nombre}</span>
              <span class="l2-related-norm">{c.badge}</span>
            </span>
            <svg class="l2-related-arrow" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Resalta la sección del índice que se está leyendo -->
  <script is:inline>
    (() => {
      const enlaces = Array.from(document.querySelectorAll('.l3-toc a'));
      if (!enlaces.length || !('IntersectionObserver' in window)) return;
      const porId = new Map(enlaces.map((a) => [a.getAttribute('href').slice(1), a]));
      const obs = new IntersectionObserver((entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          enlaces.forEach((a) => a.classList.remove('is-active'));
          porId.get(e.target.id)?.classList.add('is-active');
        }
      }, { rootMargin: '-110px 0px -70% 0px', threshold: 0 });
      porId.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) obs.observe(el);
      });
    })();
  </script>

</BaseLayout>
