---
/**
 * L2 — Página de categoría de producto
 * Homologada con el diseño del index: colores sólidos, patrón de card universal,
 * alternancia de fondo #ffffff / #f8fafc, bloques oscuros #09090b.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CondicionesStrip from '../../components/empresa/CondicionesStrip.astro';
import { CONTACTO } from '../../data/marca';
import categorias from '../../data/productos.json';
import { girosDeCategoria, claveRiesgo, PANORAMA } from '../../lib/cumplimiento';

export function getStaticPaths() {
  return categorias.map((cat) => ({
    params: { categoria: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;

const SITE = 'https://firefighter.com.mx';
const waBase = 'https://wa.me/525500000000';
const wa = (t: string) => `${waBase}?text=${encodeURIComponent(`Hola, necesito cotizar ${t}`)}`;

const url = `${SITE}/productos/${cat.slug}`;
const tieneFaqs = Array.isArray(cat.faqs) && cat.faqs.length > 0;
const otras = categorias.filter((c) => c.slug !== cat.slug);
/* Guías de /cumplimiento que apuntan a esta categoría. Es el puente del catálogo
   hacia la sección normativa: sin él, /cumplimiento no recibe enlaces entrantes
   desde donde está el tráfico comercial. */
const girosLigados = girosDeCategoria(cat.slug);
const tieneDetalle = cat.productos?.some((p: any) => p.desc);

// L3: si la categoría está habilitada, las cards y los módulos apuntan a la ficha del producto.
const fichaHref = (p: any) => ((cat as any).l3ok && p.slug && p.intro ? `/productos/${cat.slug}/${p.slug}` : null);

// L4: configuraciones de marca con página propia. Se listan en el módulo del producto para que
// la L2 —que es la página más fuerte de la línea— les pase enlace directo y no solo a la L3.
const configsL4 = (p: any) =>
  ((p.l3?.catalogo?.cards ?? []) as any[])
    .filter((c) => c.slug && c.l4)
    .map((c) => ({
      href: `/productos/${cat.slug}/${p.slug}/${c.slug}`,
      etiqueta: `${c.modelo} · ${c.variante}`,
      marca: c.marca,
    }));

// ── Schema.org ──
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: cat.nombre,
  description: cat.descripcion,
  url,
  numberOfItems: cat.productos.length,
  itemListElement: cat.productos.map((p: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.nombre,
      description: p.desc || cat.descripcion,
      category: cat.nombre,
      ...(p.img ? { image: `${SITE}${p.img}` } : {}),
      ...(fichaHref(p) ? { url: `${SITE}${fichaHref(p)}` } : p.slug ? { url: `${url}#${p.slug}` } : {}),
      brand: { '@type': 'Brand', name: cat.marcas?.[0] ?? 'FIREFIGHTER.COM.MX' },
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        priceCurrency: 'MXN',
        seller: { '@type': 'Organization', name: 'FIREFIGHTER.COM.MX' },
        url,
      },
    },
  })),
};

const faqSchema = tieneFaqs
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: cat.faqs.map((f: any) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<BaseLayout
  title={cat.seoTitle}
  description={cat.seoDescription}
  canonicalUrl={url}
  image={cat.imagenes.hero.src}
  imageAlt={cat.imagenes.hero.alt}
  breadcrumbs={[
    { label: 'Catálogo de Productos', href: '/productos' },
    { label: cat.nombre },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <!-- ══════════ 1 · HERO DE CATEGORÍA ══════════ -->
  <section style="background:#09090b; padding:56px 0 72px;">
    <div class="container-custom">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start;">

        <!-- Columna izquierda: identidad de la categoría -->
        <div style="padding-right:0;" class="lg:pr-14 lg:border-r lg:border-[#1f1f23]">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
            <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">{cat.eyebrow}</span>
          </div>

          <span style="display:inline-block; background:#dc2626; color:#fff; font-size:0.62rem; font-weight:800; letter-spacing:0.07em; padding:4px 11px; border-radius:4px; text-transform:uppercase; margin-bottom:18px;">{cat.badge}</span>

          <h1 style="font-size:clamp(1.9rem,3.4vw,3rem); font-weight:800; color:#fafafa; line-height:1.08; margin:0 0 18px; letter-spacing:-0.02em;">{cat.h1}</h1>

          <p style="font-size:1rem; color:#a1a1aa; line-height:1.8; margin:0 0 30px;">{cat.subtitulo}</p>

          <div style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:26px;">
            <a href={wa(cat.nombre)} target="_blank" rel="noopener" class="l2-cta">
              <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
              <span>Cotizar {cat.nombre}</span>
            </a>
            <a href="tel:5555555555" class="l2-cta-ghost">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>Hablar con un ingeniero</span>
            </a>
          </div>

          <div style="display:inline-flex; align-items:center; gap:8px; padding:9px 14px; border-radius:8px; background:#18181b; border:1px solid #27272a;">
            <svg width="13" height="13" fill="#dc2626" viewBox="0 0 20 20" aria-hidden="true"><use href="#i-check"/></svg>
            <span style="font-size:0.75rem; font-weight:600; color:#e4e4e7;">{cat.highlight}</span>
          </div>
        </div>

        <!-- Columna derecha: dos bloques de contexto -->
        <div style="display:flex; flex-direction:column; gap:30px;">
          {cat.heroBloques.map((b: any, i: number) => (
            <div style="position:relative;">
              <span style={`position:absolute; left:0; top:4px; bottom:4px; width:3px; border-radius:2px; background:${i === 0 ? '#dc2626' : '#3f3f46'};`} aria-hidden="true"></span>
              <div style="padding-left:22px;">
                <span style={`display:block; font-size:0.68rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:${i === 0 ? '#dc2626' : '#a1a1aa'}; margin-bottom:11px;`}>{b.label}</span>
                <p set:html={b.texto} style="font-size:0.94rem; color:#a1a1aa; line-height:1.85; margin:0;"></p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════ 1b · MENÚ EXTENDIDO (full-bleed) ══════════ -->
  <nav class="l2-nav" aria-label={`Secciones de ${cat.nombre}`}>
    <div class="l2-nav-grid">
      {[
        { href: '#componentes',   label: 'Componentes',   sub: `${cat.productos.length} productos` },
        { href: '#la-linea',      label: 'La línea',      sub: 'Qué cubre' },
        { href: '#normas',        label: 'Normas',        sub: 'Cumplimiento', show: cat.normas?.length > 0 },
        { href: '#sectores',      label: 'Aplica para',   sub: 'Sectores', show: cat.aplicaciones?.length > 0 },
        { href: '#documentacion', label: 'Documentación', sub: 'Licitaciones' },
        { href: '#preguntas',     label: 'Preguntas',     sub: 'Dudas frecuentes', show: tieneFaqs },
      ].filter((i) => i.show !== false).map((i) => (
        <a href={i.href} class="l2-nav-item">
          <span class="l2-nav-label">{i.label}</span>
          <span class="l2-nav-sub">{i.sub}</span>
        </a>
      ))}

      <a href={wa(cat.nombre)} target="_blank" rel="noopener" class="l2-nav-item is-cta">
        <span class="l2-nav-label">
          Cotizar ahora
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </span>
        <span class="l2-nav-sub">Respuesta en 24 h</span>
      </a>
    </div>
  </nav>

  <!-- ══════════ 1c · COMPONENTES DE LA LÍNEA (cards) ══════════ -->
  <section id="componentes" class="l2-anchor" style="background:#ffffff; padding:88px 0; border-bottom:1px solid #e4e4e7;">
    <div class="container-custom">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16" style="align-items:center; margin-bottom:48px;">
        <div>
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
            <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Equipo incluido</span>
          </div>
          <h2 style="font-size:clamp(1.9rem,2.8vw,2.7rem); font-weight:800; color:#09090b; line-height:1.1; margin:0; letter-spacing:-0.02em;">
            Componentes de<br>la línea
          </h2>
        </div>
        <div>
          <span style="font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#09090b; margin-bottom:10px; display:block;">Cotización por pieza o por paquete</span>
          <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0;">
            Puedes cotizar un componente suelto o el <strong style="color:#09090b; font-weight:600;">paquete completo por elemento o por brigada</strong>. Dimensionamos el pedido según el riesgo real de tu operación, no según un catálogo genérico.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {cat.productos.map((p: any) => (
          <article class="cg-card">
            <div class="cg-media" style={`background-image:url('${p.img}');`} role="img" aria-label={p.alt}>
              <span class="cg-veil" aria-hidden="true"></span>
              <span class="cg-badge">{p.norma}</span>
              <span class="cg-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d={cat.icon}/></svg>
              </span>
            </div>

            <div class="cg-body">
              <h3 class="cg-title">{p.nombre}</h3>
              {p.desc && <p class="cg-desc">{p.desc}</p>}

              {p.specs?.length > 0 && (
                <>
                  <div class="cg-sep"><span>Especificaciones</span><i></i></div>
                  <ul class="cg-specs">
                    {p.specs.map((sp: string) => (
                      <li>
                        <svg width="12" height="12" fill="#dc2626" viewBox="0 0 20 20" aria-hidden="true"><use href="#i-check"/></svg>
                        <span>{sp}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )}

              <a href={fichaHref(p) ?? (p.intro ? `#${p.slug}` : wa(p.nombre))} target={fichaHref(p) || p.intro ? undefined : '_blank'} rel={fichaHref(p) || p.intro ? undefined : 'noopener'} class="cg-cta">
                <span>{fichaHref(p) || p.intro ? `Ver ${p.nombre}` : `Cotizar ${p.nombre}`}</span>
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ 1d · MÓDULO POR PRODUCTO ══════════ -->
  {cat.productos.filter((p: any) => p.intro).map((p: any, i: number) => (
    <section id={p.slug} class="l2-anchor" style={`background:${i % 2 === 0 ? '#f8fafc' : '#ffffff'}; padding:88px 0; border-top:1px solid #e4e4e7;`}>
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start;">

          <!-- Columna 1 — información -->
          <div>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
              <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
              <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">{p.eyebrow}</span>
            </div>

            <span style="display:inline-block; background:#dc2626; color:#fff; font-size:0.62rem; font-weight:800; letter-spacing:0.06em; padding:4px 10px; border-radius:4px; text-transform:uppercase; margin-bottom:16px;">{p.norma}</span>

            <h2 style="font-size:clamp(1.7rem,2.5vw,2.4rem); font-weight:800; color:#09090b; line-height:1.12; margin:0 0 18px; letter-spacing:-0.02em;">{p.nombre}</h2>

            <div style="margin:0 0 30px;">
              {p.intro.map((par: string, k: number) => (
                <p set:html={par} style={`font-size:0.95rem; color:#52525b; line-height:1.85; width:100%; margin:${k === 0 ? '0' : '16px 0 0'};`}></p>
              ))}
            </div>

            <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
              <span style="font-size:0.62rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#a1a1aa;">Especificaciones</span>
              <div style="flex:1; height:1px; background:#e4e4e7;"></div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" style="margin-bottom:30px;">
              {p.specs.map((sp: string) => (
                <span style="display:flex; align-items:center; gap:8px; font-size:0.78rem; color:#3f3f46; background:#fff; border:1px solid #e4e4e7; padding:9px 12px; border-radius:7px;">
                  <svg width="12" height="12" fill="#dc2626" viewBox="0 0 20 20" style="flex-shrink:0;" aria-hidden="true"><use href="#i-check"/></svg>
                  <span>{sp}</span>
                </span>
              ))}
            </div>

            {configsL4(p).length > 0 && (
              <div style="margin:0 0 26px;">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                  <span style="font-size:0.62rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#a1a1aa;">Configuraciones con ficha</span>
                  <div style="flex:1; height:1px; background:#e4e4e7;"></div>
                </div>
                <div style="display:flex; flex-wrap:wrap; gap:7px;">
                  {configsL4(p).map((c: any) => (
                    <a href={c.href} class="l2-config-chip">
                      <span class="marca">{c.marca}</span>
                      <span>{c.etiqueta}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}

            <div style="display:flex; flex-wrap:wrap; gap:10px;">
              {fichaHref(p) ? (
                <a href={fichaHref(p)} class="cs-cta">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  <span>Ver ficha completa</span>
                </a>
              ) : (
                <a href={wa(p.nombre)} target="_blank" rel="noopener" class="cs-cta">
                  <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
                  <span>Cotizar {p.nombre}</span>
                </a>
              )}
              <a href={wa(p.nombre)} target="_blank" rel="noopener" class="cs-cta-ghost">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
                <span>Cotizar por WhatsApp</span>
              </a>
            </div>
          </div>

          <!-- Columna 2 — galería -->
          <div style="display:flex; flex-direction:column; gap:12px;">
            <figure class="cs-shot cs-shot-big">
              <img src={p.galeria[0].src} alt={p.galeria[0].alt} width="800" height="600" loading="lazy" decoding="async" />
              <figcaption>{p.galeria[0].caption}</figcaption>
              <span class="cs-shot-badge">{p.norma}</span>
            </figure>
            <div class="grid grid-cols-2 gap-3">
              {p.galeria.slice(1).map((im: any) => (
                <figure class="cs-shot cs-shot-sm">
                  <img src={im.src} alt={im.alt} width="400" height="300" loading="lazy" decoding="async" />
                  <figcaption>{im.caption}</figcaption>
                </figure>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>
  ))}

  <!-- ══════════ 2 · INTRO + GALERÍA ══════════ -->
  <section id="la-linea" class="l2-anchor" style="background:#ffffff; padding:96px 0; border-top:1px solid #e4e4e7;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start;">

        <div>
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
            <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">La línea</span>
          </div>
          <h2 style="font-size:clamp(1.7rem,2.4vw,2.3rem); font-weight:800; color:#09090b; line-height:1.15; margin:0 0 20px; letter-spacing:-0.02em;">
            Qué cubre {cat.nombre}
          </h2>
          {cat.intro.map((p: string, i: number) => (
            <p set:html={p} style={`font-size:0.95rem; color:#52525b; line-height:1.85; width:100%; margin:${i === 0 ? '0' : '16px 0 0'};`}></p>
          ))}

          <!-- Marcas -->
          {cat.marcas?.length > 0 && (
            <div style="margin-top:32px; padding-top:26px; border-top:1px solid #e4e4e7;">
              <span style="display:block; font-size:0.62rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#a1a1aa; margin-bottom:12px;">Marcas que distribuimos</span>
              <div style="display:flex; flex-wrap:wrap; gap:7px;">
                {cat.marcas.map((m: string) => (
                  <span style="font-size:0.75rem; font-weight:600; color:#3f3f46; background:#f4f4f5; border:1px solid #e4e4e7; padding:7px 14px; border-radius:99px;">{m}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Galería 1 grande + 2 chicas -->
        <div style="display:flex; flex-direction:column; gap:12px;">
          <figure class="cs-shot cs-shot-big">
            <img src={cat.imagenes.a.src} alt={cat.imagenes.a.alt} width="800" height="600" loading="lazy" decoding="async" />
            {cat.imagenes.a.caption && <figcaption>{cat.imagenes.a.caption}</figcaption>}
            <span class="cs-shot-badge">{cat.badge}</span>
          </figure>
          <div class="grid grid-cols-2 gap-3">
            {[cat.imagenes.b, cat.imagenes.c].filter(Boolean).map((im: any) => (
              <figure class="cs-shot cs-shot-sm">
                <img src={im.src} alt={im.alt} width="400" height="300" loading="lazy" decoding="async" />
                {im.caption && <figcaption>{im.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════ 4 · NORMAS Y CERTIFICACIONES ══════════ -->
  {cat.normas?.length > 0 && (
    <section id="normas" class="l2-anchor" style="background:#ffffff; padding:96px 0; border-top:1px solid #e4e4e7;">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16" style="align-items:start;">

          <div>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
              <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
              <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Cumplimiento</span>
            </div>
            <h2 style="font-size:clamp(1.9rem,2.8vw,2.7rem); font-weight:800; color:#09090b; line-height:1.1; margin:0 0 20px; letter-spacing:-0.02em;">
              Normas que<br>debe cumplir
            </h2>
            <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0;">
              Un equipo sin certificación vigente no pasa una verificación y no protege. Estas son las normas que aplican a esta línea y que respaldan cada pieza que entregamos.
            </p>
          </div>

          <div>
            {cat.normas.map((n: any) => (
              <div class="l2-norm">
                <span style="flex-shrink:0; display:inline-block; background:#09090b; color:#fff; font-size:0.62rem; font-weight:800; letter-spacing:0.05em; padding:6px 11px; border-radius:5px; height:fit-content; min-width:112px; text-align:center;">{n.code}</span>
                <p style="font-size:0.86rem; color:#52525b; line-height:1.75; margin:0;">{n.desc}</p>
              </div>
            ))}
          </div>

        </div>

        <!-- ── Puente al centro de cumplimiento ── -->
        <div style="margin-top:52px; padding-top:44px; border-top:1px solid #e4e4e7;">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16" style="align-items:start;">
            <div>
              <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
                <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
                <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Antes de cotizar</span>
              </div>
              <h2 style="font-size:clamp(1.5rem,2.2vw,2rem); font-weight:800; color:#09090b; line-height:1.15; margin:0 0 16px; letter-spacing:-0.02em;">
                Qué cantidad te exige<br>la ley, y por qué
              </h2>
              <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0 0 14px;">
                La certificación del equipo resuelve la mitad del problema. La otra mitad es <strong style="color:#09090b; font-weight:600;">cuánto</strong> te exige tener la autoridad, y eso no lo decide la marca: lo decide la clasificación de riesgo de incendio de tu centro de trabajo conforme a la <a href="/cumplimiento/normas/nom-002-stps-2010" style="color:#dc2626; font-weight:600; text-decoration:none;">NOM-002-STPS-2010</a>, más lo que exija la ley de protección civil de tu estado.
              </p>
              <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0;">
                Es el error más caro que vemos: empresas que compran equipo de sobra en una línea mientras siguen descubiertas en otra que sí les aplicaba.
              </p>
            </div>
            <div>
              <div class="cmp-cross">
                <a href="/cumplimiento" class="cmp-cx">
                  <span class="cmp-cx-k">HUB</span>
                  <span style="min-width:0;">
                    <span class="cmp-cx-n">Centro de cumplimiento</span>
                    <span class="cmp-cx-s">Las cuatro capas de normativa, con su fuente oficial</span>
                  </span>
                  <span class="cmp-cx-m">Ver</span>
                </a>
                <a href="/cumplimiento/normas/nom-002-stps-2010#clasificacion" class="cmp-cx">
                  <span class="cmp-cx-k">NOM</span>
                  <span style="min-width:0;">
                    <span class="cmp-cx-n">Riesgo ordinario o alto</span>
                    <span class="cmp-cx-s">El estudio del que depende todo lo demás</span>
                  </span>
                  <span class="cmp-cx-m">Ver</span>
                </a>
                <a href="/cumplimiento#estados" class="cmp-cx">
                  <span class="cmp-cx-k">EDO</span>
                  <span style="min-width:0;">
                    <span class="cmp-cx-n">Lo que exige tu estado</span>
                    <span class="cmp-cx-s">{PANORAMA.total} entidades, con ley, vigencia y simulacros</span>
                  </span>
                  <span class="cmp-cx-m">Ver</span>
                </a>
                {girosLigados.map(g => (
                  <a href={`/cumplimiento/giro/${g.slug}`} class="cmp-cx">
                    <span class={`cmp-cx-k is-${g.riesgoNom}`}>{claveRiesgo(g.riesgoNom)}</span>
                    <span style="min-width:0;">
                      <span class="cmp-cx-n">{g.nombreCorto}</span>
                      <span class="cmp-cx-s">Qué exige la ley a este giro</span>
                    </span>
                    <span class="cmp-cx-m">Guía</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ══════════ 5 · APLICA PARA ══════════ -->
  {cat.aplicaciones?.length > 0 && (
    <section id="sectores" class="l2-anchor" style="background:#f8fafc; padding:96px 0; border-top:1px solid #e4e4e7;">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16" style="align-items:center; margin-bottom:48px;">
          <div>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
              <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
              <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Aplica para</span>
            </div>
            <h2 style="font-size:clamp(1.9rem,2.8vw,2.7rem); font-weight:800; color:#09090b; line-height:1.1; margin:0; letter-spacing:-0.02em;">
              Quién usa<br>esta línea
            </h2>
          </div>
          <div>
            <span style="font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#09090b; margin-bottom:10px; display:block;">Cada sector pide algo distinto</span>
            <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0;">
              No es lo mismo equipar un cuerpo municipal que una brigada de planta. Ajustamos especificación, volumen y documentación al <strong style="color:#09090b; font-weight:600;">marco normativo que le aplica a cada cliente</strong>.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {cat.aplicaciones.map((a: any) => (
            <div class="l2-sector">
              <div style="display:flex; align-items:center; gap:9px; margin-bottom:14px;">
                <span style="display:block; width:18px; height:2px; background:#dc2626; border-radius:2px;"></span>
                <h3 style="font-size:0.98rem; font-weight:700; color:#09090b; margin:0; line-height:1.3;">{a.sector}</h3>
              </div>
              <p style="font-size:0.83rem; color:#52525b; line-height:1.8; margin:0;">{a.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════ 6 · DOCUMENTACIÓN (bloque oscuro) ══════════ -->
  <section id="documentacion" class="l2-anchor" style="background:#09090b; padding:88px 0;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:center;">

        <div>
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
            <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Documentación</span>
          </div>
          <h2 style="font-size:clamp(1.7rem,2.4vw,2.3rem); font-weight:800; color:#fafafa; line-height:1.12; margin:0 0 18px; letter-spacing:-0.02em;">
            Todo lo que pide una licitación, incluido
          </h2>
          <p style="font-size:0.92rem; color:#a1a1aa; line-height:1.85; margin:0 0 28px; max-width:52ch;">
            La mayoría de los procesos no se pierden por precio, se pierden por un documento faltante. Cada envío sale con el expediente completo y sin costo adicional.
          </p>
          <a href={`mailto:${CONTACTO.emailLicitaciones}`} class="l2-cta">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>Escribir a licitaciones</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {cat.documentacion.map((d: string) => (
            <div style="display:flex; align-items:flex-start; gap:10px; background:#141417; border:1px solid #27272a; border-radius:10px; padding:15px 16px;">
              <svg width="14" height="14" fill="#dc2626" viewBox="0 0 20 20" style="flex-shrink:0; margin-top:2px;" aria-hidden="true"><use href="#i-check"/></svg>
              <span style="font-size:0.82rem; color:#e4e4e7; font-weight:500; line-height:1.5;">{d}</span>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════ 7 · FAQ ══════════ -->
  <!-- ══════════ 7 · FAQ + FORMULARIO A WHATSAPP ══════════ -->
  {tieneFaqs && (
    <section id="preguntas" class="l2-anchor" style="background:#ffffff; padding:96px 0; border-top:1px solid #e4e4e7;">
      <div class="container-custom">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16" style="align-items:center; margin-bottom:52px;">
          <div>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
              <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
              <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Preguntas frecuentes</span>
            </div>
            <h2 style="font-size:clamp(1.9rem,2.8vw,2.7rem); font-weight:800; color:#09090b; line-height:1.1; margin:0; letter-spacing:-0.02em;">
              Dudas sobre<br>{cat.nombre}
            </h2>
          </div>
          <div>
            <span style="font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#09090b; margin-bottom:10px; display:block;">Responde un ingeniero, no un vendedor</span>
            <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0;">
              Las {cat.faqs.length} preguntas que más nos llegan sobre esta línea, contestadas con el criterio técnico que aplicaríamos en tu proyecto. Si tu caso no está aquí, el formulario arma el mensaje por ti y te contesta un <strong style="color:#09090b; font-weight:600;">ingeniero certificado en NFPA y NOM-002-STPS</strong>.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start;">

          <!-- Columna 1 — acordeón -->
          <div>
            {cat.faqs.map((f: any, i: number) => (
              <details class="l2-faq" open={i === 0}>
                <summary>
                  <span>{f.q}</span>
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                </summary>
                <div class="l2-faq-body">{f.a}</div>
              </details>
            ))}
          </div>

          <!-- Columna 2 — formulario -->
          <div class="l2-form">
            <div class="l2-form-head">
              <span class="l2-form-eyebrow">Cotización sin compromiso</span>
              <h3 class="l2-form-title">Cuéntanos qué necesitas</h3>
              <p class="l2-form-sub">
                Completa los campos y el botón abre WhatsApp con tu solicitud ya redactada.
                Respondemos con propuesta técnica en menos de <strong>24 horas hábiles</strong>.
              </p>
            </div>

            <form id="faq-form" class="l2-form-body" novalidate>
              <div class="l2-field">
                <label for="ff-nombre">Nombre y cargo <span aria-hidden="true">*</span></label>
                <input id="ff-nombre" name="nombre" type="text" required autocomplete="name" placeholder="Ing. Roberto Garza · Jefe de Seguridad" />
              </div>

              <div class="l2-field">
                <label for="ff-org">Institución o empresa <span aria-hidden="true">*</span></label>
                <input id="ff-org" name="org" type="text" required autocomplete="organization" placeholder="H. Cuerpo de Bomberos de Monterrey" />
              </div>

              <div class="l2-grid-2">
                <div class="l2-field">
                  <label for="ff-tipo">Tipo de cliente</label>
                  <select id="ff-tipo" name="tipo">
                    <option>Cuerpo de bomberos</option>
                    <option>Brigada industrial</option>
                    <option>Protección civil</option>
                    <option>Gobierno · licitación</option>
                    <option>Empresa privada</option>
                    <option>Otro</option>
                  </select>
                </div>
                <div class="l2-field">
                  <label for="ff-vol">Elementos a equipar</label>
                  <select id="ff-vol" name="volumen">
                    <option>1 a 5</option>
                    <option>6 a 20</option>
                    <option>21 a 50</option>
                    <option>Más de 50</option>
                    <option>Por definir</option>
                  </select>
                </div>
              </div>

              <div class="l2-grid-2">
                <div class="l2-field">
                  <label for="ff-ciudad">Ciudad y estado</label>
                  <input id="ff-ciudad" name="ciudad" type="text" autocomplete="address-level2" placeholder="Monterrey, Nuevo León" />
                </div>
                <div class="l2-field">
                  <label for="ff-contacto">Teléfono o correo <span aria-hidden="true">*</span></label>
                  <input id="ff-contacto" name="contacto" type="text" required autocomplete="email" placeholder="55 1234 5678" />
                </div>
              </div>

              <div class="l2-field">
                <label for="ff-msg">¿Qué equipo necesitas?</label>
                <textarea id="ff-msg" name="mensaje" rows="3" placeholder="Ej. 25 ensambles estructurales completos con casco y botas, entrega antes de diciembre."></textarea>
              </div>

              <label class="l2-check">
                <input id="ff-lic" name="licitacion" type="checkbox" />
                <span>Requiero documentación para licitación pública</span>
              </label>

              <button type="submit" class="l2-form-cta">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
                <span>Enviar por WhatsApp</span>
              </button>

              <p class="l2-form-legal">
                Al enviar se abre WhatsApp con el mensaje redactado; tú decides si lo mandas.
                No almacenamos tus datos en este sitio. Consulta el <a href="/privacidad">aviso de privacidad</a>.
              </p>
            </form>

            <div class="l2-form-foot">
              <a href="tel:5555555555">
                <span>Ventas directas</span>
                <strong>55 5555 5555</strong>
              </a>
              <a href={`mailto:${CONTACTO.emailLicitaciones}`}>
                <span>Licitaciones</span>
                <strong>licitaciones@firefighter.com.mx</strong>
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- define:vars NO funciona con is:inline: los valores viajan en data-* -->
      <span id="faq-form-data" data-wa="525500000000" data-cat={cat.nombre} hidden></span>

      <script is:inline>
        (() => {
          const form = document.getElementById('faq-form');
          const data = document.getElementById('faq-form-data');
          if (!form || !data) return;

          const WA = data.dataset.wa;
          const CATEGORIA = data.dataset.cat;
          const val = (id) => (document.getElementById(id)?.value || '').trim();

          form.addEventListener('submit', (e) => {
            e.preventDefault();

            let ok = true;
            ['ff-nombre', 'ff-org', 'ff-contacto'].forEach((id) => {
              const el = document.getElementById(id);
              const campo = el?.closest('.l2-field');
              const vacio = !el || !el.value.trim();
              campo?.classList.toggle('has-error', vacio);
              if (vacio && ok) { el?.focus(); ok = false; }
            });
            if (!ok) return;

            const lic = document.getElementById('ff-lic')?.checked;
            const msg = val('ff-msg');

            const lineas = [
              'Hola FIREFIGHTER.COM.MX, solicito cotizacion de ' + CATEGORIA + '.',
              '',
              'Nombre: ' + val('ff-nombre'),
              'Institucion: ' + val('ff-org'),
              'Tipo de cliente: ' + val('ff-tipo'),
              'Elementos a equipar: ' + val('ff-vol'),
            ];
            if (val('ff-ciudad')) lineas.push('Ubicacion: ' + val('ff-ciudad'));
            lineas.push('Contacto: ' + val('ff-contacto'));
            if (msg) lineas.push('', 'Requerimiento: ' + msg);
            if (lic) lineas.push('', 'Requiero documentacion para licitacion publica.');

            window.open('https://wa.me/' + WA + '?text=' + encodeURIComponent(lineas.join('\n')), '_blank', 'noopener');
          });

          form.querySelectorAll('input, select, textarea').forEach((el) => {
            el.addEventListener('input', () => el.closest('.l2-field')?.classList.remove('has-error'));
          });
        })();
      </script>
    </section>
  )}

  <!-- ══════════ 7b · CONDICIONES COMERCIALES ══════════ -->
  <CondicionesStrip fondo="#f8fafc" />

  <!-- ══════════ 8 · CATÁLOGO RELACIONADO (interlinking) ══════════ -->
  <section style="background:#09090b; padding:64px 0;">
    <div class="container-custom">
      <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
        <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
        <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Seguir explorando</span>
      </div>
      <div class="l2-related-head">
        <h2 style="font-size:clamp(1.4rem,2vw,1.9rem); font-weight:800; color:#fafafa; line-height:1.2; margin:0; letter-spacing:-0.02em;">
          Las otras {otras.length} líneas del catálogo
        </h2>
        <a href="/productos" class="l2-related-all">
          <span>Ver catálogo completo</span>
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>

      <div class="l2-related">
        {otras.map((c) => (
          <a href={`/productos/${c.slug}`} class="l2-related-item">
            <span class="l2-related-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d={c.icon}/></svg>
            </span>
            <span class="l2-related-body">
              <span class="l2-related-name">{c.nombre}</span>
              <span class="l2-related-norm">{c.badge}</span>
            </span>
            <svg class="l2-related-arrow" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
