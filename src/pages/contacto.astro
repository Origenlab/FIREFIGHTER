---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import { waLink } from '../lib/blog';
import CondicionesComerciales from '../components/empresa/CondicionesComerciales.astro';
import { MARCA, SITE, CONTACTO } from '../data/marca';

const canales = [
  {
    eyebrow: 'Lo más rápido',
    titulo: 'Cotización por WhatsApp',
    texto: 'Mándanos qué necesitas —aunque sea una foto del equipo o el anexo técnico de la convocatoria— y te contesta quien arma las propuestas. Sin formularios de por medio.',
    accion: 'Abrir WhatsApp',
    href: waLink('necesito una cotización'),
    externo: true,
    destacado: true,
  },
  {
    eyebrow: 'Compra pública',
    titulo: 'Licitaciones y CompraNet',
    texto: 'Carta de distribuidor autorizado, certificados de laboratorio, fichas técnicas y propuesta desglosada por partida con clave CABMS. Escríbenos con la convocatoria.',
    accion: CONTACTO.emailLicitaciones,
    href: `mailto:${CONTACTO.emailLicitaciones}`,
    externo: false,
    destacado: false,
  },
  {
    eyebrow: 'Ventas',
    titulo: 'Correo comercial',
    texto: 'Para pedidos, seguimiento de una propuesta en curso o programar mantenimiento, recarga y pruebas del equipo que ya tienes en servicio.',
    accion: CONTACTO.emailVentas,
    href: `mailto:${CONTACTO.emailVentas}`,
    externo: false,
    destacado: false,
  },
  {
    eyebrow: 'Directorio',
    titulo: 'Correcciones del directorio',
    texto: 'Si una estación cambió de domicilio o teléfono, o falta alguna, dinos. El directorio es gratuito y se mantiene con avisos como el tuyo.',
    accion: 'Sugerir una estación',
    href: '/agregar-estacion',
    externo: false,
    destacado: false,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contacto — ${MARCA}`,
  url: `${SITE}/contacto`,
  inLanguage: 'es-MX',
  mainEntity: {
    '@type': 'Organization',
    '@id': `${SITE}/#organization`,
    name: MARCA,
    url: SITE,
    contactPoint: [
      { '@type': 'ContactPoint', contactType: 'sales', telephone: `+52${CONTACTO.telefonoVentas.replace(/\D/g, '')}`, email: CONTACTO.emailVentas, areaServed: 'MX', availableLanguage: 'es' },
      { '@type': 'ContactPoint', contactType: 'bidding', email: CONTACTO.emailLicitaciones, areaServed: 'MX', availableLanguage: 'es' },
      { '@type': 'ContactPoint', contactType: 'customer support', email: CONTACTO.emailSoporte, areaServed: 'MX', availableLanguage: 'es' },
    ],
    openingHoursSpecification: CONTACTO.horarioSchema.map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.dias,
      opens: h.abre,
      closes: h.cierra,
    })),
  },
};
---

<BaseLayout
  title="Contacto: cotizaciones y licitaciones"
  description="Cotiza equipo contra incendios y para bomberos, solicita documentación para licitaciones o programa mantenimiento. Respuesta en menos de 24 horas hábiles."
  canonicalUrl={`${SITE}/contacto`}
  breadcrumbs={[{ label: 'Contacto' }]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <PageHero
    eyebrow="Hablemos"
    badge="Respuesta en 24 h hábiles"
    h1="Cuéntanos qué tienes<br>que resolver"
    lead="No hace falta que llegues con una lista de partidas. Con que nos digas qué operación tienes que cubrir y con cuánto cuentas, podemos empezar."
    bloques={[
      {
        label: 'Cómo respondemos',
        texto: 'Te contesta el área técnica, no un call center. Si tu caso no es lo nuestro te lo decimos y, cuando podemos, te orientamos hacia quién sí lo resuelve.',
      },
      {
        label: 'Esto no es una línea de emergencia',
        texto: 'Si hay un incendio o un accidente en curso, marca <strong style="color:#e4e4e7; font-weight:600;">911</strong>. Es gratuito, opera las 24 horas y coordina bomberos, ambulancia y protección civil.',
      },
    ]}
  >
    <div slot="ctas" style="display:flex; flex-wrap:wrap; gap:10px;">
      <a href={waLink('necesito una cotización')} target="_blank" rel="noopener" class="l2-cta">
        <span>Cotizar por WhatsApp</span>
      </a>
      <a href="#formulario" class="l2-cta-ghost">
        <span>Escribir un mensaje</span>
      </a>
    </div>
  </PageHero>

  <!-- ══ CANALES ══ -->
  <section style="background:#fff; padding:64px 0; border-bottom:1px solid #e4e4e7;">
    <div class="container-custom">
      <div style="display:flex; align-items:center; gap:10px; margin-bottom:28px;">
        <span style="display:block; width:24px; height:2px; background:#dc2626; border-radius:2px;"></span>
        <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Elige por dónde</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {canales.map(c => (
          <div style={`background:${c.destacado ? '#09090b' : '#fff'}; border:1px solid ${c.destacado ? '#1f1f23' : '#e4e4e7'}; border-radius:14px; padding:26px; display:flex; flex-direction:column;`}>
            <span style="font-size:0.63rem; font-weight:800; letter-spacing:0.12em; text-transform:uppercase; color:#dc2626; margin-bottom:12px;">{c.eyebrow}</span>
            <h2 style={`font-size:1.08rem; font-weight:800; margin:0 0 10px; line-height:1.3; color:${c.destacado ? '#fafafa' : '#09090b'};`}>{c.titulo}</h2>
            <p style={`font-size:0.85rem; line-height:1.8; margin:0 0 22px; flex:1; color:${c.destacado ? '#a1a1aa' : '#71717a'};`}>{c.texto}</p>
            <a
              href={c.href}
              target={c.externo ? '_blank' : undefined}
              rel={c.externo ? 'noopener' : undefined}
              style={`display:inline-flex; align-items:center; justify-content:space-between; gap:10px; font-size:0.82rem; font-weight:700; text-decoration:none; padding:11px 16px; border-radius:9px; ${c.destacado ? 'background:#25d366; color:#fff;' : 'background:#fef2f2; color:#b91c1c; border:1px solid #fecaca;'}`}
            >
              <span>{c.accion}</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ CONDICIONES COMERCIALES ══ -->
  <CondicionesComerciales fondo="#f8fafc" />

  <!-- ══ FORMULARIO ══ -->
  <section id="formulario" style="background:#fff; padding:72px 0; border-top:1px solid #e4e4e7;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-12" style="align-items:start;">

        <div style="background:#f8fafc; border:1px solid #e4e4e7; border-radius:16px; padding:32px;">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:18px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; border-radius:2px;"></span>
            <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Formulario</span>
          </div>
          <h2 style="font-size:1.5rem; font-weight:800; color:#09090b; margin:0 0 10px; letter-spacing:-0.02em;">Escríbenos con calma</h2>
          <p style="font-size:0.88rem; color:#52525b; line-height:1.8; margin:0 0 28px;">
            Entre más nos cuentes del contexto —tipo de operación, superficie, cuántas personas, si hay una convocatoria de por medio— más precisa sale la propuesta.
          </p>

          <form name="contact" method="POST" data-netlify="true" style="display:flex; flex-direction:column; gap:20px;">
            <input type="hidden" name="form-name" value="contact" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="nombre" style="display:block; font-size:0.78rem; font-weight:700; color:#3f3f46; margin-bottom:8px;">Nombre *</label>
                <input type="text" id="nombre" name="nombre" required style="width:100%; padding:11px 14px; border:1px solid #e4e4e7; border-radius:9px; font-size:0.88rem; color:#09090b; background:#fff;" />
              </div>
              <div>
                <label for="organizacion" style="display:block; font-size:0.78rem; font-weight:700; color:#3f3f46; margin-bottom:8px;">Institución o empresa</label>
                <input type="text" id="organizacion" name="organizacion" style="width:100%; padding:11px 14px; border:1px solid #e4e4e7; border-radius:9px; font-size:0.88rem; color:#09090b; background:#fff;" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="email" style="display:block; font-size:0.78rem; font-weight:700; color:#3f3f46; margin-bottom:8px;">Correo electrónico *</label>
                <input type="email" id="email" name="email" required style="width:100%; padding:11px 14px; border:1px solid #e4e4e7; border-radius:9px; font-size:0.88rem; color:#09090b; background:#fff;" />
              </div>
              <div>
                <label for="telefono" style="display:block; font-size:0.78rem; font-weight:700; color:#3f3f46; margin-bottom:8px;">Teléfono o WhatsApp</label>
                <input type="tel" id="telefono" name="telefono" style="width:100%; padding:11px 14px; border:1px solid #e4e4e7; border-radius:9px; font-size:0.88rem; color:#09090b; background:#fff;" />
              </div>
            </div>

            <div>
              <label for="asunto" style="display:block; font-size:0.78rem; font-weight:700; color:#3f3f46; margin-bottom:8px;">¿Qué necesitas? *</label>
              <select id="asunto" name="asunto" required style="width:100%; padding:11px 14px; border:1px solid #e4e4e7; border-radius:9px; font-size:0.88rem; color:#09090b; background:#fff;">
                <option value="">Selecciona una opción</option>
                <option value="cotizacion">Cotizar equipo</option>
                <option value="licitacion">Documentación para una licitación</option>
                <option value="mantenimiento">Mantenimiento, recarga o pruebas</option>
                <option value="capacitacion">Capacitación o instalación</option>
                <option value="asesoria">Asesoría para especificar</option>
                <option value="directorio">Corrección del directorio de estaciones</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div>
              <label for="mensaje" style="display:block; font-size:0.78rem; font-weight:700; color:#3f3f46; margin-bottom:8px;">Cuéntanos el contexto *</label>
              <textarea id="mensaje" name="mensaje" rows="6" required style="width:100%; padding:11px 14px; border:1px solid #e4e4e7; border-radius:9px; font-size:0.88rem; color:#09090b; background:#fff; resize:vertical;"></textarea>
            </div>

            <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
              <button type="submit" style="display:inline-flex; align-items:center; gap:9px; background:#dc2626; color:#fff; font-size:0.88rem; font-weight:700; padding:13px 22px; border:0; border-radius:9px; cursor:pointer;">
                Enviar mensaje
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </button>
              <span style="font-size:0.74rem; color:#a1a1aa;">* Campos obligatorios · Datos tratados según el <a href="/privacidad" style="color:#dc2626; font-weight:600;">aviso de privacidad</a></span>
            </div>
          </form>
        </div>

        <div style="display:flex; flex-direction:column; gap:20px;">
          <div style="background:#09090b; border-radius:16px; padding:26px;">
            <div style="display:flex; align-items:center; gap:8px; padding-bottom:14px; margin-bottom:16px; border-bottom:1px solid #27272a;">
              <span style="width:7px; height:7px; background:#22c55e; border-radius:50%; display:block;"></span>
              <span style="font-size:0.64rem; font-weight:800; letter-spacing:0.14em; text-transform:uppercase; color:#a1a1aa;">Horario de atención</span>
            </div>
            <div style="display:flex; flex-direction:column; gap:9px; margin-bottom:16px;">
              <div style="display:flex; justify-content:space-between; gap:12px; font-size:0.82rem;">
                <span style="color:#71717a;">Lunes a viernes</span><strong style="color:#fafafa; font-weight:600;">9:00 – 18:00 h</strong>
              </div>
              <div style="display:flex; justify-content:space-between; gap:12px; font-size:0.82rem;">
                <span style="color:#71717a;">Sábados</span><strong style="color:#fafafa; font-weight:600;">9:00 – 14:00 h</strong>
              </div>
              <div style="display:flex; justify-content:space-between; gap:12px; font-size:0.82rem; padding-top:9px; border-top:1px solid #27272a;">
                <span style="color:#71717a;">Domingos y festivos</span><strong style="color:#71717a; font-weight:600;">Cerrado</strong>
              </div>
              <div style="display:flex; justify-content:space-between; gap:12px; font-size:0.82rem;">
                <span style="color:#71717a;">Cotización</span><strong style="color:#fafafa; font-weight:600;">≤ 24 h hábiles</strong>
              </div>
              <div style="display:flex; justify-content:space-between; gap:12px; font-size:0.82rem;">
                <span style="color:#71717a;">Zona horaria</span><strong style="color:#fafafa; font-weight:600;">Centro de México</strong>
              </div>
            </div>
            <div style="display:flex; flex-direction:column; gap:7px; margin-bottom:18px; padding-top:14px; border-top:1px solid #27272a;">
              <a href={CONTACTO.telefonoVentasHref} style="font-size:0.82rem; color:#a1a1aa; text-decoration:none;">Ventas · {CONTACTO.telefonoVentas}</a>
              <a href={`mailto:${CONTACTO.emailVentas}`} style="font-size:0.82rem; color:#a1a1aa; text-decoration:none; word-break:break-all;">{CONTACTO.emailVentas}</a>
              <a href={`mailto:${CONTACTO.emailLicitaciones}`} style="font-size:0.82rem; color:#a1a1aa; text-decoration:none; word-break:break-all;">{CONTACTO.emailLicitaciones}</a>
            </div>
            <a href={waLink('tengo una duda')} target="_blank" rel="noopener" class="blog-btn-wa">Escribir por WhatsApp</a>
          </div>

          <div style="background:#fef2f2; border:1px solid #fecaca; border-radius:16px; padding:26px; text-align:center;">
            <p style="font-size:0.92rem; font-weight:800; color:#09090b; margin:0 0 8px;">¿Es una emergencia?</p>
            <p style="font-size:0.8rem; color:#52525b; line-height:1.75; margin:0 0 18px;">
              Este no es un servicio de emergencias. Marca 911 desde cualquier teléfono: es gratuito y opera las 24 horas.
            </p>
            <a href="tel:911" style="display:flex; align-items:center; justify-content:center; gap:9px; background:#dc2626; color:#fff; font-size:0.95rem; font-weight:800; padding:12px; border-radius:9px; text-decoration:none;">
              Llamar al 911
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
