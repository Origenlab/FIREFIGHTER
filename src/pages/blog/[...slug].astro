---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSidebar from '../../components/blog/BlogSidebar.astro';
import PostCard from '../../components/blog/PostCard.astro';
import categorias from '../../data/productos.json';
import { getCollection, render } from 'astro:content';
import { getTema, waLink, formatFecha, tiempoLectura, temaDePost } from '../../lib/blog';
import { getPosts, relacionados } from '../../lib/blogData';
import AutorBox from '../../components/blog/AutorBox.astro';
import { servicioDeTema } from '../../lib/servicios';
import { tituloSeo, descripcionSeo } from '../../lib/seoText';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const SITE = 'https://firefighter.com.mx';
const { post } = Astro.props;
const { Content, headings } = await render(post);

const posts = await getPosts();
const actual = posts.find(p => p.slug === post.id) ?? {
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDate: new Date(post.data.pubDate),
  updatedDate: post.data.updatedDate ? new Date(post.data.updatedDate) : undefined,
  author: post.data.author,
  tags: post.data.tags ?? [],
  tema: temaDePost(post.id, post.data.title, post.data.tags ?? []),
  minutos: tiempoLectura(post.body ?? ''),
};
const tema = getTema(actual.tema);
const minutos = actual.minutos;
const rel = relacionados(posts, actual, 4);

const categoria = tema.productoSlug
  ? (categorias as any[]).find(c => c.slug === tema.productoSlug)
  : null;

/**
 * Ficha de producto (L3) y sus configuraciones de marca (L4) ligadas a este artículo.
 *
 * El plugin `rehypeInterlink` ya enlaza términos del catálogo dentro del cuerpo, pero solo
 * puede enlazar lo que el texto menciona: ningún post nombra "SKÖLD HERÖ", así que las fichas
 * L4 nunca recibirían enlace desde el blog. Este bloque cierra ese circuito.
 *
 * Se muestra únicamente si el artículo es realmente de ese producto. La prueba es el
 * **sustantivo principal** del nombre del producto —"trajes" → raíz "traje"— buscado en el slug,
 * el título y los tags del post. Coincidir con una palabra secundaria no alcanza: "estructural"
 * aparece en artículos de guantes y de botas, y esos no deben empujar la ficha de trajes.
 */
const textoPost = `${post.id} ${post.data.title} ${(post.data.tags ?? []).join(' ')}`.toLowerCase();

/** Raíz del sustantivo principal, sin plural: "Trajes estructurales…" → "traje". */
const raizProducto = (nombre: string) =>
  String(nombre)
    .toLowerCase()
    .split(/[^a-záéíóúñ0-9]+/)
    .filter(Boolean)[0]
    ?.replace(/(es|s)$/, '') ?? '';

const fichaRelacionada = (() => {
  if (!categoria) return null;
  for (const p of (categoria.productos ?? []) as any[]) {
    if (!p.l3 || !p.slug) continue;
    const raiz = raizProducto(p.nombre);
    if (!raiz || !textoPost.includes(raiz)) continue;
    return {
      href: `/productos/${categoria.slug}/${p.slug}`,
      nombre: p.nombre,
      desc: p.desc ?? p.l3?.seoDescription,
      configs: ((p.l3?.catalogo?.cards ?? []) as any[])
        .filter((c) => c.slug && c.l4)
        .map((c) => ({
          href: `/productos/${categoria.slug}/${p.slug}/${c.slug}`,
          marca: c.marca,
          etiqueta: `${c.modelo} · ${c.variante}`,
        })),
    };
  }
  return null;
})();

const servicio = servicioDeTema(tema.slug);
const url = `${SITE}/blog/${post.id}`;
const encabezados = (headings ?? []).filter(h => h.depth === 2 || h.depth === 3);
// Indices largos: solo H2, para que el sidebar no se dispare de alto.
const toc = encabezados.length > 14 ? encabezados.filter(h => h.depth === 2) : encabezados;

const compartirWA = `https://wa.me/?text=${encodeURIComponent(`${post.data.title} — ${url}`)}`;
const compartirLI = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
const compartirFB = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---

<BaseLayout
  title={post.data.seoTitle ?? tituloSeo(post.data.title)}
  description={descripcionSeo(post.data.seoDescription ?? post.data.description)}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  type="article"
  canonicalUrl={url}
  article={{ author: post.data.author }}
  publishedDate={new Date(post.data.pubDate).toISOString()}
  modifiedDate={new Date(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  breadcrumbs={[
    { label: 'Blog', href: '/blog' },
    { label: tema.nombre, href: `/blog/tema/${tema.slug}` },
    { label: post.data.title },
  ]}
>
  <div class="art-progress" id="art-progress"></div>

  <section style="background:#f8fafc; padding:44px 0 88px;">
    <div class="container-custom">
      <div class="blog-shell">

        <!-- ══════════ ARTICULO ══════════ -->
        <div style="min-width:0;">
          <article>
            <header style="margin-bottom:26px;">
              <div style="display:flex; align-items:center; flex-wrap:wrap; gap:9px; margin-bottom:16px;">
                <a href={`/blog/tema/${tema.slug}`} class="blog-tema-badge" style="text-decoration:none;">{tema.nombre}</a>
                <span style="font-size:0.68rem; font-weight:700; letter-spacing:0.06em; color:#a1a1aa; text-transform:uppercase;">{tema.badge}</span>
              </div>

              <h1 style="font-size:clamp(1.75rem,3.1vw,2.5rem); font-weight:800; color:#09090b; line-height:1.14; letter-spacing:-0.025em; margin:0 0 16px;">
                {post.data.title}
              </h1>

              <p style="font-size:1.05rem; color:#52525b; line-height:1.8; margin:0 0 22px;">{post.data.description}</p>

              <div class="art-metarow">
                <span>
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  {post.data.author}
                </span>
                <span>
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  {formatFecha(post.data.updatedDate ?? post.data.pubDate)}
                  {post.data.updatedDate && <span style="color:#a1a1aa;">(actualizado)</span>}
                </span>
                <span>
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  {minutos} min de lectura
                </span>

                <span class="art-share">
                  <a href={compartirWA} target="_blank" rel="noopener" aria-label="Compartir en WhatsApp">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#i-wa"/></svg>
                  </a>
                  <a href={compartirLI} target="_blank" rel="noopener" aria-label="Compartir en LinkedIn">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  </a>
                  <a href={compartirFB} target="_blank" rel="noopener" aria-label="Compartir en Facebook">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 3.657 23.093 8.438 24v-8.437H5.898v-3.49h2.54V9.845c0-2.522 1.492-3.915 3.777-3.915 1.094 0 2.238.196 2.238.196v2.476h-1.26c-1.243 0-1.63.775-1.63 1.57v1.887h2.773l-.443 3.49h-2.33V24C20.343 23.093 24 18.1 24 12.073z"/></svg>
                  </a>
                </span>
              </div>
            </header>

            {post.data.image && (
              <img
                src={post.data.image}
                alt={post.data.imageAlt || post.data.title}
                style="width:100%; border-radius:14px; margin-bottom:26px;"
                loading="eager"
              />
            )}

            <div class="art-body">
              <div class="art-prose">
                <Content />
              </div>
            </div>

            <!-- CTA post-articulo -->
            <div class="art-cta">
              <div>
                <span style="display:inline-block; font-size:0.63rem; font-weight:800; letter-spacing:0.12em; text-transform:uppercase; color:#dc2626; margin-bottom:10px;">{servicio.eyebrow}</span>
                <h3>¿Te quedaste con una duda de tu caso?</h3>
                <p>
                  {servicio.promesa} Escríbenos con lo que tengas —una foto del equipo, el anexo técnico de la convocatoria o nada más la pregunta— y te contesta quien arma las propuestas, no un chatbot. Si no somos los indicados, te lo decimos.
                </p>
              </div>
              <div class="art-cta-actions">
                <a href={waLink(`leí "${post.data.title}" y quiero cotizar`)} target="_blank" rel="noopener" class="l2-cta">
                  <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
                  <span>Cotizar por WhatsApp</span>
                </a>
                <a href="/contacto" class="l2-cta-ghost"><span>Solicitud formal</span></a>
              </div>
            </div>

            <!-- Producto del catalogo ligado al tema -->
            {categoria && (
              <div style="margin-top:32px;">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
                  <span style="display:block; width:20px; height:2px; background:#dc2626; border-radius:2px;"></span>
                  <span style="font-size:0.66rem; font-weight:800; letter-spacing:0.12em; text-transform:uppercase; color:#dc2626;">Productos mencionados en esta guía</span>
                </div>
                <div style="display:grid; grid-template-columns:1fr; gap:12px;" class="sm:grid-cols-2">
                  {fichaRelacionada && (
                    <a href={fichaRelacionada.href} class="art-prod">
                      <span style="min-width:0;">
                        <span class="t" style="display:block;">{fichaRelacionada.nombre}</span>
                        <span class="d" style="display:block;">{fichaRelacionada.desc}</span>
                      </span>
                      <svg width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    </a>
                  )}
                  <a href={`/productos/${categoria.slug}`} class="art-prod">
                    <span style="min-width:0;">
                      <span class="t" style="display:block;">{categoria.nombre}</span>
                      <span class="d" style="display:block;">{categoria.cardDesc ?? categoria.descripcion}</span>
                    </span>
                    <svg width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </a>
                  <a href={`/blog/tema/${tema.slug}`} class="art-prod">
                    <span style="min-width:0;">
                      <span class="t" style="display:block;">Más guías de {tema.corto}</span>
                      <span class="d" style="display:block;">{tema.descripcion}</span>
                    </span>
                    <svg width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </a>
                </div>

                {fichaRelacionada && fichaRelacionada.configs.length > 0 && (
                  <div style="margin-top:16px;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:11px;">
                      <span style="font-size:0.62rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#a1a1aa;">Configuraciones con ficha técnica</span>
                      <div style="flex:1; height:1px; background:#e4e4e7;"></div>
                    </div>
                    <div style="display:flex; flex-wrap:wrap; gap:7px;">
                      {fichaRelacionada.configs.map((c: any) => (
                        <a href={c.href} class="l2-config-chip">
                          <span class="marca">{c.marca}</span>
                          <span>{c.etiqueta}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            )}

            <!-- Autoría -->
            <div style="margin-top:32px;">
              <AutorBox />
            </div>

            <!-- Relacionados -->
            {rel.length > 0 && (
              <div style="margin-top:44px; padding-top:36px; border-top:1px solid #e4e4e7;">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
                  <span style="display:block; width:24px; height:2px; background:#dc2626; border-radius:2px;"></span>
                  <span style="font-size:0.7rem; font-weight:800; letter-spacing:0.14em; text-transform:uppercase; color:#dc2626;">Sigue leyendo</span>
                </div>
                <div class="blog-grid">
                  {rel.map(p => <PostCard post={p} />)}
                </div>
              </div>
            )}
          </article>
        </div>

        <!-- ══════════ SIDEBAR ══════════ -->
        <div class="blog-side-col" style="min-width:0;">
          <div class="blog-toc-wrap">
            {toc.length > 2 && (
              <div class="blog-box">
                <div class="blog-box-head">
                  <span class="bar"></span>
                  <span class="txt">Contenido de la guía</span>
                </div>
                <nav class="art-toc" aria-label="Índice del artículo">
                  {toc.map(h => (
                    <a href={`#${h.slug}`} class={h.depth === 3 ? 'lvl-3' : ''}>{h.text}</a>
                  ))}
                </nav>
              </div>
            )}
          </div>
          <BlogSidebar posts={posts} temaActivo={tema.slug} slugActual={post.id} temaProducto={tema.slug} />
        </div>

      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var barra = document.getElementById('art-progress');
      var cuerpo = document.querySelector('.art-body');
      if (!barra || !cuerpo) return;

      function actualizar() {
        var caja = cuerpo.getBoundingClientRect();
        var alto = caja.height - window.innerHeight;
        var avance = alto > 0 ? (-caja.top / alto) : (caja.top < 0 ? 1 : 0);
        avance = Math.min(1, Math.max(0, avance));
        barra.style.width = (avance * 100).toFixed(2) + '%';
      }

      var enlaces = Array.prototype.slice.call(document.querySelectorAll('.art-toc a'));
      var titulos = enlaces
        .map(function (a) { return document.getElementById(a.getAttribute('href').slice(1)); })
        .filter(Boolean);

      function marcarActivo() {
        var activo = -1;
        for (var i = 0; i < titulos.length; i++) {
          if (titulos[i].getBoundingClientRect().top <= 140) activo = i;
        }
        enlaces.forEach(function (a, i) { a.classList.toggle('is-active', i === activo); });
      }

      var pendiente = false;
      window.addEventListener('scroll', function () {
        if (pendiente) return;
        pendiente = true;
        window.requestAnimationFrame(function () {
          actualizar();
          marcarActivo();
          pendiente = false;
        });
      }, { passive: true });

      actualizar();
      marcarActivo();
    })();
  </script>
</BaseLayout>
