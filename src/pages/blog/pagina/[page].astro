---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogIndexPage from '../../../components/blog/BlogIndexPage.astro';
import { getPosts, PER_PAGE } from '../../../lib/blogData';

export async function getStaticPaths() {
  const { getPosts, PER_PAGE } = await import('../../../lib/blogData');
  const posts = await getPosts();
  const total = Math.ceil(posts.length / PER_PAGE);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const SITE = 'https://firefighter.com.mx';
const pagina = Number(Astro.params.page);
const posts = await getPosts();
const totalPaginas = Math.ceil(posts.length / PER_PAGE);
const visibles = posts.slice((pagina - 1) * PER_PAGE, pagina * PER_PAGE);
const url = `${SITE}/blog/pagina/${pagina}`;
const prevUrl = pagina === 2 ? `${SITE}/blog` : `${SITE}/blog/pagina/${pagina - 1}`;
---

<BaseLayout
  title={`Blog técnico contra incendios · pág. ${pagina}`}
  description={`Página ${pagina} del blog técnico de FIREFIGHTER.COM.MX: guías sobre equipo para bomberos, extintores, SCBA, sistemas contra incendio y normativa NFPA y NOM.`}
  canonicalUrl={url}
  breadcrumbs={[{ label: 'Blog', href: '/blog' }, { label: `Página ${pagina}` }]}
>
  <Fragment slot="head">
    <link rel="prev" href={prevUrl} />
    {pagina < totalPaginas && <link rel="next" href={`${SITE}/blog/pagina/${pagina + 1}`} />}
  </Fragment>

  <BlogIndexPage posts={posts} visibles={visibles} pagina={pagina} totalPaginas={totalPaginas} />
</BaseLayout>
