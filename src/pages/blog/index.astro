---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogIndexPage from '../../components/blog/BlogIndexPage.astro';
import { getPosts, PER_PAGE } from '../../lib/blogData';
import { SERVICIOS } from '../../lib/servicios';

const SITE = 'https://firefighter.com.mx';
const posts = await getPosts();
const totalPaginas = Math.ceil(posts.length / PER_PAGE);
const visibles = posts.slice(0, PER_PAGE);

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE}/blog#blog`,
  name: 'Blog técnico FIREFIGHTER.COM.MX',
  description: 'Guías técnicas sobre equipos contra incendios, equipo para bomberos y cumplimiento normativo NFPA y NOM en México.',
  url: `${SITE}/blog`,
  inLanguage: 'es-MX',
  publisher: { '@type': 'Organization', name: 'FIREFIGHTER.COM.MX', url: SITE },
  blogPost: posts.slice(0, 20).map(p => ({
    '@type': 'BlogPosting',
    headline: p.title,
    description: p.description,
    datePublished: p.pubDate.toISOString(),
    dateModified: (p.updatedDate ?? p.pubDate).toISOString(),
    author: { '@type': 'Organization', name: p.author },
    url: `${SITE}/blog/${p.slug}`,
  })),
};
const serviciosSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios de FIREFIGHTER.COM.MX',
  itemListElement: SERVICIOS.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.nombre,
      description: `${s.promesa} ${s.copy}`,
      serviceType: s.nombre,
      areaServed: { '@type': 'Country', name: 'México' },
      audience: { '@type': 'Audience', audienceType: s.paraQuien },
      provider: { '@type': 'Organization', name: 'FIREFIGHTER.COM.MX', url: SITE },
    },
  })),
};
---

<BaseLayout
  title="Blog técnico contra incendios"
  description="Guías técnicas sobre equipo para bomberos, extintores, SCBA, sistemas contra incendio y normativa NFPA y NOM en México. Escritas por distribuidores autorizados."
  canonicalUrl={`${SITE}/blog`}
  breadcrumbs={[{ label: 'Blog' }]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviciosSchema)} />
    {totalPaginas > 1 && <link rel="next" href={`${SITE}/blog/pagina/2`} />}
  </Fragment>

  <BlogIndexPage posts={posts} visibles={visibles} pagina={1} totalPaginas={totalPaginas} />
</BaseLayout>
