---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import states from '../data/states.json';

const SITE = 'https://firefighter.com.mx';
const sortedStates = [...states].sort((a, b) => a.name.localeCompare(b.name));

const servicios = [
  { n: 'Bomberos', d: 'Incendios, rescates y emergencias con materiales peligrosos' },
  { n: 'Policía', d: 'Seguridad, delitos en curso y situaciones de violencia' },
  { n: 'Ambulancia', d: 'Emergencias médicas y traslados de urgencia' },
  { n: 'Protección Civil', d: 'Desastres naturales, riesgos estructurales y evacuaciones' },
];

const pasos = [
  { n: '01', t: 'Mantén la calma', d: 'Respira profundo y habla con claridad. El operador necesita entenderte a la primera.' },
  { n: '02', t: 'Di qué está pasando', d: 'Incendio, accidente, persona lesionada, fuga de gas. Empieza por lo más grave.' },
  { n: '03', t: 'Da la ubicación exacta', d: 'Calle, número, colonia y referencias visibles. Si es carretera, el kilómetro y el sentido.' },
  { n: '04', t: 'No cuelgues', d: 'Espera instrucciones. El operador puede guiarte mientras llega la unidad.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Números de emergencia en México',
  url: `${SITE}/emergencias`,
  inLanguage: 'es-MX',
  description: 'El 911 es el número único de emergencias en México: bomberos, policía, ambulancia y protección civil, las 24 horas.',
};
---

<BaseLayout
  title="Números de emergencia en México: 911"
  description="El 911 es el número único de emergencias en México. Qué decir al llamar, qué servicios coordina y cómo encontrar la estación de bomberos más cercana."
  canonicalUrl={`${SITE}/emergencias`}
  breadcrumbs={[{ label: 'Emergencias' }]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <PageHero
    eyebrow="Línea de emergencia nacional"
    badge="24 horas · 365 días"
    h1="Si es una emergencia,<br>marca 911 ahora"
    lead="Un operador capacitado te atiende y coordina la respuesta: bomberos, policía, ambulancia o protección civil. La llamada es gratuita desde cualquier teléfono, incluso sin saldo."
    bloques={[
      {
        label: 'Cobertura',
        texto: 'El 911 opera en <strong style="color:#e4e4e7; font-weight:600;">todo el territorio nacional</strong>, las 24 horas del día, los 365 días del año. Un solo número para todos los servicios de emergencia.',
      },
      {
        label: 'Este sitio no atiende emergencias',
        texto: 'FIREFIGHTER.COM.MX es una empresa de equipamiento contra incendios. No somos autoridad ni línea de auxilio: publicamos esta información y el directorio de estaciones como apoyo a la comunidad.',
      },
    ]}
  >
    <a slot="ctas" href="tel:911" style="display:inline-flex; align-items:center; gap:12px; background:#dc2626; color:#fff; padding:16px 28px; border-radius:12px; text-decoration:none;">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      <span style="font-size:1.5rem; font-weight:800; letter-spacing:-0.02em; line-height:1;">Llamar al 911</span>
    </a>
  </PageHero>

  <!-- ══ SERVICIOS QUE COORDINA ══ -->
  <section style="background:#fff; padding:64px 0; border-bottom:1px solid #e4e4e7;">
    <div class="container-custom">
      <div style="display:flex; align-items:center; gap:10px; margin-bottom:28px;">
        <span style="display:block; width:24px; height:2px; background:#dc2626; border-radius:2px;"></span>
        <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Un solo número para todo</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {servicios.map(s => (
          <div style="background:#fff; border:1px solid #e4e4e7; border-left:3px solid #dc2626; border-radius:14px; padding:24px;">
            <div style="font-size:1.6rem; font-weight:800; color:#dc2626; line-height:1; margin-bottom:12px;">911</div>
            <h2 style="font-size:1rem; font-weight:700; color:#09090b; margin:0 0 8px;">{s.n}</h2>
            <p style="font-size:0.8rem; color:#71717a; line-height:1.75; margin:0;">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ QUÉ DECIR ══ -->
  <section style="background:#f8fafc; padding:72px 0; border-bottom:1px solid #e4e4e7;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start; margin-bottom:40px;">
        <div>
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; border-radius:2px;"></span>
            <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Qué decir al llamar</span>
          </div>
          <h2 style="font-size:clamp(1.7rem,2.6vw,2.4rem); font-weight:800; color:#09090b; line-height:1.12; margin:0; letter-spacing:-0.02em;">
            Cuatro datos ganan<br>minutos de respuesta
          </h2>
        </div>
        <p style="font-size:0.95rem; color:#52525b; line-height:1.85; margin:0;">
          El tiempo entre que cuelgas y que llega la unidad depende en buena medida de la información que diste. Los operadores están entrenados para guiarte, pero si empiezas por lo importante, la ayuda sale antes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {pasos.map(p => (
          <div style="background:#fff; border:1px solid #e4e4e7; border-radius:14px; padding:24px;">
            <span style="font-size:0.72rem; font-weight:800; letter-spacing:0.1em; color:#dc2626; display:block; margin-bottom:14px;">{p.n}</span>
            <h3 style="font-size:1rem; font-weight:700; color:#09090b; margin:0 0 10px; line-height:1.35;">{p.t}</h3>
            <p style="font-size:0.8rem; color:#71717a; line-height:1.75; margin:0;">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ DIRECTORIO POR ESTADO ══ -->
  <section style="background:#fff; padding:72px 0;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start; margin-bottom:36px;">
        <div>
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; border-radius:2px;"></span>
            <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Después de la emergencia</span>
          </div>
          <h2 style="font-size:clamp(1.6rem,2.4vw,2.2rem); font-weight:800; color:#09090b; line-height:1.15; margin:0; letter-spacing:-0.02em;">
            Estaciones de bomberos<br>por estado
          </h2>
        </div>
        <p style="font-size:0.95rem; color:#52525b; line-height:1.85; margin:0;">
          Para trámites, visitas escolares, capacitación o contacto administrativo con tu estación local. Para una emergencia en curso, siempre 911.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-px" style="background:#e4e4e7; border:1px solid #e4e4e7; border-radius:14px; overflow:hidden;">
        {sortedStates.map(state => (
          <a href={`/directorio/${state.slug}`} style="background:#fff; padding:14px 16px; text-decoration:none; font-size:0.83rem; font-weight:600; color:#3f3f46; display:flex; align-items:center; justify-content:space-between; gap:8px;" class="hover:bg-slate-50">
            <span>{state.name}</span>
            <svg width="13" height="13" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
