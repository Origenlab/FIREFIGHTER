---
import BaseLayout from '../layouts/BaseLayout.astro';

const destinos = [
  { t: 'Catálogo de productos', d: '8 categorías certificadas NFPA, NOM y UL', h: '/productos' },
  { t: 'Blog técnico', d: 'Guías de selección, normas y mantenimiento', h: '/blog' },
  { t: 'Directorio de bomberos', d: 'Estaciones por estado, con teléfono y ubicación', h: '/directorio' },
  { t: 'Contacto', d: 'Cotizaciones, licitaciones y servicio', h: '/contacto' },
];
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de dirección. Encuentra el catálogo de equipo contra incendios, el directorio de estaciones y el blog desde aquí."
  noindex={true}
>
  <section style="background:#09090b; padding:72px 0 80px;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" style="align-items:start;">

        <div class="lg:pr-14 lg:border-r lg:border-[#1f1f23]">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; border-radius:2px;"></span>
            <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Error 404</span>
          </div>
          <h1 style="font-size:clamp(2rem,3.6vw,3rem); font-weight:800; color:#fafafa; line-height:1.08; margin:0 0 18px; letter-spacing:-0.02em;">
            Esta página no existe<br>o cambió de dirección
          </h1>
          <p style="font-size:1rem; color:#a1a1aa; line-height:1.8; margin:0 0 28px;">
            Puede que el enlace esté viejo o que hayamos movido el contenido al reorganizar el catálogo. Desde aquí llegas a lo que probablemente buscabas.
          </p>
          <div style="display:flex; flex-wrap:wrap; gap:10px;">
            <a href="/" class="l2-cta"><span>Ir al inicio</span></a>
            <a href="/productos" class="l2-cta-ghost"><span>Ver catálogo</span></a>
          </div>
        </div>

        <div style="display:flex; flex-direction:column; gap:10px;">
          {destinos.map(d => (
            <a href={d.h} style="display:flex; align-items:center; justify-content:space-between; gap:14px; background:#111113; border:1px solid #27272a; border-radius:12px; padding:16px 20px; text-decoration:none;">
              <span style="min-width:0;">
                <span style="display:block; font-size:0.9rem; font-weight:700; color:#fafafa; margin-bottom:3px;">{d.t}</span>
                <span style="display:block; font-size:0.76rem; color:#71717a; line-height:1.6;">{d.d}</span>
              </span>
              <svg width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          ))}
          <div style="display:flex; align-items:center; justify-content:space-between; gap:14px; background:#fef2f2; border:1px solid #fecaca; border-radius:12px; padding:16px 20px; margin-top:10px;">
            <span style="font-size:0.85rem; font-weight:700; color:#09090b;">¿Es una emergencia?</span>
            <a href="tel:911" style="font-size:0.95rem; font-weight:800; color:#dc2626; text-decoration:none;">Llama al 911</a>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
