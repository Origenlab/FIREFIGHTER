---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';

const SITE = 'https://firefighter.com.mx';

const secciones = [
  {
    t: '1. Responsable del tratamiento',
    p: ['FIREFIGHTER México (en adelante "el Sitio"), con domicilio en México, es responsable del tratamiento de los datos personales que se recaben a través de este sitio web.'],
  },
  {
    t: '2. Datos que recopilamos',
    p: ['Solo recabamos los datos que nos proporcionas voluntariamente al escribirnos o al solicitar una cotización:'],
    lista: ['Nombre', 'Correo electrónico y teléfono', 'Institución o empresa', 'Mensaje, requerimiento técnico o sugerencia enviada'],
  },
  {
    t: '3. Finalidad del tratamiento',
    p: ['Usamos esos datos únicamente para:'],
    lista: [
      'Responder consultas y elaborar cotizaciones o propuestas técnicas',
      'Dar seguimiento a pedidos, entregas y servicios de mantenimiento',
      'Integrar documentación en procesos de licitación cuando tú lo solicitas',
      'Procesar sugerencias y correcciones del directorio de estaciones',
    ],
  },
  {
    t: '4. Cookies y tecnologías de seguimiento',
    p: ['El Sitio puede utilizar cookies y tecnologías similares para mejorar la experiencia de navegación y entender qué contenido resulta útil. Puedes bloquearlas desde la configuración de tu navegador sin que se afecte el acceso a la información pública del sitio.'],
  },
  {
    t: '5. Transferencia de datos',
    p: ['No vendemos ni compartimos tus datos personales con terceros con fines comerciales. Solo se transfieren cuando resulta indispensable para cumplir con una obligación legal o para ejecutar el servicio que solicitaste —por ejemplo, gestionar una garantía directamente con el fabricante.'],
  },
  {
    t: '6. Derechos ARCO',
    p: ['Tienes derecho a Acceder, Rectificar, Cancelar u Oponerte al tratamiento de tus datos personales. Para ejercerlos, escríbenos desde el formulario de contacto o al correo indicado en la sección 8, señalando qué derecho deseas ejercer.'],
  },
  {
    t: '7. Cambios a este aviso',
    p: ['Podemos actualizar este aviso de privacidad. Cualquier cambio se publica en esta misma página junto con la fecha de actualización, para que puedas consultar la versión vigente.'],
  },
  {
    t: '8. Contacto',
    p: ['Para dudas sobre este aviso o sobre el tratamiento de tus datos, escríbenos a través de la página de contacto o al correo ventas@firefighter.com.mx.'],
  },
];
---

<BaseLayout
  title="Aviso de privacidad"
  description="Cómo trata FIREFIGHTER México los datos personales que recibe a través del sitio: qué se recopila, para qué se usa y cómo ejercer tus derechos ARCO."
  canonicalUrl={`${SITE}/privacidad`}
  breadcrumbs={[{ label: 'Aviso de Privacidad' }]}
>
  <PageHero
    eyebrow="Documento legal"
    h1="Aviso de privacidad"
    lead="Qué datos recibimos, para qué los usamos y cómo puedes pedirnos que los corrijamos o los eliminemos. Sin letra chica."
    bloques={[
      {
        label: 'Última actualización',
        texto: 'Febrero de 2026. Cualquier cambio se publica en esta misma página con su fecha.',
      },
      {
        label: 'En corto',
        texto: 'Usamos tus datos para responderte y darte servicio. <strong style="color:#e4e4e7; font-weight:600;">No los vendemos ni los compartimos</strong> con fines comerciales.',
      },
    ]}
    padding="52px 0 60px"
  />

  <section style="background:#f8fafc; padding:64px 0;">
    <div class="container-custom">
      <div style="max-width:820px; margin:0 auto; background:#fff; border:1px solid #e4e4e7; border-radius:16px; padding:40px;">
        {secciones.map((s, i) => (
          <div style={i > 0 ? 'margin-top:32px; padding-top:32px; border-top:1px solid #f0f0f0;' : ''}>
            <h2 style="font-size:1.1rem; font-weight:800; color:#09090b; margin:0 0 12px; letter-spacing:-0.01em;">{s.t}</h2>
            {s.p.map(par => (
              <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0 0 12px;">{par}</p>
            ))}
            {s.lista && (
              <ul style="list-style:none; margin:8px 0 0; padding:0; display:flex; flex-direction:column; gap:9px;">
                {s.lista.map(item => (
                  <li style="display:flex; align-items:flex-start; gap:10px; font-size:0.88rem; color:#3f3f46; line-height:1.7;">
                    <svg width="13" height="13" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0; margin-top:5px;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}

        <div style="margin-top:32px; padding-top:32px; border-top:1px solid #f0f0f0; display:flex; flex-wrap:wrap; gap:10px;">
          <a href="/contacto" style="display:inline-flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:700; color:#fff; background:#dc2626; padding:11px 18px; border-radius:9px; text-decoration:none;">
            Ir a contacto
          </a>
          <a href="mailto:ventas@firefighter.com.mx" style="display:inline-flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:600; color:#52525b; border:1px solid #e4e4e7; padding:11px 18px; border-radius:9px; text-decoration:none;">
            ventas@firefighter.com.mx
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
