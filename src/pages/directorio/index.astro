  </section>

  <script is:inline>
    (function () {
      var input = document.getElementById('dir-filtro');
      var limpiar = document.getElementById('dir-limpiar');
      var vacio = document.getElementById('dir-empty');
      if (!input) return;

      var regiones = Array.prototype.slice.call(document.querySelectorAll('[data-region]'));

      function normalizar(t) {
        return (t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
      }

      function filtrar(valor) {
        var q = normalizar(valor);
        var visibles = 0;

        regiones.forEach(function (region) {
          var cards = Array.prototype.slice.call(region.querySelectorAll('[data-estado]'));
          var quedan = 0;

          cards.forEach(function (card) {
            var hit = !q || normalizar(card.getAttribute('data-buscar')).indexOf(q) !== -1;
            card.style.display = hit ? '' : 'none';
            if (hit) quedan++;
          });

          region.style.display = quedan > 0 ? '' : 'none';
          visibles += quedan;
        });

        if (vacio) vacio.style.display = visibles === 0 ? 'block' : 'none';
      }

      input.addEventListener('input', function () { filtrar(input.value); });

      if (limpiar) {
        limpiar.addEventListener('click', function () {
          input.value = '';
          filtrar('');
          input.focus();
        });
      }

      var q = new URLSearchParams(window.location.search).get('q');
      if (q) {
        input.value = q;
        filtrar(q);
      }
    })();
  </script>
