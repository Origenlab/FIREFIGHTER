---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import states from '../../data/states.json';
import { getCollection } from 'astro:content';

// Conteo real de fichas publicadas (no la estimacion de states.json).
const publicadas = (await getCollection('stations')).length;

// Sort states alphabetically
const sortedStates = [...states].sort((a, b) => a.name.localeCompare(b.name));
const totalStations = sortedStates.reduce((acc, s) => acc + s.totalStations, 0);

// Group by region
const regions: Record<string, typeof states> = {};
sortedStates.forEach(state => {
  if (!regions[state.region]) {
    regions[state.region] = [];
  }
  regions[state.region].push(state);
});

const regionNames: Record<string, string> = {
  'noroeste': 'Noroeste',
  'norte': 'Norte',
  'noreste': 'Noreste',
  'centro-occidente': 'Centro-Occidente',
  'centro': 'Centro',
  'sur': 'Sur',
  'sureste': 'Sureste',
  'peninsula': 'Península',
};
---

<BaseLayout
  title="Directorio de Estaciones de Bomberos"
  description="Explora el directorio completo de estaciones de bomberos en los 32 estados de México. Encuentra información de contacto, ubicación y servicios."
  breadcrumbs={[{ label: 'Directorio' }]}
>
  <PageHero
    eyebrow="Directorio nacional"
    badge={`${publicadas} estaciones publicadas`}
    h1="Encuentra la estación<br>de bomberos más cercana"
    lead="Directorio abierto y gratuito de estaciones de bomberos en México: teléfono administrativo, dirección, ubicación GPS y servicios de cada estación."
    bloques={[
      {
        label: 'Cómo se arma',
        texto: 'Recopilamos la información de <strong style="color:#e4e4e7; font-weight:600;">fuentes públicas</strong> y de avisos de gente que conoce su zona. Verificamos cada ficha antes de publicarla y seguimos sumando estados.',
      },
      {
        label: 'Para una emergencia, 911',
        texto: 'Este directorio sirve para trámites, capacitación o contacto administrativo. Si hay una emergencia en curso, marca <strong style="color:#e4e4e7; font-weight:600;">911</strong>: es gratuito y opera las 24 horas.',
      },
    ]}
  >
    <form slot="ctas" action="/directorio" method="GET" style="max-width:520px;">
      <div style="display:flex; align-items:center; gap:8px; background:#fff; border-radius:12px; padding:6px;">
        <svg width="18" height="18" fill="none" stroke="#a1a1aa" stroke-width="2" viewBox="0 0 24 24" style="margin-left:10px; flex-shrink:0;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input
          type="search"
          name="q"
          placeholder="Buscar estado, ciudad o estación..."
          style="flex:1; min-width:0; padding:11px 6px; font-size:0.9rem; color:#09090b; background:transparent; border:0; outline:none;"
          aria-label="Buscar estaciones de bomberos"
        />
        <button type="submit" style="background:#dc2626; color:#fff; font-size:0.85rem; font-weight:700; padding:11px 20px; border:0; border-radius:9px; cursor:pointer;">Buscar</button>
      </div>
    </form>
  </PageHero>


  <!-- Emergency Banner -->
  <div class="bg-fire-600">
    <div class="container-custom py-4">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 text-center">
        <div class="flex items-center gap-3 text-white">
          <div class="w-10 h-10 bg-fire-700 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <span class="font-semibold text-lg">¿Emergencia?</span>
        </div>
        <a
          href="tel:911"
          class="inline-flex items-center gap-2 px-6 py-3 bg-white text-fire-600 font-bold rounded-xl hover:bg-fire-50 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Llama al 911
        </a>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="bg-slate-50 min-h-screen">
    <div class="container-custom py-12">
      <!-- States Grid by Region -->
      <div class="space-y-12">
        {Object.entries(regions).map(([region, stateList]) => (
          <div>
            <div class="flex items-center gap-3 mb-6">
              <h2 class="text-xl font-display font-bold text-slate-900">
                {regionNames[region] || region}
              </h2>
              <div class="flex-1 h-px bg-slate-200"></div>
              <span class="text-sm text-slate-500 font-medium">{stateList.length} estados</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              {stateList.map((state) => (
                <a
                  href={`/directorio/${state.slug}`}
                  class="group bg-white rounded-xl overflow-hidden hover:shadow-lg transition-shadow"
                  style="border: 1px solid #e2e8f0;"
                >
                  <div class="h-1 w-full" style="background-color: #dc2626;"></div>
                  <div class="p-5">
                    <div class="flex items-start justify-between mb-3">
                      <div class="w-10 h-10 bg-fire-100 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-fire-600" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 2C12 2 7 8 7 13C7 16.866 9.23858 20 12 20C14.7614 20 17 16.866 17 13C17 8 12 2 12 2Z"/>
                        </svg>
                      </div>
                      <span class="text-xs font-bold text-fire-600 bg-fire-50 px-2 py-1 rounded-full">
                        {state.totalStations}
                      </span>
                    </div>
                    <h3 class="font-display font-bold text-slate-900 group-hover:text-fire-600 transition-colors mb-1">
                      {state.name}
                    </h3>
                    <p class="text-sm text-slate-500">
                      {state.capital}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
