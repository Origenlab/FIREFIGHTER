---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import states from '../../data/states.json';
import { getCollection } from 'astro:content';

// ─── Datos reales de la coleccion (no la estimacion de states.json) ───
const fichas = await getCollection('stations');
const publicadas = fichas.length;

const porEstado: Record<string, typeof fichas> = {};
fichas.forEach((f) => {
  const s = f.data.stateSlug;
  if (!porEstado[s]) porEstado[s] = [];
  porEstado[s].push(f);
});

const municipiosTotales = new Set(fichas.map((f) => `${f.data.stateSlug}|${f.data.municipality}`)).size;
const verificadasTotales = fichas.filter((f) => f.data.verified).length;
const estadosConFichas = Object.keys(porEstado).length;

const servicioLabel: Record<string, string> = {
  'combate-incendios': 'Combate de incendios',
  'atencion-medica': 'Atención médica',
  'rescate-vehicular': 'Rescate vehicular',
  'rescate-acuatico': 'Rescate acuático',
  'rescate-forestal': 'Rescate forestal',
  'rescate-montaña': 'Rescate en montaña',
  'materiales-peligrosos': 'Materiales peligrosos',
  'rescate-alturas': 'Rescate en alturas',
  'proteccion-civil': 'Protección civil',
  capacitacion: 'Capacitación',
  prevencion: 'Prevención',
  explosivos: 'Explosivos',
};

const tipoLabel: Record<string, string> = {
  profesional: 'Profesional',
  voluntario: 'Voluntario',
  mixto: 'Mixto',
  industrial: 'Industrial',
  aeroportuario: 'Aeroportuario',
  'proteccion-civil': 'Protección Civil',
};

// ─── Enriquecimiento por estado ───
type EstadoCard = (typeof states)[number] & {
  fichas: number;
  municipios: number;
  municipiosTop: string[];
  serviciosTop: string[];
  tipos: string[];
  verificadas: number;
  unidades: number;
  label: string;
};

const estados: EstadoCard[] = states
  .map((state) => {
    const lista = porEstado[state.slug] || [];
    const municipios = [...new Set(lista.map((f) => f.data.municipality))].sort();

    const conteoServicios: Record<string, number> = {};
    lista.forEach((f) => f.data.services.forEach((s) => { conteoServicios[s] = (conteoServicios[s] || 0) + 1; }));
    const serviciosTop = Object.entries(conteoServicios)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 4)
      .map(([s]) => servicioLabel[s] || s);

    const tipos = [...new Set(lista.map((f) => tipoLabel[f.data.serviceType] || f.data.serviceType))];
    const unidades = lista.reduce((acc, f) => {
      const e = f.data.equipment;
      return acc + (e ? (e.fireTrucks || 0) + (e.ambulances || 0) + (e.rescueVehicles || 0) : 0);
    }, 0);

    return {
      ...state,
      fichas: lista.length,
      municipios: municipios.length,
      municipiosTop: municipios.slice(0, 3),
      serviciosTop,
      tipos,
      verificadas: lista.filter((f) => f.data.verified).length,
      unidades,
      label: state.name === 'Ciudad de México' ? 'Alcaldías' : 'Municipios',
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name, 'es'));

// ─── Regiones ───
const ordenRegiones = ['centro', 'centro-occidente', 'noreste', 'noroeste', 'norte', 'sur', 'sureste', 'peninsula'];

const regionInfo: Record<string, { nombre: string; texto: string }> = {
  noroeste: { nombre: 'Noroeste', texto: 'Baja California, Sinaloa y Sonora: corredor industrial y portuario con brigadas propias en maquiladoras y terminales.' },
  norte: { nombre: 'Norte', texto: 'Chihuahua, Durango y Zacatecas: temporada forestal larga y grandes distancias entre estaciones.' },
  noreste: { nombre: 'Noreste', texto: 'Coahuila, Nuevo León y Tamaulipas: alta concentración de industria pesada, petroquímica y bomberos industriales.' },
  'centro-occidente': { nombre: 'Centro-Occidente', texto: 'Jalisco, Michoacán, Colima y Nayarit: zonas metropolitanas grandes junto a áreas forestales y volcánicas.' },
  centro: { nombre: 'Centro', texto: 'La región más densa del país: Valle de México, Puebla y el Bajío concentran el mayor número de estaciones.' },
  sur: { nombre: 'Sur', texto: 'Guerrero y Oaxaca: cobertura dispersa, con cuerpos voluntarios en buena parte de los municipios.' },
  sureste: { nombre: 'Sureste', texto: 'Veracruz, Chiapas, Tabasco, Campeche y Quintana Roo: petróleo, turismo e incendios de vegetación.' },
  peninsula: { nombre: 'Península', texto: 'Yucatán: red compacta con eje en Mérida y apoyo de protección civil estatal.' },
};

const regiones = ordenRegiones
  .map((clave) => {
    const lista = estados.filter((e) => e.region === clave);
    return {
      clave,
      nombre: regionInfo[clave]?.nombre || clave,
      texto: regionInfo[clave]?.texto || '',
      estados: lista,
      fichas: lista.reduce((acc, e) => acc + e.fichas, 0),
    };
  })
  .filter((r) => r.estados.length > 0);

const conCobertura = estados.filter((e) => e.fichas > 0).sort((a, b) => b.fichas - a.fichas);
---

<BaseLayout
  title="Directorio de estaciones de bomberos"
  description={`Directorio de estaciones de bomberos en México: ${publicadas} fichas publicadas con teléfono administrativo, dirección, ubicación GPS, servicios y equipamiento. Consulta por estado y municipio.`}
  breadcrumbs={[{ label: 'Directorio' }]}
>
  <PageHero
    eyebrow="Directorio nacional"
    badge={`${publicadas} fichas publicadas`}
    h1="Directorio de estaciones<br>de bomberos en México"
    lead="Consulta por estado y municipio: teléfono administrativo, dirección, coordenadas GPS, servicios que presta cada estación y su equipamiento declarado."
    bloques={[
      {
        label: 'Cómo se arma el directorio',
        texto: `Recopilamos la información de <strong style="color:#e4e4e7; font-weight:600;">fuentes públicas</strong> y de avisos de gente que conoce su zona. Cada ficha se revisa antes de publicarse: hoy hay <strong style="color:#e4e4e7; font-weight:600;">${publicadas} estaciones</strong> en ${municipiosTotales} municipios y seguimos sumando estados.`,
      },
      {
        label: 'Para una emergencia, 911',
        texto: 'Este directorio sirve para trámites, capacitación, licitaciones o contacto administrativo. Si hay una emergencia en curso, marca <strong style="color:#e4e4e7; font-weight:600;">911</strong>: es gratuito y opera las 24 horas.',
      },
    ]}
  >
    <div slot="ctas" style="display:flex; flex-direction:column; gap:14px; max-width:520px;">
      <form action="/directorio" method="GET">
        <div style="display:flex; align-items:center; gap:8px; background:#fff; border-radius:12px; padding:6px;">
          <svg width="18" height="18" fill="none" stroke="#a1a1aa" stroke-width="2" viewBox="0 0 24 24" style="margin-left:10px; flex-shrink:0;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input
            type="search"
            name="q"
            id="dir-hero-q"
            placeholder="Buscar estado, capital o clave..."
            style="flex:1; min-width:0; padding:11px 6px; font-size:0.9rem; color:#09090b; background:transparent; border:0; outline:none;"
            aria-label="Buscar estados en el directorio"
          />
          <button type="submit" style="background:#dc2626; color:#fff; font-size:0.85rem; font-weight:700; padding:11px 20px; border:0; border-radius:9px; cursor:pointer;">Buscar</button>
        </div>
      </form>
      <div style="display:flex; flex-wrap:wrap; gap:9px;">
        {conCobertura.map((e) => (
          <a href={`/directorio/${e.slug}`} style="font-size:0.78rem; font-weight:600; color:#e4e4e7; background:#18181b; border:1px solid #27272a; padding:7px 14px; border-radius:99px; text-decoration:none;">
            {e.name} · {e.fichas}
          </a>
        ))}
        <a href="/mapa" style="font-size:0.78rem; font-weight:600; color:#dc2626; background:#18181b; border:1px solid #27272a; padding:7px 14px; border-radius:99px; text-decoration:none;">Ver mapa ↗</a>
      </div>
    </div>
  </PageHero>

  <!-- ═══ INTRO 50/50 ═══ -->
  <section style="background:#fff; border-top:1px solid #e4e4e7; padding:64px 0 0;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16" style="align-items:center; margin-bottom:48px;">
        <div>
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <span style="display:block; width:24px; height:2px; background:#dc2626; flex-shrink:0; border-radius:2px;"></span>
            <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#dc2626;">Cobertura por estado</span>
          </div>
          <h2 style="font-size:clamp(1.9rem,2.8vw,2.7rem); font-weight:800; color:#09090b; line-height:1.1; margin:0; letter-spacing:-0.02em;">
            Los 32 estados,<br>organizados por región
          </h2>
        </div>
        <div style="display:flex; flex-direction:column; gap:28px;">
          <div>
            <span style="font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#09090b; margin-bottom:10px; display:block;">Qué contiene cada ficha</span>
            <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0;">Tipo de cuerpo de bomberos —profesional, voluntario, industrial o aeroportuario—, <strong style="color:#09090b; font-weight:600;">teléfono administrativo</strong>, dirección con código postal, coordenadas GPS, horario de operación, servicios que presta y unidades declaradas.</p>
          </div>
          <div style="padding-top:28px; border-top:1px solid #f0f0f0;">
            <span style="font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#09090b; margin-bottom:10px; display:block;">Estados publicados y estados en integración</span>
            <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0;">Hoy hay fichas verificadas en <strong style="color:#09090b; font-weight:600;">{estadosConFichas} estados</strong>. El resto aparece con su ficha estatal —capital, región y clave— mientras completamos el levantamiento; puedes avisarnos de una estación que falte.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CUERPO: SIDEBAR + LISTADO ═══ -->
  <section style="background:#f8fafc; border-top:1px solid #e4e4e7; padding:48px 0 88px;">
    <div class="container-custom">
      <div class="dir-shell">

        <!-- ─── LISTADO ─── -->
        <div class="dir-main">

          <div class="dir-stats">
            <div class="dir-stat">
              <div class="dir-stat-n">{publicadas}</div>
              <div class="dir-stat-l">Fichas publicadas</div>
              <div class="dir-stat-s">Revisadas una por una</div>
            </div>
            <div class="dir-stat">
              <div class="dir-stat-n">{municipiosTotales}</div>
              <div class="dir-stat-l">Municipios cubiertos</div>
              <div class="dir-stat-s">Incluye alcaldías de CDMX</div>
            </div>
            <div class="dir-stat">
              <div class="dir-stat-n">32</div>
              <div class="dir-stat-l">Estados mapeados</div>
              <div class="dir-stat-s">{estadosConFichas} con fichas activas</div>
            </div>
            <div class="dir-stat">
              <div class="dir-stat-n">24/7</div>
              <div class="dir-stat-l">Operación reportada</div>
              <div class="dir-stat-s">Turnos continuos en la mayoría</div>
            </div>
          </div>

          <div class="dir-empty" id="dir-empty">
            <h3>Sin resultados</h3>
            <p>No hay estados que coincidan con esa búsqueda. Prueba con el nombre del estado, su capital o su clave de dos letras.</p>
          </div>

          {regiones.map((r) => (
            <div class="dir-region" id={`region-${r.clave}`} data-region>
              <div class="dir-region-head">
                <span class="dir-region-bar" aria-hidden="true"></span>
                <div style="min-width:0;">
                  <h2 class="dir-region-h">{r.nombre}</h2>
                  <p class="dir-region-sub">{r.texto}</p>
                </div>
                <div class="dir-region-meta">
                  <span class="dir-region-pill">{r.estados.length} {r.estados.length === 1 ? 'estado' : 'estados'}</span>
                  {r.fichas > 0 && <span class="dir-region-pill">{r.fichas} {r.fichas === 1 ? 'ficha' : 'fichas'}</span>}
                </div>
              </div>

              <div class="dir-grid">
                {r.estados.map((e) => (
                  <a
                    href={`/directorio/${e.slug}`}
                    class={`dir-card${e.fichas === 0 ? ' is-pendiente' : ''}`}
                    data-estado
                    data-buscar={`${e.name} ${e.capital} ${e.code} ${e.slug} ${r.nombre}`.toLowerCase()}
                  >
                    <div class="dir-card-top"></div>
                    <div class="dir-card-body">

                      <div class="dir-card-head">
                        <div style="min-width:0;">
                          <span class={`dir-badge${e.fichas === 0 ? ' is-gris' : ''}`}>
                            {e.fichas > 0 ? (e.fichas === 1 ? '1 ficha' : `${e.fichas} fichas`) : 'En integración'}
                          </span>
                          <h3 class="dir-card-h">{e.name}</h3>
                          <p class="dir-card-cap">Capital: {e.capital}</p>
                        </div>
                        <span class="dir-code">{e.code}</span>
                      </div>

                      <div class="dir-sep"><span>Datos del estado</span><i></i></div>
                      <div class="dir-kv">
                        <div class="dir-kv-item">
                          <span class="dir-kv-k">Estaciones</span>
                          <span class="dir-kv-v">{e.fichas > 0 ? e.fichas : '—'}</span>
                        </div>
                        <div class="dir-kv-item">
                          <span class="dir-kv-k">{e.label}</span>
                          <span class="dir-kv-v">{e.municipios > 0 ? e.municipios : '—'}</span>
                        </div>
                        <div class="dir-kv-item">
                          <span class="dir-kv-k">Verificadas</span>
                          <span class="dir-kv-v">{e.fichas > 0 ? e.verificadas : '—'}</span>
                        </div>
                        <div class="dir-kv-item">
                          <span class="dir-kv-k">Unidades</span>
                          <span class="dir-kv-v">{e.unidades > 0 ? e.unidades : '—'}</span>
                        </div>
                      </div>

                      {e.fichas > 0 ? (
                        <>
                          <div class="dir-sep"><span>Servicios más frecuentes</span><i></i></div>
                          <div class="dir-pills">
                            {e.serviciosTop.map((s) => <span class="dir-pill-solid">{s}</span>)}
                          </div>

                          <div class="dir-sep"><span>{e.label} con cobertura</span><i></i></div>
                          <div class="dir-pills">
                            {e.municipiosTop.map((m) => <span class="dir-pill">{m}</span>)}
                            {e.municipios > e.municipiosTop.length && (
                              <span class="dir-pill">+{e.municipios - e.municipiosTop.length} más</span>
                            )}
                          </div>

                          <div class="dir-chip">
                            <svg width="12" height="12" fill="#dc2626" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                            <span>{e.tipos.join(' · ')} · teléfono y GPS en cada ficha</span>
                          </div>
                        </>
                      ) : (
                        <>
                          <div class="dir-sep"><span>Referencia</span><i></i></div>
                          <div class="dir-pills">
                            <span class="dir-pill-solid">Región {regionInfo[e.region]?.nombre || e.region}</span>
                            <span class="dir-pill-solid">Clave {e.code}</span>
                            <span class="dir-pill-solid">Emergencias 911</span>
                          </div>

                          <div class="dir-chip is-gris">
                            <svg width="12" height="12" fill="none" stroke="#71717a" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span>Levantamiento en proceso — puedes avisarnos de una estación</span>
                          </div>
                        </>
                      )}

                      <div class="dir-card-cta">
                        <span>{e.fichas > 0 ? (e.fichas === 1 ? 'Ver 1 estación' : `Ver ${e.fichas} estaciones`) : 'Ver ficha del estado'}</span>
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                      </div>

                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}

        </div>

        <!-- ─── SIDEBAR ─── -->
        <aside class="dir-side">

          <div class="dir-panel">
            <div class="dir-panel-title"><span>Buscar estado</span><i></i></div>
            <div class="dir-search">
              <svg width="16" height="16" fill="none" stroke="#a1a1aa" stroke-width="2" viewBox="0 0 24 24" style="margin-left:8px; flex-shrink:0;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <input type="search" id="dir-filtro" placeholder="Estado, capital o clave" aria-label="Filtrar estados" />
              <button type="button" id="dir-limpiar">Limpiar</button>
            </div>
            <p style="font-size:0.7rem; color:#a1a1aa; margin:10px 0 0; line-height:1.6;">El filtro trabaja sobre las tarjetas de esta página.</p>
          </div>

          <div class="dir-panel">
            <div class="dir-panel-title"><span>Resumen</span><i></i></div>
            <div class="dir-dl">
              <div class="dir-dl-row"><span class="dir-dl-k">Fichas publicadas</span><span class="dir-dl-v">{publicadas}</span></div>
              <div class="dir-dl-row"><span class="dir-dl-k">Fichas verificadas</span><span class="dir-dl-v">{verificadasTotales}</span></div>
              <div class="dir-dl-row"><span class="dir-dl-k">Municipios cubiertos</span><span class="dir-dl-v">{municipiosTotales}</span></div>
              <div class="dir-dl-row"><span class="dir-dl-k">Estados con fichas</span><span class="dir-dl-v">{estadosConFichas} / 32</span></div>
              <div class="dir-dl-row"><span class="dir-dl-k">Regiones</span><span class="dir-dl-v">{regiones.length}</span></div>
            </div>
          </div>

          <div class="dir-panel">
            <div class="dir-panel-title"><span>Ir a una región</span><i></i></div>
            <nav class="dir-nav">
              {regiones.map((r) => (
                <a href={`#region-${r.clave}`}>
                  <span>{r.nombre}</span>
                  <span class="dir-nav-n">{r.estados.length}</span>
                </a>
              ))}
            </nav>
          </div>

          {conCobertura.length > 0 && (
            <div class="dir-panel">
              <div class="dir-panel-title"><span>Con fichas publicadas</span><i></i></div>
              <div class="dir-quick">
                {conCobertura.map((e) => (
                  <a href={`/directorio/${e.slug}`}>
                    <span>
                      <span class="dir-quick-name">{e.name}</span>
                      <span class="dir-quick-sub">{e.municipios} {e.label.toLowerCase()} · {e.verificadas} verificadas</span>
                    </span>
                    <span class="dir-quick-n">{e.fichas}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="dir-panel-dark">
            <div class="dir-panel-title"><span>Somos proveedores</span><i></i></div>
            <p class="dir-cta-title">¿Equipas o abasteces a una estación de bomberos?</p>
            <p class="dir-cta-text">Vendemos equipo estructural, SCBA, extintores, sistemas contra incendio y herramienta de rescate a cuerpos de bomberos, brigadas industriales y dependencias en todo el país.</p>
            <a href="/productos" class="dir-cta-btn">
              <span>Ver catálogo completo</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/contacto" class="dir-cta-alt">
              <span>Solicitar cotización</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

          <div class="dir-panel">
            <div class="dir-panel-title"><span>¿Falta una estación?</span><i></i></div>
            <p style="font-size:0.8rem; color:#52525b; line-height:1.75; margin:0 0 14px;">Si conoces una estación que no aparece o detectaste un dato incorrecto, mándanos el aviso. Revisamos y publicamos sin costo.</p>
            <a href="/agregar-estacion" style="display:flex; align-items:center; justify-content:space-between; gap:10px; border:1px solid #e4e4e7; color:#09090b; font-size:0.8rem; font-weight:700; padding:11px 14px; border-radius:9px; text-decoration:none;">
              <span>Agregar o corregir</span>
              <svg width="14" height="14" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

          <div class="dir-911">
            <div class="dir-911-t">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <span>Emergencia en curso</span>
            </div>
            <p>Los teléfonos del directorio son administrativos y no siempre se contestan de inmediato. Ante un incendio, accidente o rescate, marca 911.</p>
            <a href="tel:911">
