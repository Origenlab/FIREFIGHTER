---
import { tituloSeo } from '../../../lib/seoText';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/layout/PageHero.astro';
import StationCard from '../../../components/directory/StationCard.astro';
import { getCollection } from 'astro:content';
import states from '../../../data/states.json';
import { getEstado } from '../../../lib/cumplimiento';

export async function getStaticPaths() {
  return states.map((state) => ({
    params: { state: state.slug },
    props: { state },
  }));
}

const { state } = Astro.props;

/* Puente hacia /cumplimiento: el directorio de emergencia es un insumo del
   Programa Interno, así que cada estado publicado enlaza a su ficha normativa.
   Es el único enlace entrante que la sección de cumplimiento recibe del
   directorio, que es donde está el tráfico de long tail. */
const normativa = getEstado(state.slug);

const allStations = await getCollection('stations');
const stateStations = allStations
  .filter((s) => s.data.stateSlug === state.slug)
  .sort((a, b) => {
    const m = a.data.municipality.localeCompare(b.data.municipality, 'es');
    return m !== 0 ? m : a.data.name.localeCompare(b.data.name, 'es');
  });

// ─── Agrupación por municipio ───
const grupos: Record<string, typeof stateStations> = {};
stateStations.forEach((s) => {
  const m = s.data.municipality;
  if (!grupos[m]) grupos[m] = [];
  grupos[m].push(s);
});
const municipios = Object.keys(grupos).sort((a, b) => a.localeCompare(b, 'es'));

const esCDMX = state.name === 'Ciudad de México';
const LABEL = esCDMX ? 'Alcaldías' : 'Municipios';
const label = esCDMX ? 'alcaldías' : 'municipios';
const labelSing = esCDMX ? 'alcaldía' : 'municipio';

const slugify = (t: string) =>
  t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// ─── Métricas reales ───
const verificadas = stateStations.filter((s) => s.data.verified).length;
const conGps = stateStations.filter((s) => s.data.latitude != null && s.data.longitude != null).length;
const conTelefono = stateStations.filter((s) => s.data.phone).length;
const unidades = stateStations.reduce((acc, s) => {
  const e = s.data.equipment;
  return acc + (e ? (e.fireTrucks || 0) + (e.ambulances || 0) + (e.rescueVehicles || 0) : 0);
}, 0);

const servicioLabels: Record<string, string> = {
  'combate-incendios': 'Combate de incendios',
  'atencion-medica': 'Atención médica',
  'rescate-vehicular': 'Rescate vehicular',
  'rescate-acuatico': 'Rescate acuático',
  'rescate-forestal': 'Rescate forestal',
  'rescate-montaña': 'Rescate en montaña',
  'materiales-peligrosos': 'Materiales peligrosos',
  'rescate-alturas': 'Rescate en alturas',
  'proteccion-civil': 'Protección civil',
  capacitacion: 'Capacitación',
  prevencion: 'Prevención',
  explosivos: 'Explosivos',
};
const conteoServicios: Record<string, number> = {};
stateStations.forEach((s) => s.data.services.forEach((v) => { conteoServicios[v] = (conteoServicios[v] || 0) + 1; }));
const serviciosTop = Object.entries(conteoServicios).sort((a, b) => b[1] - a[1]).slice(0, 6);

const tipoLabels: Record<string, string> = {
  profesional: 'Profesional',
  voluntario: 'Voluntario',
  mixto: 'Mixto',
  industrial: 'Industrial',
  aeroportuario: 'Aeroportuario',
  'proteccion-civil': 'Protección Civil',
};
const conteoTipos: Record<string, number> = {};
stateStations.forEach((s) => {
  const t = tipoLabels[s.data.serviceType] || s.data.serviceType;
  conteoTipos[t] = (conteoTipos[t] || 0) + 1;
});

const hay = stateStations.length > 0;
---

<BaseLayout
  title={tituloSeo(`Estaciones de Bomberos en ${state.name}`)}
  description={hay
    ? `Directorio de ${stateStations.length} estaciones de bomberos en ${state.name}, en ${municipios.length} ${label}. Teléfono, dirección, ubicación GPS y servicios de cada estación. Emergencias 911.`
    : `Estaciones de bomberos en ${state.name}. Estamos levantando el directorio del estado; mientras tanto, para una emergencia marca 911.`}
  breadcrumbs={[
    { label: 'Directorio', href: '/directorio' },
    { label: state.name },
  ]}
  stateDirectory={{ name: state.name, stationCount: stateStations.length }}
>
  <PageHero
    eyebrow={`Directorio · ${state.name}`}
    badge={hay ? `${stateStations.length} ${stateStations.length === 1 ? 'ficha publicada' : 'fichas publicadas'}` : 'En integración'}
    h1={`Estaciones de bomberos<br>en ${state.name}`}
    lead={hay
      ? `Teléfono, domicilio, ubicación GPS y servicios de ${stateStations.length} ${stateStations.length === 1 ? 'estación' : 'estaciones'} en ${municipios.length} ${municipios.length === 1 ? labelSing : label}.`
      : `Todavía no publicamos fichas de ${state.name}. Estamos levantando el estado con fuentes verificables y puedes ayudarnos avisando de una estación.`}
    bloques={[
      {
        label: 'Qué encuentras en cada ficha',
        texto: 'Tipo de cuerpo de bomberos —profesional, voluntario, industrial o aeroportuario—, <strong style="color:#e4e4e7; font-weight:600;">teléfono administrativo</strong>, domicilio, coordenadas GPS, horario y servicios que presta.',
      },
      {
        label: 'Para una emergencia, 911',
        texto: 'Estos teléfonos son administrativos. Si hay un incendio o accidente en curso, marca <strong style="color:#e4e4e7; font-weight:600;">911</strong>: es gratuito, opera 24 horas y coordina la respuesta.',
      },
    ]}
  >
    <div slot="ctas" style="display:flex; flex-direction:column; gap:14px; max-width:520px;">
      {hay && (
        <div style="display:flex; align-items:center; gap:8px; background:#fff; border-radius:12px; padding:6px;">
          <svg width="18" height="18" fill="none" stroke="#a1a1aa" stroke-width="2" viewBox="0 0 24 24" style="margin-left:10px; flex-shrink:0;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input
            type="search"
            id="est-filtro"
            placeholder={`Buscar estación o ${labelSing} en ${state.name}...`}
            style="flex:1; min-width:0; padding:11px 6px; font-size:0.9rem; color:#09090b; background:transparent; border:0; outline:none;"
            aria-label={`Filtrar estaciones de ${state.name}`}
          />
          <button type="button" id="est-limpiar" style="background:#dc2626; color:#fff; font-size:0.85rem; font-weight:700; padding:11px 20px; border:0; border-radius:9px; cursor:pointer;">Limpiar</button>
        </div>
      )}
      <div style="display:flex; flex-wrap:wrap; gap:9px;">
        <a href="/directorio" style="font-size:0.78rem; font-weight:600; color:#a1a1aa; background:#18181b; border:1px solid #27272a; padding:7px 14px; border-radius:99px; text-decoration:none;">← Todos los estados</a>
        <a href="/mapa" style="font-size:0.78rem; font-weight:600; color:#dc2626; background:#18181b; border:1px solid #27272a; padding:7px 14px; border-radius:99px; text-decoration:none;">Ver mapa ↗</a>
        <a href="/agregar-estacion" style="font-size:0.78rem; font-weight:600; color:#e4e4e7; background:#18181b; border:1px solid #27272a; padding:7px 14px; border-radius:99px; text-decoration:none;">Agregar estación</a>
      </div>
    </div>
  </PageHero>

  <!-- ═══ CUERPO ═══ -->
  <section style="background:#f8fafc; border-top:1px solid #e4e4e7; padding:44px 0 84px;">
    <div class="container-custom">
      <div class="dir-shell">

        <!-- ─── LISTADO ─── -->
        <div class="dir-main">

          {hay ? (
            <>
              <div class="dir-stats">
                <div class="dir-stat">
                  <div class="dir-stat-n">{stateStations.length}</div>
                  <div class="dir-stat-l">Estaciones</div>
                  <div class="dir-stat-s">{verificadas} verificadas</div>
                </div>
                <div class="dir-stat">
                  <div class="dir-stat-n">{municipios.length}</div>
                  <div class="dir-stat-l">{LABEL}</div>
                  <div class="dir-stat-s">con cobertura publicada</div>
                </div>
                <div class="dir-stat">
                  <div class="dir-stat-n">{conTelefono}</div>
                  <div class="dir-stat-l">Con teléfono</div>
                  <div class="dir-stat-s">directo publicado</div>
                </div>
                <div class="dir-stat">
                  <div class="dir-stat-n">{unidades > 0 ? unidades : conGps}</div>
                  <div class="dir-stat-l">{unidades > 0 ? 'Unidades' : 'Con GPS'}</div>
                  <div class="dir-stat-s">{unidades > 0 ? 'declaradas en las fichas' : 'ubicación exacta publicada'}</div>
                </div>
              </div>

              <div class="dir-empty" id="est-empty">
                <h3>Sin resultados</h3>
                <p>No hay estaciones que coincidan con esa búsqueda. Prueba con el nombre de la estación o del {labelSing}.</p>
              </div>

              {municipios.map((m) => (
                <div class="dir-region" id={slugify(m)} data-municipio>
                  <div class="dir-region-head">
                    <span class="dir-region-bar" aria-hidden="true"></span>
                    <div style="min-width:0;">
                      <h2 class="dir-region-h">{m}</h2>
                      <p class="dir-region-sub">
                        {grupos[m].length === 1
                          ? `1 estación registrada en ${m === state.name ? m : `${m}, ${state.name}`}.`
                          : `${grupos[m].length} estaciones registradas en ${m === state.name ? m : `${m}, ${state.name}`}.`}
                      </p>
                    </div>
                    <div class="dir-region-meta">
                      <span class="dir-region-pill">{grupos[m].length} {grupos[m].length === 1 ? 'estación' : 'estaciones'}</span>
                    </div>
                  </div>
                  <div class="dir-grid">
                    {grupos[m].map((s) => <StationCard station={s} />)}
                  </div>
                </div>
              ))}
            </>
          ) : (
            <div class="est-card">
              <div class="est-head">
                <span class="est-bar" aria-hidden="true"></span>
                <div style="min-width:0;">
                  <h2 class="est-h2">{state.name} está en integración</h2>
                  <p class="est-lead">Todavía no publicamos fichas de este estado.</p>
                </div>
              </div>
              <p style="font-size:0.9rem; color:#52525b; line-height:1.85; margin:0 0 18px;">
                Estamos levantando el directorio estado por estado y solo publicamos lo que podemos comprobar:
                domicilio, teléfono y ubicación con fuente verificable. Preferimos una ficha vacía a un dato inventado,
                porque un teléfono equivocado en un directorio de emergencias hace daño.
              </p>
              <div class="dir-kv" style="margin-bottom:20px;">
                <div class="dir-kv-item"><span class="dir-kv-k">Capital</span><span class="dir-kv-v">{state.capital}</span></div>
                <div class="dir-kv-item"><span class="dir-kv-k">Clave</span><span class="dir-kv-v">{state.code}</span></div>
              </div>
              <div style="display:flex; flex-wrap:wrap; gap:10px;">
                <a href="/agregar-estacion" class="l2-cta" style="background:#dc2626;"><span>Avísanos de una estación</span></a>
                <a href="/directorio" class="l2-cta-ghost on-light"><span>Ver estados publicados</span></a>
              </div>
            </div>
          )}

        </div>

        <!-- ─── SIDEBAR ─── -->
        <aside class="dir-side">

          {hay && municipios.length > 1 && (
            <div class="dir-panel">
              <div class="dir-panel-title"><span>Ir a un {labelSing}</span><i></i></div>
              <nav class="dir-nav">
                {municipios.map((m) => (
                  <a href={`#${slugify(m)}`}>
                    <span>{m}</span>
                    <span class="dir-nav-n">{grupos[m].length}</span>
                  </a>
                ))}
              </nav>
            </div>
          )}

          {hay && (
            <div class="dir-panel">
              <div class="dir-panel-title"><span>Resumen del estado</span><i></i></div>
              <div class="dir-dl">
                <div class="dir-dl-row"><span class="dir-dl-k">Estaciones publicadas</span><span class="dir-dl-v">{stateStations.length}</span></div>
                <div class="dir-dl-row"><span class="dir-dl-k">Verificadas</span><span class="dir-dl-v">{verificadas}</span></div>
                <div class="dir-dl-row"><span class="dir-dl-k">Con ubicación GPS</span><span class="dir-dl-v">{conGps}</span></div>
                <div class="dir-dl-row"><span class="dir-dl-k">{LABEL} cubiertos</span><span class="dir-dl-v">{municipios.length}</span></div>
                <div class="dir-dl-row"><span class="dir-dl-k">Capital</span><span class="dir-dl-v">{state.capital}</span></div>
              </div>
            </div>
          )}

          {hay && Object.keys(conteoTipos).length > 0 && (
            <div class="dir-panel">
              <div class="dir-panel-title"><span>Tipo de cuerpo</span><i></i></div>
              <div class="dir-pills">
                {Object.entries(conteoTipos).sort((a, b) => b[1] - a[1]).map(([t, n]) => (
                  <span class="dir-pill">{t} · {n}</span>
                ))}
              </div>
            </div>
          )}

          {hay && serviciosTop.length > 0 && (
            <div class="dir-panel">
              <div class="dir-panel-title"><span>Servicios en el estado</span><i></i></div>
              <div class="dir-dl">
                {serviciosTop.map(([s, n]) => (
                  <div class="dir-dl-row">
                    <span class="dir-dl-k">{servicioLabels[s] || s}</span>
                    <span class="dir-dl-v">{n}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="dir-panel-dark">
            <div class="dir-panel-title"><span>Somos proveedores</span><i></i></div>
            <p class="dir-cta-title">¿Equipas a un cuerpo de bomberos de {state.name}?</p>
            <p class="dir-cta-text">Equipo estructural, SCBA, extintores, sistemas contra incendio y herramienta de rescate para cuerpos municipales, brigadas industriales y dependencias. Documentación lista para licitación.</p>
            <a href="/productos" class="dir-cta-btn">
              <span>Ver catálogo completo</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/contacto" class="dir-cta-alt">
              <span>Solicitar cotización</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

          {normativa && (
            <div class="dir-panel">
              <div class="dir-panel-title"><span>Cumplimiento en {state.name}</span><i></i></div>
              <p style="font-size:0.8rem; color:#52525b; line-height:1.75; margin:0 0 12px;">
                El directorio de emergencia es solo una parte del Programa Interno de Protección Civil. En {state.name} lo autoriza {normativa.autoridad.split('.')[0].toLowerCase()}, con vigencia {normativa.pipcVigencia.split('.')[0].toLowerCase()} y {normativa.simulacrosMin > 0 ? `${normativa.simulacrosMin} simulacros al año` : 'sin mínimo de simulacros fijado en la ley'}.
              </p>
              <a href={`/cumplimiento/estado/${state.slug}`} style="display:flex; align-items:center; justify-content:space-between; gap:10px; border:1px solid #e4e4e7; color:#09090b; font-size:0.8rem; font-weight:700; padding:11px 14px; border-radius:9px; text-decoration:none;">
                <span>Ver la normativa del estado</span>
                <svg width="14" height="14" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          )}

          <div class="dir-panel">
            <div class="dir-panel-title"><span>¿Falta una estación?</span><i></i></div>
            <p style="font-size:0.8rem; color:#52525b; line-height:1.75; margin:0 0 14px;">
              Si conoces una estación de {state.name} que no aparece, o detectaste un dato incorrecto, mándanos el aviso. Revisamos y publicamos sin costo.
            </p>
            <a href="/agregar-estacion" style="display:flex; align-items:center; justify-content:space-between; gap:10px; border:1px solid #e4e4e7; color:#09090b; font-size:0.8rem; font-weight:700; padding:11px 14px; border-radius:9px; text-decoration:none;">
              <span>Agregar o corregir</span>
              <svg width="14" height="14" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

          <div class="dir-911">
            <div class="dir-911-t">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <span>Emergencia en {state.name}</span>
            </div>
            <p>Los teléfonos del directorio son administrativos y no siempre se contestan de inmediato. Ante un incendio, accidente o rescate, marca 911.</p>
            <a href="tel:911">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Llamar al 911
            </a>
          </div>

        </aside>

      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var input = document.getElementById('est-filtro');
      var limpiar = document.getElementById('est-limpiar');
      var vacio = document.getElementById('est-empty');
      if (!input) return;

      var bloques = Array.prototype.slice.call(document.querySelectorAll('[data-municipio]'));

      function norm(t) {
        return (t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
      }

      function filtrar(valor) {
        var q = norm(valor);
        var visibles = 0;

        bloques.forEach(function (bloque) {
          var cards = Array.prototype.slice.call(bloque.querySelectorAll('.dir-card'));
          var quedan = 0;
          cards.forEach(function (card) {
            var hit = !q || norm(card.innerText).indexOf(q) !== -1;
            card.style.display = hit ? '' : 'none';
            if (hit) quedan++;
          });
          bloque.style.display = quedan > 0 ? '' : 'none';
          visibles += quedan;
        });

        if (vacio) vacio.style.display = visibles === 0 ? 'block' : 'none';
      }

      input.addEventListener('input', function () { filtrar(input.value); });
      if (limpiar) {
        limpiar.addEventListener('click', function () { input.value = ''; filtrar(''); input.focus(); });
      }

      var q = new URLSearchParams(window.location.search).get('q');
      if (q) { input.value = q; filtrar(q); }
    })();
  </script>
</BaseLayout>
