---
import { tituloSeo, descripcionSeo } from '../../../lib/seoText';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JsonLd from '../../../components/seo/JsonLd.astro';
import { getCollection, render } from 'astro:content';
import states from '../../../data/states.json';

export async function getStaticPaths() {
  const allStations = await getCollection('stations');

  return allStations.map((station) => {
    const stationSlug = station.id.split('/').pop()?.replace('.md', '') || '';

    // Get related stations (same state, excluding current)
    const relatedStations = allStations
      .filter(s => s.data.stateSlug === station.data.stateSlug && s.id !== station.id)
      .slice(0, 5);

    return {
      params: {
        state: station.data.stateSlug,
        station: stationSlug,
      },
      props: { station, relatedStations, allStations },
    };
  });
}

const { station, relatedStations, allStations } = Astro.props;
const { data } = station;
const { Content } = await render(station);

const state = states.find((s) => s.slug === data.stateSlug);
const currentStationSlug = station.id.split('/').pop()?.replace('.md', '') || '';
const siteUrl = 'https://firefighter.com.mx';
const canonicalUrl = `${siteUrl}/directorio/${data.stateSlug}/${currentStationSlug}`;

// Calculate nearby stations by distance
function getDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
  const R = 6371; // Earth's radius in km
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
}

// Get nearest stations (from all states)
// Hay fichas sin GPS publicado: la cercania solo se calcula cuando ambas lo tienen.
const tieneGps = data.latitude != null && data.longitude != null;

const nearbyStations = (tieneGps
  ? allStations
      .filter(s => s.id !== station.id && s.data.latitude != null && s.data.longitude != null)
      .map(s => ({
        ...s,
        distance: getDistance(data.latitude as number, data.longitude as number, s.data.latitude as number, s.data.longitude as number) as number | null,
      }))
      .sort((a, b) => (a.distance as number) - (b.distance as number))
  : allStations
      .filter(s => s.id !== station.id && s.data.stateSlug === data.stateSlug)
      .map(s => ({ ...s, distance: null as number | null }))
).slice(0, 3);

// Domicilio compuesto (puede no estar publicado)
const domicilio = data.address
  ? `${data.address}${data.neighborhood ? `, ${data.neighborhood}` : ''}${data.postalCode ? `, C.P. ${data.postalCode}` : ''}`
  : null;
const telefonoPublico = data.phone || null;

// Unidades declaradas (motobombas + ambulancias + rescate)
const eq = data.equipment;
const equipoTotal = eq ? (eq.fireTrucks || 0) + (eq.ambulances || 0) + (eq.rescueVehicles || 0) : 0;

const serviceTypeLabels: Record<string, string> = {
  'profesional': 'Profesional',
  'voluntario': 'Voluntario',
  'industrial': 'Industrial',
  'aeroportuario': 'Aeroportuario',
  'proteccion-civil': 'Protección Civil',
};

const serviceLabels: Record<string, string> = {
  'combate-incendios': 'Combate de Incendios',
  'atencion-medica': 'Atención Médica',
  'rescate-vehicular': 'Rescate Vehicular',
  'rescate-acuatico': 'Rescate Acuático',
  'rescate-forestal': 'Rescate Forestal',
  'rescate-montaña': 'Rescate en Montaña',
  'explosivos': 'Manejo de Explosivos',
  'materiales-peligrosos': 'Materiales Peligrosos (Hazmat)',
  'rescate-alturas': 'Rescate en Alturas',
  'proteccion-civil': 'Protección Civil',
  'capacitacion': 'Capacitación',
  'prevencion': 'Prevención',
};

// Google Maps URL
const mapsUrl = tieneGps
  ? `https://www.google.com/maps/search/?api=1&query=${data.latitude},${data.longitude}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
      [data.name, data.address, data.municipality, data.state, 'México'].filter(Boolean).join(', ')
    )}`;

// SEO: Generate rich keywords
const servicesText = data.services.map(s => serviceLabels[s] || s).join(', ');
const seoKeywords = [
  'bomberos',
  'estación de bomberos',
  data.municipality,
  data.city,
  data.state,
  'emergencias',
  '911',
  'incendios',
  'rescate',
  data.neighborhood || '',
  serviceTypeLabels[data.serviceType] || '',
].filter(Boolean).join(', ');

// Enhanced SEO meta description
const enhancedDescription = data.metaDescription ||
  `${data.name} en ${data.neighborhood ? data.neighborhood + ', ' : ''}${data.municipality}, ${data.city}. ` +
  `${data.phone ? `Tel: ${data.phone}. ` : ''}Servicios: ${servicesText.substring(0, 60)}. ` +
  `Horario: ${data.operatingHours}. Emergencias: 911.`;

// Meta description con piso útil: si el corte queda corto, se completa con el contexto del directorio
const metaBase = descripcionSeo(enhancedDescription);
const metaDescripcion = metaBase.length < 110
  ? descripcionSeo(`${metaBase} Consulta ubicación, teléfono y servicios en el directorio nacional de estaciones de bomberos de México.`)
  : metaBase;

// Schema.org FireStation - Enhanced
const fireStationSchema = {
  "@context": "https://schema.org",
  "@type": "FireStation",
  "@id": canonicalUrl,
  "name": data.name,
  "alternateName": data.stationCode,
  "description": enhancedDescription,
  "url": canonicalUrl,
  ...(data.phone ? { "telephone": data.phone } : {}),
  "email": data.email || undefined,
  "address": {
    "@type": "PostalAddress",
    ...(data.address ? { "streetAddress": data.address } : {}),
    "addressLocality": data.municipality,
    "addressRegion": data.state,
    ...(data.postalCode ? { "postalCode": data.postalCode } : {}),
    "addressCountry": "MX",
    "areaServed": {
      "@type": "City",
      "name": data.city
    }
  },
  ...(tieneGps
    ? {
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": data.latitude,
          "longitude": data.longitude
        }
      }
    : {}),
  "hasMap": mapsUrl,
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "00:00",
    "closes": "23:59"
  },
  "foundingDate": data.yearEstablished ? String(data.yearEstablished) : undefined,
  "numberOfEmployees": data.totalPersonnel ? {
    "@type": "QuantitativeValue",
    "value": data.totalPersonnel
  } : undefined,
  "knowsAbout": data.services.map(s => serviceLabels[s] || s),
  "publicAccess": true,
  "isAccessibleForFree": true,
  "currenciesAccepted": "MXN",
  "paymentAccepted": "Emergency services are free",
  "priceRange": "Gratuito",
  "image": `${siteUrl}/images/og-image.png`,
  "sameAs": data.website ? [data.website] : [],
  "potentialAction": {
    "@type": "ReserveAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `tel:${data.phone || '911'}`,
      "actionPlatform": ["http://schema.org/IOSPlatform", "http://schema.org/AndroidPlatform"]
    },
    "result": {
      "@type": "Reservation",
      "name": "Llamar a la estación"
    }
  }
  // NOTA SEO 2026-07-10 (2ª pasada): se REMOVIÓ `aggregateRating`. Emitía un rating
  // hardcodeado 5.0 / ratingCount 1 en las 92 estaciones con `verified:true`. No existe
  // ninguna reseña real en el sitio ni en el frontmatter: `verified` valida el NAP, no una
  // calificación. Rating inventado = viola "cero contenido fabricado" + riesgo de acción
  // manual de Google por review spam. NO re-agregar sin reseñas reales verificables.
};

// NOTA SEO: el BreadcrumbList lo genera SEOHead desde el prop `breadcrumbs`
// de BaseLayout — el schema manual duplicado se eliminó (2 BreadcrumbList por página).

// Schema.org FAQPage - For emergency reporting section
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuál es el número de emergencias para bomberos en México?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El número de emergencias es el 911. Este número es gratuito y funciona desde cualquier teléfono fijo o celular en todo México."
      }
    },
    {
      "@type": "Question",
      "name": `¿Cuál es el teléfono de la ${data.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": data.phone
          ? `El teléfono directo de la ${data.name} es ${data.phone}. También puedes llamar al 911 para emergencias.`
          : `La ${data.name} no tiene un teléfono directo publicado. Para una emergencia marca 911, que es gratuito y opera las 24 horas.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Dónde está ubicada la ${data.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": domicilio
          ? `La ${data.name} está ubicada en ${domicilio}, ${data.municipality}, ${data.city}, ${data.state}.`
          : `La ${data.name} opera en ${data.municipality}, ${data.state}. Su domicilio exacto todavía no está publicado en fuentes oficiales.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Cuál es el horario de la ${data.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `La ${data.name} opera las ${data.operatingHours}, los 365 días del año para atender emergencias.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Qué servicios ofrece la ${data.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `La ${data.name} ofrece los siguientes servicios: ${servicesText}.`
      }
    }
  ]
};

// Schema.org LocalBusiness (combined for better local SEO)
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "GovernmentService",
  "name": data.name,
  "serviceType": "Servicios de Emergencia y Bomberos",
  "provider": {
    "@type": "GovernmentOrganization",
    "name": `Heroico Cuerpo de Bomberos de ${data.city}`,
    "areaServed": {
      "@type": "City",
      "name": data.city,
      "containedIn": {
        "@type": "State",
        "name": data.state
      }
    }
  },
  "areaServed": {
    "@type": "City",
    "name": data.municipality,
    "containedIn": {
      "@type": "State",
      "name": data.state
    }
  },
  "availableChannel": {
    "@type": "ServiceChannel",
    "serviceUrl": canonicalUrl,
    ...(data.phone ? { "servicePhone": data.phone } : {}),
    "availableLanguage": {
      "@type": "Language",
      "name": "Spanish"
    }
  }
};
---

<BaseLayout
  title={tituloSeo(data.metaTitle || `${data.name} — Bomberos ${data.city}`)}
  description={metaDescripcion}
  canonicalUrl={canonicalUrl}
  breadcrumbs={[
    { label: 'Directorio', href: '/directorio' },
    { label: state?.name || data.state, href: `/directorio/${data.stateSlug}` },
    { label: data.name },
  ]}
>
  <!-- SEO: Geo Meta Tags for Local Search -->
  <meta slot="head" name="geo.region" content={`MX-${data.stateSlug.toUpperCase().substring(0, 3)}`} />
  <meta slot="head" name="geo.placename" content={`${data.municipality}, ${data.city}`} />
  {tieneGps && (
    <>
      <meta slot="head" name="geo.position" content={`${data.latitude};${data.longitude}`} />
      <meta slot="head" name="ICBM" content={`${data.latitude}, ${data.longitude}`} />
    </>
  )}

  <!-- SEO: Keywords -->
  <meta slot="head" name="keywords" content={seoKeywords} />

  <!-- SEO: Additional Meta Tags -->
  <meta slot="head" name="author" content="FIREFIGHTER.COM.MX" />
  <meta slot="head" name="publisher" content="FIREFIGHTER.COM.MX" />
  <meta slot="head" name="coverage" content="México" />
  <meta slot="head" name="distribution" content="global" />
  <meta slot="head" name="rating" content="general" />
  <meta slot="head" name="revisit-after" content="7 days" />

  <!-- SEO: Place/Location Tags (for Apple Maps, etc) -->
  {tieneGps && (
    <>
      <meta slot="head" property="place:location:latitude" content={String(data.latitude)} />
      <meta slot="head" property="place:location:longitude" content={String(data.longitude)} />
    </>
  )}

  <!-- Schema.org JSON-LD: FireStation (Primary) -->
  <script type="application/ld+json" set:html={JSON.stringify(fireStationSchema)} />

  <!-- Schema.org JSON-LD: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Schema.org JSON-LD: GovernmentService -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- ══════════ HERO DE LA ESTACIÓN ══════════ -->
  <section style="background:#09090b; padding:48px 0 56px;">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-10" style="align-items:start;">

        <div style="min-width:0;">
          <div style="display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:18px;">
            <span style="display:inline-flex; align-items:center; gap:6px; background:#dc2626; color:#fff; font-size:0.62rem; font-weight:800; letter-spacing:0.07em; padding:4px 11px; border-radius:4px; text-transform:uppercase;">
              {serviceTypeLabels[data.serviceType] || data.serviceType}
            </span>
            <span style={`display:inline-flex; align-items:center; gap:6px; font-size:0.66rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; padding:4px 11px; border-radius:99px; border:1px solid #27272a; background:#111113; color:${data.status === 'activa' ? '#4ade80' : '#a1a1aa'};`}>
              <span style={`width:6px; height:6px; border-radius:50%; background:${data.status === 'activa' ? '#22c55e' : '#71717a'};`}></span>
              {data.status === 'activa' ? 'En operación' : data.status}
            </span>
            {data.verified && (
              <span style="display:inline-flex; align-items:center; gap:6px; font-size:0.66rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; padding:4px 11px; border-radius:99px; border:1px solid #27272a; background:#111113; color:#e4e4e7;">
                <svg width="11" height="11" fill="none" stroke="#dc2626" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                Verificada
              </span>
            )}
          </div>

          <h1 style="font-size:clamp(1.6rem,2.9vw,2.4rem); font-weight:800; color:#fafafa; line-height:1.12; margin:0 0 12px; letter-spacing:-0.02em;">
            {data.name}
          </h1>

          <p style="font-size:0.95rem; color:#dc2626; font-weight:600; margin:0 0 18px;">
            {[...new Set([data.municipality, data.city])].join(', ')} — {data.state}
          </p>

          <div style="display:flex; align-items:flex-start; gap:9px; font-size:0.88rem; color:#a1a1aa; line-height:1.7; max-width:640px;">
            <svg width="15" height="15" fill="none" stroke="#52525b" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink:0; margin-top:4px;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>{domicilio || `${data.municipality}, ${data.state} — domicilio exacto pendiente de publicación oficial`}</span>
          </div>
        </div>

        <div style="display:flex; flex-direction:column; gap:10px; min-width:250px;">
          <a href={`tel:${telefonoPublico || '911'}`} class="l2-cta" style="justify-content:center;">
            <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>{telefonoPublico || 'Emergencias 911'}</span>
          </a>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="l2-cta-ghost" style="justify-content:center;">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>Cómo llegar</span>
          </a>
          <div style="display:flex; align-items:center; gap:8px; padding:10px 14px; border-radius:9px; background:#111113; border:1px solid #27272a;">
            <span style="width:7px; height:7px; border-radius:50%; background:#dc2626; flex-shrink:0;"></span>
            <span style="font-size:0.74rem; color:#a1a1aa; line-height:1.5;">Emergencia en curso: marca <a href="tel:911" style="color:#fafafa; font-weight:700; text-decoration:none;">911</a></span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════ CUERPO ══════════ -->
  <section style="background:#f8fafc; border-top:1px solid #e4e4e7; padding:40px 0 80px;">
    <div class="container-custom">
      <div class="dir-shell">

        <!-- ─── COLUMNA PRINCIPAL ─── -->
        <div class="dir-main" style="display:flex; flex-direction:column; gap:20px;">

          <!-- Datos operativos -->
          <div class="dir-stats" style="margin-bottom:0;">
            <div class="dir-stat">
              <div class="dir-stat-n" style="font-size:1.1rem;">{serviceTypeLabels[data.serviceType] || data.serviceType}</div>
              <div class="dir-stat-l">Tipo de cuerpo</div>
            </div>
            <div class="dir-stat">
              <div class="dir-stat-n" style="font-size:1.1rem;">{data.operatingHours}</div>
              <div class="dir-stat-l">Horario</div>
            </div>
            <div class="dir-stat">
              <div class="dir-stat-n" style={`font-size:1.1rem; color:${data.status === 'activa' ? '#16a34a' : '#71717a'};`}>
                {data.status === 'activa' ? 'Activa' : data.status}
              </div>
              <div class="dir-stat-l">Estado operativo</div>
            </div>
            <div class="dir-stat">
              <div class="dir-stat-n" style="font-size:1.1rem;">{tieneGps ? 'Sí' : 'Pendiente'}</div>
              <div class="dir-stat-l">Ubicación GPS</div>
            </div>
          </div>

          <!-- Mapa / aviso -->
          {tieneGps ? (
            <div class="est-mapa">
              <iframe
                src={`https://www.openstreetmap.org/export/embed.html?bbox=${(data.longitude as number)-0.008}%2C${(data.latitude as number)-0.006}%2C${(data.longitude as number)+0.008}%2C${(data.latitude as number)+0.006}&layer=mapnik&marker=${data.latitude}%2C${data.longitude}`}
                loading="lazy"
                title={`Mapa de ${data.name}`}
              ></iframe>
              <div class="est-mapa-pie">
                <span class="est-mapa-coord">{(data.latitude as number).toFixed(5)}, {(data.longitude as number).toFixed(5)}</span>
                <a class="est-mapa-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir en Google Maps →</a>
              </div>
            </div>
          ) : (
            <div class="est-card">
              <div class="est-head">
                <span class="est-bar" aria-hidden="true"></span>
                <div style="min-width:0;">
                  <h2 class="est-h2">Ubicación GPS pendiente</h2>
                  <p class="est-lead">No publicamos coordenadas que no podamos verificar.</p>
                </div>
              </div>
              <p style="font-size:0.88rem; color:#52525b; line-height:1.8; margin:0 0 16px;">
                Todavía no aparecen las coordenadas exactas de esta estación en ninguna fuente que hayamos podido comprobar.
                Preferimos dejar el campo vacío antes que publicar una ubicación aproximada que mande a alguien al lugar equivocado.
                {domicilio ? ' El domicilio de referencia sí está confirmado y aparece en el encabezado.' : ''}
              </p>
              <a href="/agregar-estacion" style="display:inline-flex; align-items:center; gap:8px; font-size:0.82rem; font-weight:700; color:#dc2626; text-decoration:none;">
                <span>¿Conoces la ubicación exacta? Avísanos</span>
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          )}

          <!-- Servicios -->
          <div class="est-card">
            <div class="est-head">
              <span class="est-bar" aria-hidden="true"></span>
              <div style="min-width:0;">
                <h2 class="est-h2">Servicios que presta</h2>
                <p class="est-lead">{data.services.length} servicios registrados para esta estación.</p>
              </div>
            </div>
            <div class="est-svc">
              {data.services.map((service) => (
                <div class="est-svc-item">
                  <span class="est-svc-dot" aria-hidden="true">
                    <svg width="12" height="12" fill="none" stroke="#dc2626" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  </span>
                  <span>{serviceLabels[service] || service}</span>
                </div>
              ))}
            </div>
          </div>

          {equipoTotal > 0 && (
            <div class="est-card">
              <div class="est-head">
                <span class="est-bar" aria-hidden="true"></span>
                <div style="min-width:0;">
                  <h2 class="est-h2">Equipamiento declarado</h2>
                  <p class="est-lead">{equipoTotal} unidades registradas.</p>
                </div>
              </div>
              <div class="dir-kv" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr));">
                {data.equipment?.fireTrucks ? (
                  <div class="dir-kv-item"><span class="dir-kv-k">Motobombas</span><span class="dir-kv-v">{data.equipment.fireTrucks}</span></div>
                ) : null}
                {data.equipment?.ambulances ? (
                  <div class="dir-kv-item"><span class="dir-kv-k">Ambulancias</span><span class="dir-kv-v">{data.equipment.ambulances}</span></div>
                ) : null}
                {data.equipment?.rescueVehicles ? (
                  <div class="dir-kv-item"><span class="dir-kv-k">Unidades de rescate</span><span class="dir-kv-v">{data.equipment.rescueVehicles}</span></div>
                ) : null}
                {data.totalPersonnel ? (
                  <div class="dir-kv-item"><span class="dir-kv-k">Personal</span><span class="dir-kv-v">{data.totalPersonnel}</span></div>
                ) : null}
              </div>
              {data.equipment?.other && (
                <p style="font-size:0.82rem; color:#52525b; line-height:1.7; margin:14px 0 0;">{data.equipment.other}</p>
              )}
            </div>
          )}

          <!-- Contenido editorial de la ficha -->
          <div class="est-card">
            <div class="art-prose est-prose">
              <Content />
            </div>
          </div>

          <!-- ══ MÓDULO COMERCIAL ══ -->
          <div style="background:#09090b; border-radius:16px; padding:32px;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
              <span style="display:block; width:24px; height:2px; background:#dc2626; border-radius:2px;"></span>
              <span style="font-size:0.68rem; font-weight:800; letter-spacing:0.14em; text-transform:uppercase; color:#dc2626;">Equipamiento</span>
            </div>
            <h2 style="font-size:1.3rem; font-weight:800; color:#fafafa; margin:0 0 12px; line-height:1.3; letter-spacing:-0.01em;">
              ¿Equipas o abasteces a esta estación?
            </h2>
            <p style="font-size:0.9rem; color:#a1a1aa; line-height:1.8; margin:0 0 22px; max-width:640px;">
              Somos distribuidores autorizados de MSA Safety, Scott, Bullard, Holmatro y Amerex. Cotizamos trajes estructurales, SCBA, herramienta de rescate y extintores con norma aplicable, número de parte y la documentación que piden protección civil y las licitaciones públicas.
            </p>
            <div class="blog-grid" style="margin-bottom:22px;">
              {[
                { t: 'EPP para Bomberos', d: 'Trajes, cascos, botas y guantes NFPA 1970', h: '/productos/epp-para-bomberos' },
                { t: 'Equipos de Respiración', d: 'SCBA, máscaras y cilindros certificados', h: '/productos/equipos-de-respiracion' },
                { t: 'Herramientas de Rescate', d: 'Equipo hidráulico de excarcelación', h: '/productos/herramientas-de-rescate' },
                { t: 'Extintores y Extinción', d: 'PQS, CO2, Clase K y espuma NOM-154', h: '/productos/extintores-y-extincion' },
              ].map((c) => (
                <a href={c.h} style="display:flex; align-items:center; justify-content:space-between; gap:12px; background:#111113; border:1px solid #27272a; border-radius:11px; padding:14px 16px; text-decoration:none;">
                  <span style="min-width:0;">
                    <span style="display:block; font-size:0.85rem; font-weight:700; color:#fafafa; margin-bottom:3px;">{c.t}</span>
                    <span style="display:block; font-size:0.73rem; color:#71717a; line-height:1.55;">{c.d}</span>
                  </span>
                  <svg width="15" height="15" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
              ))}
            </div>
            <div style="display:flex; flex-wrap:wrap; gap:10px;">
              <a href="/contacto" class="l2-cta"><span>Solicitar cotización</span></a>
              <a href="/productos" class="l2-cta-ghost"><span>Ver catálogo completo</span></a>
            </div>
          </div>

        </div>

        <!-- ─── SIDEBAR ─── -->
        <aside class="dir-side">

          <div class="dir-panel">
            <div class="dir-panel-title"><span>Contacto</span><i></i></div>
            <div class="est-contact">
              <a href={`tel:${telefonoPublico || '911'}`} class="is-primary">
                <span class="est-contact-ico">
                  <svg width="15" height="15" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </span>
                <span style="min-width:0;">
                  <span class="est-contact-k">{telefonoPublico ? 'Teléfono de la estación' : 'Emergencias'}</span>
                  <span class="est-contact-v">{telefonoPublico || '911'}</span>
                </span>
              </a>
              {data.adminPhone && (
                <a href={`tel:${data.adminPhone}`}>
                  <span class="est-contact-ico">
                    <svg width="15" height="15" fill="none" stroke="#71717a" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  </span>
                  <span style="min-width:0;">
                    <span class="est-contact-k">Administrativo</span>
                    <span class="est-contact-v">{data.adminPhone}</span>
                  </span>
                </a>
              )}
              {data.email && (
                <a href={`mailto:${data.email}`}>
                  <span class="est-contact-ico">
                    <svg width="15" height="15" fill="none" stroke="#71717a" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  </span>
                  <span style="min-width:0;">
                    <span class="est-contact-k">Correo</span>
                    <span class="est-contact-v" style="font-size:0.78rem;">{data.email}</span>
                  </span>
                </a>
              )}
              {data.website && (
                <a href={data.website} target="_blank" rel="noopener noreferrer">
                  <span class="est-contact-ico">
                    <svg width="15" height="15" fill="none" stroke="#71717a" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zM3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18a15 15 0 010-18z"/></svg>
                  </span>
                  <span style="min-width:0;">
                    <span class="est-contact-k">Sitio oficial</span>
                    <span class="est-contact-v" style="font-size:0.78rem;">Abrir ↗</span>
                  </span>
                </a>
              )}
            </div>
          </div>

          <div class="dir-panel">
            <div class="dir-panel-title"><span>Ubicación</span><i></i></div>
            <div class="dir-dl">
              <div class="dir-dl-row" style="align-items:flex-start;">
                <span class="dir-dl-k">Domicilio</span>
                <span class="dir-dl-v" style="white-space:normal; text-align:right; max-width:62%;">{data.address || 'No publicado'}</span>
              </div>
              {data.neighborhood && (
                <div class="dir-dl-row" style="align-items:flex-start;">
                  <span class="dir-dl-k">Colonia</span>
                  <span class="dir-dl-v" style="white-space:normal; text-align:right; max-width:62%;">{data.neighborhood}</span>
                </div>
              )}
              <div class="dir-dl-row" style="align-items:flex-start;">
                <span class="dir-dl-k">{data.stateSlug === 'ciudad-de-mexico' ? 'Alcaldía' : 'Municipio'}</span>
                <span class="dir-dl-v" style="white-space:normal; text-align:right; max-width:62%;">{data.municipality}</span>
              </div>
              {data.postalCode && (
                <div class="dir-dl-row"><span class="dir-dl-k">Código postal</span><span class="dir-dl-v">{data.postalCode}</span></div>
              )}
              <div class="dir-dl-row"><span class="dir-dl-k">Estado</span><span class="dir-dl-v">{data.state}</span></div>
              {tieneGps && (
                <div class="dir-dl-row"><span class="dir-dl-k">Coordenadas</span><span class="dir-dl-v" style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:0.72rem;">{(data.latitude as number).toFixed(4)}, {(data.longitude as number).toFixed(4)}</span></div>
              )}
            </div>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="dir-cta-btn" style="margin-top:14px; background:#09090b;">
              <span>Cómo llegar</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

          <div class="dir-panel">
            <div class="dir-panel-title"><span>Ficha</span><i></i></div>
            <div class="dir-dl" style="margin-bottom:14px;">
              {data.stationCode && (
                <div class="dir-dl-row"><span class="dir-dl-k">Clave</span><span class="dir-dl-v">{data.stationCode}</span></div>
              )}
              {data.yearEstablished && (
                <div class="dir-dl-row"><span class="dir-dl-k">Fundación</span><span class="dir-dl-v">{data.yearEstablished}</span></div>
              )}
              <div class="dir-dl-row"><span class="dir-dl-k">Actualizada</span><span class="dir-dl-v">{data.lastUpdated}</span></div>
            </div>
            <div class={`est-verif${data.verified ? '' : ' is-pend'}`}>
              <svg width="15" height="15" fill="none" stroke={data.verified ? '#16a34a' : '#a1a1aa'} stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0; margin-top:1px;" aria-hidden="true">
                {data.verified
                  ? <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  : <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>}
              </svg>
              <div style="min-width:0;">
                <p class="est-verif-t">{data.verified ? 'Información verificada' : 'Verificación parcial'}</p>
                <p class="est-verif-s">
                  {data.verified
                    ? 'Los datos principales se comprobaron contra fuente oficial.'
                    : 'Algunos datos vienen de una sola fuente. El detalle está al pie de la ficha.'}
                </p>
              </div>
            </div>
          </div>

          {nearbyStations.length > 0 && (
            <div class="dir-panel">
              <div class="dir-panel-title"><span>{tieneGps ? 'Estaciones cercanas' : 'Otras del estado'}</span><i></i></div>
              <div class="est-near">
                {nearbyStations.map((s) => (
                  <a href={`/directorio/${s.data.stateSlug}/${s.id.split('/').pop()?.replace('.md', '')}`}>
                    <span style="min-width:0;">
                      <span class="est-near-n">{s.data.name}</span>
                      <span class="est-near-m">{s.data.municipality}, {s.data.state}</span>
                    </span>
                    {s.distance != null && <span class="est-near-km">{s.distance.toFixed(1)} km</span>}
                  </a>
                ))}
              </div>
            </div>
          )}

          {relatedStations.length > 0 && (
            <div class="dir-panel">
              <div class="dir-panel-title"><span>Más en {state?.name || data.state}</span><i></i></div>
              <div class="est-links">
                {relatedStations.map((s) => (
                  <a href={`/directorio/${s.data.stateSlug}/${s.id.split('/').pop()?.replace('.md', '')}`}>
                    <svg width="12" height="12" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    <span>{s.data.name}</span>
                  </a>
                ))}
              </div>
              <a href={`/directorio/${data.stateSlug}`} style="display:block; margin-top:14px; font-size:0.78rem; font-weight:700; color:#dc2626; text-decoration:none;">
                Ver todas las estaciones de {state?.name || data.state} →
              </a>
            </div>
          )}

          <div class="dir-panel-dark">
            <div class="dir-panel-title"><span>Somos proveedores</span><i></i></div>
            <p class="dir-cta-title">Equipo certificado para cuerpos de bomberos y brigadas</p>
            <p class="dir-cta-text">Trajes estructurales, SCBA, herramienta de rescate, extintores y sistemas contra incendio con norma aplicable y documentación para licitación.</p>
            <a href="/contacto" class="dir-cta-btn">
              <span>Solicitar cotización</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/productos" class="dir-cta-alt">
              <span>Ver catálogo</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

          <div class="dir-911">
            <div class="dir-911-t">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <span>Emergencia en curso</span>
            </div>
            <p>El teléfono de esta estación es administrativo y no siempre se contesta de inmediato. Ante un incendio, accidente o rescate, marca 911.</p>
            <a href="tel:911">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Llamar al 911
            </a>
          </div>

          <div class="dir-panel">
            <div class="dir-panel-title"><span>¿Algo está mal?</span><i></i></div>
            <p style="font-size:0.8rem; color:#52525b; line-height:1.75; margin:0 0 14px;">Si un teléfono cambió, la estación se mudó o falta un dato, mándanos el aviso. Revisamos y corregimos sin costo.</p>
            <a href="/agregar-estacion" style="display:flex; align-items:center; justify-content:space-between; gap:10px; border:1px solid #e4e4e7; color:#09090b; font-size:0.8rem; font-weight:700; padding:11px 14px; border-radius:9px; text-decoration:none;">
              <span>Corregir esta ficha</span>
              <svg width="14" height="14" fill="none" stroke="#dc2626" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

        </aside>

      </div>
    </div>
  </section>
</BaseLayout>
